<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>

    <AssemblyName>ChatGPT Wrapper</AssemblyName>
    <RootNamespace>ChatGPTWrapper</RootNamespace>
    <ApplicationTitle>ChatGPT Wrapper</ApplicationTitle>
    <AssemblyTitle>ChatGPT Wrapper</AssemblyTitle>
    <Product>ChatGPT Wrapper</Product>
    <Version>1.0.0</Version>

    <PublishDir>$(MSBuildProjectDirectory)\dist\ChatGPT-Wrapper\</PublishDir>
    <!-- Skip .playwright copy (index.HASH.css breaks WinUI PRI249). Override: -p:PlaywrightPlatform=win-x64 -->
    <PlaywrightPlatform Condition="'$(PlaywrightPlatform)' == ''">none</PlaywrightPlatform>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ChatGPTWrapper.ApiDiagnostics" />
    <InternalsVisibleTo Include="ChatGPT Wrapper WinUI" />
  </ItemGroup>

  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Adventure\Schema\canon-schema.json" />
    <EmbeddedResource Include="Adventure\Schema\narrator-scales.json" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ChatGPTWrapper.Core\ChatGPTWrapper.Core.csproj" />
    <ProjectReference Include="..\ChatGPTWrapper.Diagnostics\ChatGPTWrapper.Diagnostics.csproj" />
    <ProjectReference Include="..\ChatGPTWrapper.Shell\ChatGPTWrapper.Shell.csproj" />
    <ProjectReference Include="..\ChatGPTWrapper.Theme\ChatGPTWrapper.Theme.csproj" />
    <ProjectReference Include="..\ChatGPTWrapper.Adventure\ChatGPTWrapper.Adventure.csproj" />
    <ProjectReference Include="..\ChatGPTWrapper.WebView\ChatGPTWrapper.WebView.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Playwright" Version="1.50.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3912.50" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\ChatGPT_files\**\*"
             Link="wrapper-assets\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Playwright: set PlaywrightPlatform=win-x64 (or win) to copy .playwright for headless source sync. -->
  <Target Name="StripPlaywrightContentItems"
          AfterTargets="CopyPlaywrightFilesToOutput"
          Condition="'$(PlaywrightPlatform)' == 'none'">
    <ItemGroup>
      <Content Remove="@(Content)"
               Condition="$([System.String]::Copy('%(Content.Link)').StartsWith('.playwright')) OR '%(Content.Link)' == 'playwright.ps1'" />
    </ItemGroup>
  </Target>

  <Target Name="PrepareShareablePublish" AfterTargets="Publish">
    <ItemGroup>
      <_ShareStrip Include="$(PublishDir)**\*.pdb" />
      <_ShareStrip Include="$(PublishDir)**\Microsoft.Web.WebView2*.xml" />
    </ItemGroup>
    <Delete Files="@(_ShareStrip)" ContinueOnError="true" />
    <Message Importance="high" Text="Shareable build: $(PublishDir)" />
  </Target>

</Project>
