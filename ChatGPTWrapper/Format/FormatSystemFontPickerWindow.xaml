<Window x:Class="ChatGPTWrapper.Format.FormatSystemFontPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose system font"
        Height="480"
        Width="420"
        MinHeight="360"
        MinWidth="320"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource BgBaseBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/WrapperChrome.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBox x:Name="SearchBox"
                 Grid.Row="0"
                 Margin="0,0,0,10"
                 ToolTip="Filter installed fonts"/>
        <ListBox x:Name="FontList"
                 Grid.Row="1"
                 DisplayMemberPath="Source"
                 SelectionChanged="FontList_SelectionChanged"/>
        <TextBlock x:Name="PreviewText"
                   Grid.Row="2"
                   Margin="0,10,0,0"
                   Padding="10,8"
                   Background="{DynamicResource BgInsetBrush}"
                   Text="The quick brown fox jumps over the lazy dog."
                   TextWrapping="Wrap"/>
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button Content="Cancel"
                    Style="{StaticResource ShellCommandBarSecondarySlot}"
                    Padding="14,6"
                    Margin="0,0,8,0"
                    IsCancel="True"/>
            <Button Content="Select"
                    Style="{StaticResource ShellCommandBarPrimarySlot}"
                    Padding="14,6"
                    IsDefault="True"
                    Click="SelectButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
