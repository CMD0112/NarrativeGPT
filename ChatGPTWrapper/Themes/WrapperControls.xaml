    <sys:Double x:Key="SidePanelGripWidth" xmlns:sys="clr-namespace:System;assembly=mscorlib">10</sys:Double>
    <sys:Double x:Key="SidePanelGripHeight" xmlns:sys="clr-namespace:System;assembly=mscorlib">52</sys:Double>
    <sys:Double x:Key="SidePanelGripDotSize" xmlns:sys="clr-namespace:System;assembly=mscorlib">2</sys:Double>

    <Style x:Key="SidePanelGripDotStyle" TargetType="Ellipse">
        <Setter Property="Width" Value="{StaticResource SidePanelGripDotSize}"/>
        <Setter Property="Height" Value="{StaticResource SidePanelGripDotSize}"/>
        <Setter Property="Fill" Value="{DynamicResource TextMutedBrush}"/>
        <Setter Property="Margin" Value="0,1.5"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="SidePanelGridSplitterStyle" TargetType="GridSplitter">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Cursor" Value="SizeWE"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GridSplitter">
                    <Grid Background="Transparent" SnapsToDevicePixels="True">
                        <Border x:Name="Track"
                                Width="1"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Stretch"
                                Opacity="0.9"
                                Background="{DynamicResource BorderSubtleBrush}"/>
                        <Border x:Name="Grip"
                                Width="{StaticResource SidePanelGripWidth}"
                                Height="{StaticResource SidePanelGripHeight}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="{DynamicResource BgElevatedBrush}"
                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="5"
                                SnapsToDevicePixels="True">
                            <StackPanel VerticalAlignment="Center"
                                        HorizontalAlignment="Center">
                                <Ellipse Style="{StaticResource SidePanelGripDotStyle}"/>
                                <Ellipse Style="{StaticResource SidePanelGripDotStyle}"/>
                                <Ellipse Style="{StaticResource SidePanelGripDotStyle}"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentPrimaryBrush}"/>
                            <Setter TargetName="Track" Property="Width" Value="2"/>
                            <Setter TargetName="Track" Property="Opacity" Value="1"/>
                            <Setter TargetName="Grip" Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}"/>
                            <Setter TargetName="Grip" Property="Background" Value="{DynamicResource BgSurfaceBrush}"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentPrimaryBrush}"/>
                            <Setter TargetName="Track" Property="Width" Value="2"/>
                            <Setter TargetName="Track" Property="Opacity" Value="1"/>
                            <Setter TargetName="Grip" Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}"/>
                            <Setter TargetName="Grip" Property="Background" Value="{DynamicResource AccentSubtleBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SidePanelRowGridSplitterStyle" TargetType="GridSplitter">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Cursor" Value="SizeNS"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GridSplitter">
                    <Grid Background="Transparent" SnapsToDevicePixels="True">
                        <Border x:Name="Track"
                                Height="1"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                Opacity="0.9"
                                Background="{DynamicResource BorderSubtleBrush}"/>
                        <Border x:Name="Grip"
                                Width="{StaticResource SidePanelGripHeight}"
                                Height="{StaticResource SidePanelGripWidth}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="{DynamicResource BgElevatedBrush}"
                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="5"
                                SnapsToDevicePixels="True">
                            <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Center">
                                <Ellipse Style="{StaticResource SidePanelGripDotStyle}"/>
                                <Ellipse Style="{StaticResource SidePanelGripDotStyle}"/>
                                <Ellipse Style="{StaticResource SidePanelGripDotStyle}"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentPrimaryBrush}"/>
                            <Setter TargetName="Track" Property="Height" Value="2"/>
                            <Setter TargetName="Track" Property="Opacity" Value="1"/>
                            <Setter TargetName="Grip" Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}"/>
                            <Setter TargetName="Grip" Property="Background" Value="{DynamicResource BgSurfaceBrush}"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentPrimaryBrush}"/>
                            <Setter TargetName="Track" Property="Height" Value="2"/>
                            <Setter TargetName="Track" Property="Opacity" Value="1"/>
                            <Setter TargetName="Grip" Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}"/>
                            <Setter TargetName="Grip" Property="Background" Value="{DynamicResource AccentSubtleBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SidePanelRailButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="{StaticResource SidePanelGripWidth}"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Background" Value="{DynamicResource BgElevatedBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="5"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="{DynamicResource BgSurfaceBrush}"/>
                            <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="{DynamicResource AccentSubtleBrush}"/>
                            <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SidePanelCollapseRailButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource SidePanelRailButtonStyle}">
        <Setter Property="Height" Value="20"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="SidePanelExpandRailButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource SidePanelRailButtonStyle}">
        <Setter Property="Height" Value="{StaticResource SidePanelGripHeight}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Shell layout primitives (CMD-97) -->
    <Style x:Key="ShellCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource BgSurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusCard}"/>
        <Setter Property="Padding" Value="{DynamicResource SpaceMdPadding}"/>
    </Style>

    <Style x:Key="ShellSectionHeaderStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeTitle}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>

    <Style x:Key="ShellSectionHintStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeHint}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
    </Style>

    <Style x:Key="ShellCommandBarStyle" TargetType="StackPanel">
        <Setter Property="Orientation" Value="Horizontal"/>
        <Setter Property="Margin" Value="0"/>
    </Style>

    <Style x:Key="ShellCommandBarPrimarySlot" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}"/>

    <Style x:Key="ShellCommandBarSecondarySlot" TargetType="Button">
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="Background" Value="{DynamicResource ButtonGhostBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource RadiusControl}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="{DynamicResource ButtonGhostHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="{DynamicResource ButtonGhostPressedBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ShellBadgeStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="6,2"/>
        <Setter Property="Background" Value="{DynamicResource BgElevatedBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="StatusChipButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource BgElevatedBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource WrapperFocusVisualStyle}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource RadiusControl}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="{DynamicResource ButtonGhostHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Border" Property="Opacity" Value="0.85"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ShellIconGlyphStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource ShellIconFont}"/>
        <Setter Property="FontSize" Value="{DynamicResource ShellIconSize}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>

    <Style x:Key="ShellIconButtonStyle" TargetType="Button" BasedOn="{StaticResource ShellCommandBarSecondarySlot}">
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="MinWidth" Value="{DynamicResource ControlMinHeight}"/>
        <Setter Property="MinHeight" Value="{DynamicResource ControlMinHeight}"/>
        <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource RadiusControl}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="{DynamicResource ButtonGhostHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ShellIconLabelButtonStyle" TargetType="Button" BasedOn="{StaticResource ShellCommandBarSecondarySlot}">
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="MinHeight" Value="{DynamicResource ControlMinHeight}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource RadiusControl}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock x:Name="IconGlyph"
                                       Style="{StaticResource ShellIconGlyphStyle}"
                                       Text="{TemplateBinding Tag}"
                                       Margin="0,0,6,0"/>
                            <ContentPresenter x:Name="LabelPresenter" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="{DynamicResource ButtonGhostHoverBrush}"/>
                        </Trigger>
                        <DataTrigger Binding="{DynamicResource DensityPreset}" Value="Compact">
                            <Setter TargetName="LabelPresenter" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="IconGlyph" Property="Margin" Value="0"/>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ActionListRowBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource BgSurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
        <Setter Property="MinHeight" Value="{DynamicResource ControlMinHeight}"/>
    </Style>

    <Style x:Key="EntitySyncBadgeStyle" TargetType="Border">
        <Setter Property="Padding" Value="4,1"/>
        <Setter Property="CornerRadius" Value="3"/>
        <Setter Property="Background" Value="{DynamicResource BgElevatedBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding SyncStatus}" Value="{x:Static services:EntitySyncStatus.UnresolvedDrift}">
                <Setter Property="Background" Value="{DynamicResource WarningSubtleBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding SyncStatus}" Value="{x:Static services:EntitySyncStatus.SourcesStale}">
                <Setter Property="Background" Value="{DynamicResource WarningSubtleBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding SyncStatus}" Value="{x:Static services:EntitySyncStatus.NeedsPublish}">
                <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="EntitySyncBadgeTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="9"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding SyncStatus}" Value="{x:Static services:EntitySyncStatus.UnresolvedDrift}">
                <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding SyncStatus}" Value="{x:Static services:EntitySyncStatus.SourcesStale}">
                <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding SyncStatus}" Value="{x:Static services:EntitySyncStatus.NeedsPublish}">
                <Setter Property="Foreground" Value="{DynamicResource AccentPrimaryBrush}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ShellLibraryListItemStyle" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Row"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource RadiusCard}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter Margin="0"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource RowHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource RowSelectedBrush}"/>
                            <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
