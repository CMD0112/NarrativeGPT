                        <Border Grid.Row="1"
                                Background="{DynamicResource BgSurfaceBrush}"
                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource RadiusCard}"
                                Padding="4"
                                ClipToBounds="True">
