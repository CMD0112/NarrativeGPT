<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- Spacing -->
    <sys:Double x:Key="SpaceXs">4</sys:Double>
    <sys:Double x:Key="SpaceSm">8</sys:Double>
    <sys:Double x:Key="SpaceMd">12</sys:Double>
    <Thickness x:Key="SpaceMdPadding">12</Thickness>
    <sys:Double x:Key="SpaceLg">16</sys:Double>
    <sys:Double x:Key="SpaceXl">24</sys:Double>

    <!-- Radius -->
    <CornerRadius x:Key="RadiusControl">6</CornerRadius>
    <CornerRadius x:Key="RadiusCard">8</CornerRadius>

    <!-- Typography -->
    <FontFamily x:Key="WrapperFontFamily">Segoe UI Variable, Segoe UI</FontFamily>
    <sys:Double x:Key="FontSizeHint">11</sys:Double>
    <sys:Double x:Key="FontSizeBody">13</sys:Double>
    <sys:Double x:Key="FontSizeTitle">15</sys:Double>

    <!-- Semantic palette -->
    <SolidColorBrush x:Key="BgBaseBrush" Color="#161618"/>
    <SolidColorBrush x:Key="BgSurfaceBrush" Color="#1E1E22"/>
    <SolidColorBrush x:Key="BgElevatedBrush" Color="#28282E"/>
    <SolidColorBrush x:Key="BgChromeBrush" Color="#28282E"/>
    <SolidColorBrush x:Key="BgWorkspaceBrush" Color="#1E1E22"/>
    <SolidColorBrush x:Key="BgInsetBrush" Color="#161618"/>
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="#32323A"/>
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#45454F"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#EDEDF0"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#9898A4"/>
    <SolidColorBrush x:Key="AccentPrimaryBrush" Color="#5B9FD4"/>
    <SolidColorBrush x:Key="AccentPrimaryHoverBrush" Color="#6BADDE"/>
    <SolidColorBrush x:Key="AccentPrimaryPressedBrush" Color="#4A8FC4"/>
    <SolidColorBrush x:Key="AccentSubtleBrush" Color="#335B9FD4"/>
    <SolidColorBrush x:Key="AccentLinkBrush" Color="#5B9FD4"/>
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#6BCB8E"/>
    <SolidColorBrush x:Key="SuccessSubtleBrush" Color="#336BCB8E"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#E5B567"/>
    <SolidColorBrush x:Key="WarningSubtleBrush" Color="#33E5B567"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="#E57373"/>
    <SolidColorBrush x:Key="ErrorSubtleBrush" Color="#33E57373"/>
    <SolidColorBrush x:Key="RowHoverBrush" Color="#32323A"/>
    <SolidColorBrush x:Key="RowSelectedBrush" Color="#3A3A44"/>
    <SolidColorBrush x:Key="RowAlternateBrush" Color="#222228"/>
    <SolidColorBrush x:Key="HeaderBrush" Color="#28282E"/>
    <SolidColorBrush x:Key="PopupBrush" Color="#1E1E22"/>
    <SolidColorBrush x:Key="ButtonGhostBrush" Color="#28282E"/>
    <SolidColorBrush x:Key="ButtonGhostHoverBrush" Color="#32323A"/>
    <SolidColorBrush x:Key="ButtonGhostPressedBrush" Color="#1E1E22"/>

    <!-- Win11 system color overrides (Color keys expect Color; Brush keys expect SolidColorBrush) -->
    <Color x:Key="{x:Static SystemColors.WindowColorKey}">#161618</Color>
    <Color x:Key="{x:Static SystemColors.WindowTextColorKey}">#EDEDF0</Color>
    <Color x:Key="{x:Static SystemColors.ControlColorKey}">#1E1E22</Color>
    <Color x:Key="{x:Static SystemColors.ControlTextColorKey}">#EDEDF0</Color>
    <Color x:Key="{x:Static SystemColors.MenuColorKey}">#1E1E22</Color>
    <Color x:Key="{x:Static SystemColors.MenuTextColorKey}">#EDEDF0</Color>
    <Color x:Key="{x:Static SystemColors.HighlightColorKey}">#3A3A44</Color>
    <Color x:Key="{x:Static SystemColors.HighlightTextColorKey}">#EDEDF0</Color>
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#161618"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#1E1E22"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}" Color="#1E1E22"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#3A3A44"/>
    <SolidColorBrush x:Key="ContextMenuBackground" Color="#1E1E22"/>
    <SolidColorBrush x:Key="ContextMenuForeground" Color="#EDEDF0"/>
    <SolidColorBrush x:Key="MenuPopupBrush" Color="#1E1E22"/>

</ResourceDictionary>
