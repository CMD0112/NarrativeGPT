<shell:ShellDialogWindow xmlns:shell="clr-namespace:ChatGPTWrapper.Shell" x:Class="ChatGPTWrapper.Views.BrowserTabPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pick browser tab"
        Height="420"
        Width="560"
        MinHeight="280"
        MinWidth="420"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBaseBrush}"
        Foreground="{StaticResource TextPrimaryBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   TextWrapping="Wrap"
                   Margin="0,0,0,12"
                   Foreground="{StaticResource TextMutedBrush}"
                   Text="Choose which open ChatGPT browser tab to pin to the selected thread row."/>

        <ListBox x:Name="TabsList"
                 Grid.Row="1"
                 MinHeight="180"
                 DisplayMemberPath="DisplayText"
                 MouseDoubleClick="TabsList_MouseDoubleClick"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Padding="14,6" MinHeight="32" Margin="0,0,8,0" IsCancel="True" Click="Cancel_Click"/>
            <Button Content="Pin selected tab"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Padding="14,6"
                    MinHeight="32"
                    IsDefault="True"
                    Click="Confirm_Click"/>
        </StackPanel>
    </Grid>
</shell:ShellDialogWindow>
