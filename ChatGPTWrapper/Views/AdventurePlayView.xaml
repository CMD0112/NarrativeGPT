<UserControl x:Class="ChatGPTWrapper.Views.AdventurePlayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ChatGPTWrapper.Views"
             xmlns:controls="clr-namespace:ChatGPTWrapper.Controls"
             Background="{DynamicResource BgBaseBrush}">
    <Grid x:Name="RootGrid" Margin="{DynamicResource SpaceMdPadding}">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="SessionCockpitRow" Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Legacy wiring only -->
        <Button x:Name="LinkProjectButton" Visibility="Collapsed" Click="LinkProject_Click"/>
        <Button x:Name="RenameButton" Visibility="Collapsed" Click="Rename_Click"/>

        <Border x:Name="SessionCockpit"
                Grid.Row="0"
                Style="{StaticResource ShellCardStyle}"
                Margin="0,0,0,8">
            <StackPanel>
                <Border x:Name="CanonSyncNoticeBanner"
                        Background="{StaticResource SuccessSubtleBrush}"
                        BorderBrush="{StaticResource SuccessBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource RadiusControl}"
                        Padding="8,6"
                        Margin="0,0,0,8"
                        Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="CanonSyncNoticeText"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                            <Button Content="View diff" Style="{StaticResource ShellCommandBarSecondarySlot}" Margin="0,0,6,0" Click="ViewLastCanonSyncDiff_Click"/>
                            <Button Content="Source Manager" Style="{StaticResource ShellCommandBarSecondarySlot}" Margin="0,0,6,0" Click="OpenSourceManagerFromBanner_Click"/>
                            <Button Content="×" Style="{StaticResource ShellCommandBarSecondarySlot}" Click="DismissCanonSyncNotice_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <local:EntityCanonCommitBar x:Name="CanonCommitBar" PlansChanged="CanonCommitBar_PlansChanged" Margin="0,0,0,8"/>

                <controls:SegmentedControl x:Name="CockpitSectionSegment"
                                            Margin="0,0,0,8"
                                            SelectionChanged="CockpitSectionSegment_SelectionChanged"/>

                <StackPanel x:Name="SessionSectionPanel">
                    <Border x:Name="LinkProjectBanner"
                            Background="{DynamicResource AccentSubtleBrush}"
                            BorderBrush="{DynamicResource AccentPrimaryBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusControl}"
                            Padding="8"
                            Margin="0,0,0,8"
                            Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock TextWrapping="Wrap" VerticalAlignment="Center"
                                       Style="{StaticResource ShellSectionHintStyle}"
                                       Text="Link a ChatGPT Project to enable AI jobs and source publishing."/>
                            <Button Grid.Column="1" Content="Link project" Style="{StaticResource ShellCommandBarPrimarySlot}" Margin="8,0,0,0" Click="LinkProject_Click"/>
                        </Grid>
                    </Border>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="PlayTabStatusBlock"
                                   Style="{StaticResource ShellSectionHintStyle}"
                                   TextWrapping="Wrap"/>
                        <Button Grid.Column="1" Content="Session settings" Style="{StaticResource ShellCommandBarSecondarySlot}" Margin="8,0,0,0"
                                Click="OpenSessionSettings_Click"/>
                    </Grid>
                    <TextBlock x:Name="SessionLoadingBlock"
                               Foreground="{DynamicResource AccentLinkBrush}"
                               Style="{StaticResource ShellSectionHintStyle}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,4"
                               Visibility="Collapsed"/>
                    <TextBlock x:Name="ThreadStatusBlock"
                               Style="{StaticResource ShellSectionHintStyle}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,2"
                               Cursor="Hand"
                               ToolTip="Manage play threads"
                               MouseLeftButtonUp="ThreadStatus_Click"/>
                    <TextBlock x:Name="SourcesStatusBlock"
                               Style="{StaticResource ShellSectionHintStyle}"
                               TextWrapping="Wrap"
                               Cursor="Hand"
                               ToolTip="Open Source Manager"
                               MouseLeftButtonUp="SourcesStatus_Click"/>
                </StackPanel>

                <StackPanel x:Name="NarratorSectionPanel" Visibility="Collapsed">
                    <StackPanel x:Name="NarratorMinimalPanel">
                        <TextBlock Text="Scene profile" Style="{StaticResource ShellSectionHintStyle}" Margin="0,0,0,4"/>
                        <ComboBox x:Name="NarratorSceneProfileCombo" Margin="0,0,0,8"
                                  SelectionChanged="NarratorSceneProfile_Changed"/>
                        <TextBlock x:Name="NarratorOverrideChips" TextWrapping="Wrap" Style="{StaticResource ShellSectionHintStyle}" Margin="0,0,0,8"/>
                        <TextBlock Text="Apply changes to" Style="{StaticResource ShellSectionHintStyle}" Margin="0,0,0,4"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <RadioButton x:Name="NarratorScopeTurnRadio" Content="This send" Margin="0,0,12,0"
                                         GroupName="NarratorScope" IsChecked="True" Checked="NarratorScope_Changed"/>
                            <RadioButton x:Name="NarratorScopeSessionRadio" Content="Session" Margin="0,0,12,0"
                                         GroupName="NarratorScope" Checked="NarratorScope_Changed"/>
                            <RadioButton x:Name="NarratorScopeAdventureRadio" Content="Adventure default"
                                         GroupName="NarratorScope" Checked="NarratorScope_Changed"/>
                        </StackPanel>
                        <Button x:Name="NarratorSettingsButton" Content="Full narrator settings"
                                Style="{StaticResource ShellCommandBarSecondarySlot}"
                                HorizontalAlignment="Left"
                                Click="NarratorSettings_Click"
                                ToolTip="Open narrator behavior in Play settings → Injection"/>
                    </StackPanel>
                    <StackPanel x:Name="NarratorFullPanel">
                        <TextBlock Text="Narration (delivery)" Style="{StaticResource ShellSectionHeaderStyle}" FontSize="{DynamicResource FontSizeSection}" Margin="0,8,0,4"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="88"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Length" VerticalAlignment="Center" Style="{StaticResource ShellSectionHintStyle}" Margin="0,0,8,6"/>
                            <ComboBox x:Name="ResponseLengthCombo" Grid.Row="0" Grid.Column="1" Margin="0,0,0,6" SelectionChanged="NarratorParameter_Changed"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Detail" VerticalAlignment="Center" Style="{StaticResource ShellSectionHintStyle}" Margin="0,0,8,6"/>
                            <ComboBox x:Name="DetailLevelCombo" Grid.Row="1" Grid.Column="1" Margin="0,0,0,6" SelectionChanged="NarratorParameter_Changed"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Tone" VerticalAlignment="Center" Style="{StaticResource ShellSectionHintStyle}" Margin="0,0,8,6"/>
                            <ComboBox x:Name="ToneQuickCombo" Grid.Row="2" Grid.Column="1" Margin="0,0,0,6"
                                      IsEditable="True" SelectionChanged="NarratorParameter_Changed" LostFocus="NarratorParameter_Changed"/>
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Pacing" VerticalAlignment="Center" Style="{StaticResource ShellSectionHintStyle}" Margin="0,0,8,6"/>
                            <ComboBox x:Name="NarrativePacingCombo" Grid.Row="3" Grid.Column="1" Margin="0,0,0,6" SelectionChanged="NarratorParameter_Changed"/>
                        </Grid>
                        <TextBlock Text="Combat &amp; stakes" Style="{StaticResource ShellSectionHeaderStyle}" FontSize="{DynamicResource FontSizeSection}" Margin="0,0,0,4"/>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="88"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Combat diff." VerticalAlignment="Center" Style="{StaticResource ShellSectionHintStyle}" Margin="0,0,8,6"/>
                            <ComboBox x:Name="DifficultyQuickCombo" Grid.Row="0" Grid.Column="1" Margin="0,0,0,6"
                                      IsEditable="True" SelectionChanged="NarratorParameter_Changed" LostFocus="NarratorParameter_Changed"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Violence" VerticalAlignment="Center" Style="{StaticResource ShellSectionHintStyle}" Margin="0,0,8,6"/>
                            <ComboBox x:Name="ViolenceCombo" Grid.Row="1" Grid.Column="1" Margin="0,0,0,6" SelectionChanged="NarratorParameter_Changed"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Consequences" VerticalAlignment="Center" Style="{StaticResource ShellSectionHintStyle}" Margin="0,0,8,6"/>
                            <ComboBox x:Name="ConsequenceWeightCombo" Grid.Row="2" Grid.Column="1" Margin="0,0,0,6" SelectionChanged="NarratorParameter_Changed"/>
                        </Grid>
                        <Button Content="Reset scope" Style="{StaticResource ShellCommandBarSecondarySlot}" HorizontalAlignment="Left" Click="ResetNarratorScope_Click"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel x:Name="AiToolsSectionPanel" Visibility="Collapsed">
                    <ItemsControl x:Name="AiToolsActionList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <controls:ActionListRow Title="{Binding Title}"
                                                        Hint="{Binding Hint}"
                                                        RunCommand="{Binding RunCommand}"
                                                        RowEnabled="{Binding IsEnabled}"
                                                        DisabledReason="{Binding DisabledReason}"
                                                        Margin="0,0,0,4"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </Border>

        <TabControl x:Name="PlaySideTabControl"
                    Grid.Row="1"
                    Style="{StaticResource ShellCompanionTabControlStyle}">
            <TabItem x:Name="ReferenceSideTab" Tag="Reference" Header="Reference">
                <DockPanel x:Name="ReferenceTabRoot" Margin="4">
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Border x:Name="ReviewQueueBanner"
                                Style="{StaticResource ShellCardStyle}"
                                Padding="8"
                                Margin="0,0,0,8"
                                Visibility="Collapsed">
                            <StackPanel>
                                <ListBox x:Name="ReviewQueueList"
                                         MaxHeight="120"
                                         ItemContainerStyle="{StaticResource ShellLibraryListItemStyle}"
                                         DisplayMemberPath="DisplayLabel"
                                         Margin="0,0,0,6"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Accept" Style="{StaticResource ShellCommandBarSecondarySlot}" Margin="0,0,6,0" Click="AcceptReviewItem_Click"/>
                                    <Button Content="Dismiss" Style="{StaticResource ShellCommandBarSecondarySlot}" Margin="0,0,6,0" Click="DismissReviewItem_Click"/>
                                    <Button Content="Edit" Style="{StaticResource ShellCommandBarSecondarySlot}" Click="EditReviewItem_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <local:EntityReferencePanel x:Name="EntityReferencePanel"/>
                </DockPanel>
            </TabItem>
            <TabItem x:Name="WarningsSideTab" Tag="Warnings" Header="Warnings">
                <DockPanel Margin="4">
                    <Border DockPanel.Dock="Top" Style="{StaticResource ShellCardStyle}" Padding="8" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock x:Name="WarningsLastCheckedBlock" Style="{StaticResource ShellSectionHintStyle}" Margin="0,0,0,6" Visibility="Collapsed"/>
                            <Button x:Name="RunContinuityButton" Content="Run continuity check"
                                    Style="{StaticResource ShellCommandBarSecondarySlot}" HorizontalAlignment="Left"
                                    Click="RunContinuityCheck_Click" IsEnabled="False"/>
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="WarningsEmptyState"
                               DockPanel.Dock="Top"
                               Text="No continuity warnings yet."
                               Style="{StaticResource ShellSectionHintStyle}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,8"
                               Visibility="Collapsed"/>
                    <ListBox x:Name="WarningsList"
                             ItemContainerStyle="{StaticResource ShellLibraryListItemStyle}"
                             Visibility="Collapsed">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="10,8">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <Border Padding="6,2" CornerRadius="4" Margin="0,0,8,0" Background="{Binding SeverityBrush}">
                                            <TextBlock Text="{Binding SeverityLabel}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        </Border>
                                        <TextBlock Text="{Binding Source}" Style="{StaticResource ShellSectionHintStyle}" VerticalAlignment="Center" Margin="8,0,0,0" Visibility="{Binding SourceVisibility}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Open in Reference" Click="WarningOpenInReference_Click"/>
                                <MenuItem Header="Dismiss" Click="WarningDismiss_Click"/>
                            </ContextMenu>
                        </ListBox.ContextMenu>
                    </ListBox>
                    <DataGrid x:Name="WarningsGrid" Visibility="Collapsed" Height="0"/>
                </DockPanel>
            </TabItem>
            <TabItem x:Name="StateSideTab" Tag="State" Header="State">
                <DockPanel Margin="4">
                    <Button x:Name="EditWorldButton"
                            DockPanel.Dock="Bottom"
                            Content="Edit world in settings"
                            Style="{StaticResource ShellCommandBarSecondarySlot}"
                            HorizontalAlignment="Left"
                            Margin="0,8,0,0"
                            Click="EditWorldInSettings_Click"/>
                    <Border x:Name="StateEmptyStateCard" DockPanel.Dock="Top" Style="{StaticResource ShellCardStyle}" Padding="8" Margin="0,0,0,8" Visibility="Collapsed">
                        <TextBlock Text="World state not configured — set up in Play settings → World." Style="{StaticResource ShellSectionHintStyle}" TextWrapping="Wrap"/>
                    </Border>
                    <TextBlock x:Name="StateLastUpdatedBlock" DockPanel.Dock="Top" Style="{StaticResource ShellSectionHintStyle}" Margin="0,0,0,8" Visibility="Collapsed"/>
                    <UniformGrid x:Name="StatePreviewPanel" DockPanel.Dock="Top" Columns="1" Margin="0,0,0,8">
                        <UniformGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Edit in Play settings → World" Click="EditWorldInSettings_Click"/>
                                <MenuItem x:Name="StateLocationReferenceMenuItem" Header="View in Reference" Click="StateLocationReference_Click"/>
                            </ContextMenu>
                        </UniformGrid.ContextMenu>
                        <Border Style="{StaticResource ShellCardStyle}" Padding="8" Margin="0,0,0,6">
                            <StackPanel>
                                <TextBlock Text="Summary" Style="{StaticResource ShellSectionHeaderStyle}" FontSize="{DynamicResource FontSizeSection}" Margin="0,0,0,4"/>
                                <TextBlock x:Name="StateSummaryPreview" TextWrapping="Wrap" Style="{StaticResource ShellSectionHintStyle}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource ShellCardStyle}" Padding="8" Margin="0,0,0,6">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,4">
                                    <Button x:Name="StateLocationReferenceButton" DockPanel.Dock="Right" Content="Reference" Style="{StaticResource ShellCommandBarSecondarySlot}" Margin="8,0,0,0" Visibility="Collapsed" Click="StateLocationReference_Click"/>
                                    <TextBlock Text="Location" Style="{StaticResource ShellSectionHeaderStyle}" FontSize="{DynamicResource FontSizeSection}" VerticalAlignment="Center"/>
                                </DockPanel>
                                <TextBlock x:Name="StateLocationPreview" TextWrapping="Wrap" Style="{StaticResource ShellSectionHintStyle}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource ShellCardStyle}" Padding="8">
                            <StackPanel>
                                <TextBlock Text="Objectives" Style="{StaticResource ShellSectionHeaderStyle}" FontSize="{DynamicResource FontSizeSection}" Margin="0,0,0,4"/>
                                <TextBlock x:Name="StateObjectivesPreview" TextWrapping="Wrap" Style="{StaticResource ShellSectionHintStyle}"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                    <Expander x:Name="StateAllFieldsExpander" Header="All fields" IsExpanded="False">
                        <DataGrid x:Name="StateGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" CanUserAddRows="False" CanUserDeleteRows="False" MaxHeight="200">
                            <DataGrid.Columns>
                                <DataGridTextColumn x:Name="StateFieldColumn" Header="Field" Binding="{Binding Field}" Width="140"/>
                                <DataGridTextColumn x:Name="StateValueColumn" Header="Value" Binding="{Binding Value}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Expander>
                </DockPanel>
            </TabItem>
        </TabControl>

        <StackPanel x:Name="FooterActionBar" Grid.Row="2" Style="{StaticResource ShellCommandBarStyle}" Margin="0,8,0,0">
            <Button x:Name="FooterSearchButton"
                    Content="Search"
                    Style="{StaticResource ShellCommandBarSecondarySlot}"
                    Margin="0,0,8,0"
                    ToolTip="Search adventure transcript and content"
                    Click="Search_Click"/>
            <Button x:Name="FooterExportButton"
                    Content="Export"
                    Style="{StaticResource ShellCommandBarSecondarySlot}"
                    MinWidth="72"
                    Margin="0,0,8,0"
                    ToolTip="Save adventure to a file"
                    Click="Export_Click"/>
            <Button x:Name="MoreActionsButton"
                    Content="More"
                    Style="{StaticResource ShellCommandBarSecondarySlot}"
                    Click="MoreActionsButton_Click">
                <Button.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Play" Style="{StaticResource ShellMenuSectionHeaderStyle}"/>
                        <MenuItem Header="Recap" Click="GenerateRecap_Click" ToolTip="Story digest and recent play (no AI)"/>
                        <MenuItem Header="Branch" Click="Branch_Click"/>
                        <MenuItem Header="Sync thread log" Click="SyncFromThread_Click"/>
                        <MenuItem Header="Dump thread log" Click="DumpThreadLog_Click"/>
                        <Separator/>
                        <MenuItem Header="Advanced" Style="{StaticResource ShellMenuSectionHeaderStyle}"/>
                        <MenuItem Header="Local inference lab" Click="LocalInferenceLab_Click"/>
                        <MenuItem Header="Canon inbox" Click="CanonInbox_Click"/>
                        <MenuItem Header="Roll" Click="Roll_Click"/>
                        <Separator/>
                        <MenuItem Header="Start narrative from sources" Click="StartNarrativeFromSources_Click"/>
                        <MenuItem Header="Hand off to new chat" Click="PlayHandoff_Click"/>
                        <MenuItem Header="Continue design" Click="ContinueDesign_Click"/>
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
