<shell:ShellDialogWindow xmlns:shell="clr-namespace:ChatGPTWrapper.Shell" x:Class="ChatGPTWrapper.Views.AdventureThreadManagerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Manage adventure threads"
        Height="640"
        Width="760"
        MinHeight="400"
        MinWidth="480"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBaseBrush}"
        Foreground="{StaticResource TextPrimaryBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock TextWrapping="Wrap"
                       Margin="0,0,0,12"
                       Foreground="{StaticResource TextMutedBrush}"
                       Text="One active pin per thread kind. Switch active to change which conversation jobs and navigation use. Archive retires a slot without deleting local log data."/>
            <Border Style="{StaticResource ShellCardStyle}" Padding="12" Margin="0,0,0,10">
                <DockPanel LastChildFill="True">
                    <Button x:Name="ChangeProjectButton"
                            DockPanel.Dock="Right"
                            Content="Change project…"
                            Padding="10,5"
                            Margin="12,0,0,0"
                            Click="ChangeProject_Click"/>
                    <StackPanel>
                        <TextBlock Text="Linked project" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBlock x:Name="ProjectSummaryBlock" TextWrapping="Wrap"
                                   Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                    </StackPanel>
                </DockPanel>
            </Border>
            <CheckBox x:Name="HideInlineUtilityCheck"
                      Content="Hide inline utility traffic during play"
                      Margin="0,0,0,4"
                      Checked="DeliverySetting_Changed" Unchecked="DeliverySetting_Changed"/>
            <CheckBox x:Name="ShowInlineUtilityTrafficCheck"
                      Content="Show inline utility traffic in transcript"
                      Checked="DeliverySetting_Changed" Unchecked="DeliverySetting_Changed"/>
        </StackPanel>

        <TabControl x:Name="KindTabs" Grid.Row="1" SelectionChanged="KindTabs_SelectionChanged">
            <TabItem Header="Play threads" Tag="Play"/>
            <TabItem Header="Design threads" Tag="Design"/>
            <TabItem Header="Utility worker" Tag="UtilityWorker"/>
        </TabControl>

        <TextBlock x:Name="ActiveSummaryBlock"
                   Grid.Row="2"
                   Margin="0,12,0,0"
                   TextWrapping="Wrap"
                   FontSize="{StaticResource FontSizeHint}"
                   Foreground="{StaticResource TextMutedBrush}"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Close" Padding="14,6" MinHeight="32" IsCancel="True" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</shell:ShellDialogWindow>
