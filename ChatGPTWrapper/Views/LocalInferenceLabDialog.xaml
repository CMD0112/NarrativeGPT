<shell:ShellDialogWindow xmlns:shell="clr-namespace:ChatGPTWrapper.Shell" x:Class="ChatGPTWrapper.Views.LocalInferenceLabDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Local inference lab"
        Height="720"
        Width="880"
        MinHeight="560"
        MinWidth="640"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBaseBrush}"
        Foreground="{StaticResource TextPrimaryBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   TextWrapping="Wrap"
                   Margin="0,0,0,12"
                   Foreground="{StaticResource TextMutedBrush}"
                   Text="Standalone Ollama tester. Diag: scenarios attach verbatim adventure JSON from disk (entities.json, memory.json, utility-results/, etc.) for local audit."/>

        <Border Grid.Row="1"
                Style="{StaticResource ShellCardStyle}"
                Padding="12"
                Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Base URL" VerticalAlignment="Center" Margin="0,0,8,8"/>
                <TextBox x:Name="BaseUrlBox" Grid.Row="0" Grid.Column="1" Margin="0,0,12,8" Padding="6,4"/>

                <TextBlock Grid.Row="0" Grid.Column="2" Text="Model" VerticalAlignment="Center" Margin="0,0,8,8"/>
                <TextBox x:Name="ModelBox" Grid.Row="0" Grid.Column="3" Margin="0,0,12,8" Padding="6,4"/>

                <Button x:Name="ProbeButton"
                        Grid.Row="0"
                        Grid.Column="4"
                        Content="Probe"
                        Padding="12,6"
                        Margin="0,0,0,8"
                        Click="ProbeButton_Click"/>

                <TextBlock x:Name="ProbeStatusBlock"
                           Grid.Row="1"
                           Grid.Column="0"
                           Grid.ColumnSpan="5"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource TextMutedBrush}"
                           FontSize="11"/>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,0,0,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Scenario" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="ScenarioCombo"
                          Grid.Column="1"
                          Padding="6,4"
                          MinWidth="260"
                          SelectionChanged="ScenarioCombo_SelectionChanged"/>
            </Grid>
            <Border x:Name="AdventureContextPanel"
                    Grid.Row="1"
                    Style="{StaticResource ShellCardStyle}"
                    Padding="12"
                    Visibility="Collapsed">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="Adventure folder" Margin="0,0,0,4" Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                            <ComboBox x:Name="AdventureCombo"
                                      Padding="6,4"
                                      DisplayMemberPath="DisplayLabel"
                                      SelectionChanged="AdventureContextCombo_SelectionChanged"/>
                        </StackPanel>
                        <Button x:Name="LoadFromAdventureButton"
                                Grid.Column="1"
                                Content="Attach files"
                                Padding="12,6"
                                VerticalAlignment="Bottom"
                                Click="LoadFromAdventureButton_Click"/>
                    </Grid>
                    <TextBlock Text="Include files (verbatim from disk)" Margin="0,0,0,4" Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                    <WrapPanel x:Name="FileAttachPanel" Margin="0,0,0,8"/>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="Turn slice (log.json#turn/N)" Margin="0,0,0,4" Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                            <ComboBox x:Name="TurnCombo"
                                      Padding="6,4"
                                      DisplayMemberPath="DisplayLabel"
                                      SelectionChanged="AdventureContextCombo_SelectionChanged"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Worker capture (utility-results/*.json)" Margin="0,0,0,4" Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                            <ComboBox x:Name="UtilityRunCombo"
                                      Padding="6,4"
                                      DisplayMemberPath="DisplayLabel"
                                      SelectionChanged="UtilityRunCombo_SelectionChanged"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="AdventureLoadStatusBlock"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource TextMutedBrush}"
                               FontSize="11"/>
                </StackPanel>
            </Border>
        </Grid>

        <StackPanel Grid.Row="3" Margin="0,0,0,8">
            <TextBlock Text="System prompt" Margin="0,0,0,4"/>
            <TextBox x:Name="SystemPromptBox"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     MinHeight="72"
                     MaxHeight="140"
                     Padding="8,6"
                     Margin="0,0,0,8"/>
            <TextBlock Text="User message" Margin="0,0,0,4"/>
            <TextBox x:Name="UserMessageBox"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     MinHeight="72"
                     MaxHeight="220"
                     Padding="8,6"/>
        </StackPanel>

        <Grid Grid.Row="4" Margin="0,0,0,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Response" Margin="0,0,0,4"/>
            <TextBox x:Name="ResponseBox"
                     Grid.Row="1"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     FontFamily="Consolas"
                     Padding="8,6"
                     Background="{StaticResource BgInsetBrush}"/>
        </Grid>

        <TextBlock x:Name="RunStatusBlock"
                   Grid.Row="5"
                   TextWrapping="Wrap"
                   Foreground="{StaticResource TextMutedBrush}"
                   FontSize="11"
                   Margin="0,0,0,8"/>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CancelRunButton"
                    Content="Cancel"
                    Padding="14,6"
                    MinHeight="32"
                    Margin="0,0,8,0"
                    Visibility="Collapsed"
                    Click="CancelRunButton_Click"/>
            <Button x:Name="RunButton"
                    Content="Run"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Padding="14,6"
                    MinHeight="32"
                    Margin="0,0,8,0"
                    Click="RunButton_Click"/>
            <Button Content="Close"
                    Padding="14,6"
                    MinHeight="32"
                    IsCancel="True"/>
        </StackPanel>
    </Grid>
</shell:ShellDialogWindow>
