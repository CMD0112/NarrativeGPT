<shell:ShellDialogWindow xmlns:shell="clr-namespace:ChatGPTWrapper.Shell" x:Class="ChatGPTWrapper.Views.AdventureRenameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rename adventure"
        SizeToContent="Height"
        Width="440"
        MinHeight="180"
        MinWidth="360"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBaseBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Title" Margin="0,0,0,4"/>
        <TextBox x:Name="TitleBox" Grid.Row="1" Margin="0,0,0,16"/>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Cancel" Margin="0,0,8,0" Padding="14,6" MinHeight="32" IsCancel="True"/>
            <Button Content="Rename" Style="{StaticResource PrimaryButtonStyle}" MinWidth="88" MinHeight="32" IsDefault="True" Click="Rename_Click"/>
        </StackPanel>
    </Grid>
</shell:ShellDialogWindow>
