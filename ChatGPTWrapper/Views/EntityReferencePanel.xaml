<UserControl x:Class="ChatGPTWrapper.Views.EntityReferencePanel"

             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

             xmlns:local="clr-namespace:ChatGPTWrapper.Views">

    <UserControl.Resources>

        <DataTemplate x:Key="EntityRowTemplateCompact">

            <DockPanel Margin="8,6">

                <Border DockPanel.Dock="Left"

                        Width="32"

                        Height="32"

                        Margin="0,0,8,0"

                        CornerRadius="4"

                        BorderBrush="{DynamicResource BorderSubtleBrush}"

                        BorderThickness="1"

                        Background="{DynamicResource BgElevatedBrush}"

                        ClipToBounds="True"

                        Visibility="{Binding PortraitVisibility}">

                    <Image Source="{Binding Portrait}" Stretch="UniformToFill"/>

                </Border>

                <StackPanel>

                    <DockPanel LastChildFill="True">
                        <Border DockPanel.Dock="Right"
                                Padding="4,1"
                                Margin="4,0,0,0"
                                CornerRadius="3"
                                Background="{DynamicResource BgElevatedBrush}"
                                Visibility="{Binding SyncBadgeVisibility}">
                            <TextBlock Text="{Binding SyncBadgeText}"
                                       FontSize="9"
                                       FontWeight="SemiBold"
                                       Foreground="{Binding SyncBadgeBrush}"/>
                        </Border>
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>

                    <TextBlock Text="{Binding TagsLine}"

                               Foreground="{DynamicResource TextMutedBrush}"

                               FontSize="10"

                               TextTrimming="CharacterEllipsis"

                               Visibility="{Binding TagsVisibility}"/>

                </StackPanel>

            </DockPanel>

        </DataTemplate>

        <DataTemplate x:Key="EntityRowTemplateAdaptive">

            <DockPanel Margin="{Binding RowMargin}">

                <Border DockPanel.Dock="Left"

                        Width="44"

                        Height="44"

                        Margin="0,0,10,0"

                        CornerRadius="6"

                        BorderBrush="{DynamicResource BorderSubtleBrush}"

                        BorderThickness="1"

                        Background="{DynamicResource BgElevatedBrush}"

                        ClipToBounds="True"

                        Visibility="{Binding PortraitVisibility}">

                    <Image Source="{Binding Portrait}" Stretch="UniformToFill"/>

                </Border>

                <StackPanel>

                    <DockPanel LastChildFill="True">

                        <Border DockPanel.Dock="Right"
                                Padding="4,1"
                                Margin="6,0,0,0"
                                CornerRadius="3"
                                Background="{DynamicResource BgElevatedBrush}"
                                VerticalAlignment="Top"
                                Visibility="{Binding SyncBadgeVisibility}">
                            <TextBlock Text="{Binding SyncBadgeText}"
                                       FontSize="9"
                                       FontWeight="SemiBold"
                                       Foreground="{Binding SyncBadgeBrush}"/>
                        </Border>

                        <Border DockPanel.Dock="Right"

                                Style="{StaticResource ShellBadgeStyle}"

                                Margin="6,0,0,0"

                                VerticalAlignment="Top"

                                Visibility="{Binding TypeBadgeVisibility}">

                            <TextBlock Text="{Binding TypeBadge}" FontSize="10" FontWeight="SemiBold"/>

                        </Border>

                        <TextBlock DockPanel.Dock="Right"

                                   Text="{Binding PinGlyph}"

                                   Margin="6,0,0,0"

                                   FontSize="11"

                                   VerticalAlignment="Top"

                                   Visibility="{Binding PinVisibility}"/>

                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>

                    </DockPanel>

                    <TextBlock Text="{Binding RoleOrStatus}"

                               Foreground="{DynamicResource TextMutedBrush}"

                               FontSize="{StaticResource FontSizeHint}"

                               Margin="0,2,0,0"

                               TextTrimming="CharacterEllipsis"

                               Visibility="{Binding RoleVisibility}"/>

                    <TextBlock Text="{Binding TagsLine}"

                               Foreground="{DynamicResource TextMutedBrush}"

                               FontSize="10"

                               Margin="0,2,0,0"

                               TextTrimming="CharacterEllipsis"

                               Visibility="{Binding TagsVisibility}"/>

                    <TextBlock Text="{Binding DescriptionSnippet}"

                               Foreground="{DynamicResource TextMutedBrush}"

                               FontSize="11"

                               Margin="0,4,0,0"

                               TextWrapping="Wrap"

                               MaxHeight="{Binding DescriptionMaxHeight}"

                               TextTrimming="CharacterEllipsis"

                               Visibility="{Binding DescriptionVisibility}"/>

                </StackPanel>

            </DockPanel>

        </DataTemplate>

    </UserControl.Resources>

    <Grid x:Name="RootGrid">

        <Grid.ColumnDefinitions>

            <ColumnDefinition Width="*" MinWidth="160"/>

            <ColumnDefinition x:Name="SideEditColumn" Width="0"/>

        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="*"/>

            <RowDefinition Height="Auto"/>

        </Grid.RowDefinitions>



        <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,8">

            <WrapPanel x:Name="EntityFilterPanel" Margin="0,0,0,8"/>

            <WrapPanel x:Name="EntityActionsRow" Margin="0,0,0,8">

                <Button Content="Add" Padding="8,4" Margin="0,0,6,4" Click="AddEntity_Click"/>

                <Button Content="Edit" Padding="8,4" Margin="0,0,6,4" Click="EditEntity_Click"/>

                <Button Content="Delete" Padding="8,4" Margin="0,0,6,4" Click="DeleteEntity_Click"/>

                <Menu x:Name="EntityMoreMenu" Background="Transparent" VerticalAlignment="Center" Margin="0,0,0,4">

                    <MenuItem x:Name="EntityMoreMenuItem" Header="More entity actions…" Padding="8,4">

                        <MenuItem x:Name="PinEntityMenuItem" Header="Pin / Unpin" Click="TogglePinEntity_Click"/>

                        <MenuItem x:Name="RenameEntityMenuItem" Header="Rename…" Click="RenameEntity_Click"/>

                        <MenuItem x:Name="MergeEntityMenuItem" Header="Merge into…" Click="MergeEntity_Click"/>

                        <MenuItem x:Name="RetireEntityMenuItem" Header="Retire…" Click="RetireEntity_Click"/>

                        <MenuItem x:Name="SuggestEntitiesMenuItem" Header="Suggest entities (AI)"

                                  Click="SuggestEntities_Click"

                                  ToolTip="Requires a linked Project and a recent play exchange"/>

                        <MenuItem x:Name="ExpandEntityMenuItem" Header="Expand selected (AI)"

                                  Click="ExpandEntity_Click"

                                  ToolTip="Enrich the selected entity with AI"/>

                    </MenuItem>

                </Menu>

            </WrapPanel>

        </StackPanel>



        <Border x:Name="EntityListHost"

                Grid.Row="1"

                Grid.Column="0"

                Style="{StaticResource ShellCardStyle}"

                Padding="4"

                MinHeight="80"

                     ToolTip="Double-click or right-click an entry for actions">

            <ListBox x:Name="EntityList"

                     Background="Transparent"

                     BorderThickness="0"

                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"

                     ItemContainerStyle="{StaticResource ShellLibraryListItemStyle}"

                     ItemTemplate="{StaticResource EntityRowTemplateAdaptive}"

                     SelectionChanged="EntityList_SelectionChanged"

                     PreviewMouseRightButtonDown="EntityList_PreviewMouseRightButtonDown"

                     MouseDoubleClick="EntityList_MouseDoubleClick">

                <ListBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Edit" Click="EditEntity_Click"/>
                        <MenuItem Header="Delete" Click="DeleteEntity_Click"/>
                        <Separator/>
                        <MenuItem x:Name="EntityRowPinMenuItem" Header="Pin / Unpin" Click="TogglePinEntity_Click"/>
                        <MenuItem Header="Rename…" Click="RenameEntity_Click"/>
                        <MenuItem Header="Merge into…" Click="MergeEntity_Click"/>
                        <MenuItem Header="Retire…" Click="RetireEntity_Click"/>
                    </ContextMenu>
                </ListBox.ContextMenu>

            </ListBox>

        </Border>



        <Border x:Name="InlineEditHost"

                Grid.Row="2"

                Grid.Column="0"

                Grid.ColumnSpan="2"

                Style="{StaticResource ShellCardStyle}"

                Padding="10"

                Margin="0,8,0,0"

                Visibility="Collapsed">

            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="420">

                <local:EntityEditFormHost x:Name="InlineEditForm" ShowInlineActions="True"/>

            </ScrollViewer>

        </Border>



        <Border x:Name="SideEditHost"

                Grid.Row="1"

                Grid.Column="1"

                Style="{StaticResource ShellCardStyle}"

                Padding="10"

                Margin="8,0,0,0"

                MinWidth="240"

                Visibility="Collapsed">

            <local:EntityWorkspaceHost x:Name="SideWorkspace"/>

        </Border>

    </Grid>

</UserControl>


