<UserControl x:Class="ChatGPTWrapper.Views.EntityCanonCommitBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="Collapsed">
    <Border Background="{StaticResource WarningSubtleBrush}"
            BorderBrush="{StaticResource WarningBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource RadiusControl}"
            Padding="8,6"
            Margin="0,0,0,6">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="CommitBarSummary"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                <Button x:Name="PreviewButton" Content="Preview all" Padding="8,3" Margin="0,0,6,0" Click="PreviewAll_Click"/>
                <Button x:Name="ApplyButton" Content="Sync canon" Padding="8,3" Margin="0,0,6,0" Click="Apply_Click"/>
                <Button x:Name="DiscardButton" Content="Discard" Padding="8,3" Click="Discard_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
