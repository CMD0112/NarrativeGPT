<UserControl x:Class="ChatGPTWrapper.Views.EntityWorkspaceHost"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ChatGPTWrapper.Views">
    <TabControl x:Name="WorkspaceTabs">
        <TabItem Header="Profile">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <local:EntityEditFormHost x:Name="ProfileForm" ShowInlineActions="True"/>
            </ScrollViewer>
        </TabItem>
        <TabItem Header="Sources">
            <Grid Margin="0,4,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="SourcesStatusBadge"
                           FontSize="10"
                           FontWeight="SemiBold"
                           Margin="0,0,0,6"
                           Visibility="Collapsed"/>
                <TextBox x:Name="SourcesPreviewBox"
                         Grid.Row="1"
                         IsReadOnly="True"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         FontFamily="Consolas"
                         FontSize="11"
                         Background="Transparent"
                         BorderThickness="0"/>
            </Grid>
        </TabItem>
        <TabItem Header="Mentions">
            <Grid Margin="0,4,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="MentionsHintBlock"
                           Foreground="{DynamicResource TextMutedBrush}"
                           FontSize="10"
                           TextWrapping="Wrap"
                           Margin="0,0,0,6"/>
                <ListBox x:Name="MentionsList"
                         Grid.Row="1"
                         BorderThickness="0"
                         Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,4">
                                <TextBlock FontWeight="SemiBold" FontSize="11">
                                    <Run Text="{Binding File}"/>
                                    <Run Text=":" Foreground="{DynamicResource TextMutedBrush}"/>
                                    <Run Text="{Binding MatchedTerm}"/>
                                </TextBlock>
                                <TextBlock Text="{Binding Snippet}"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           FontSize="10"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </TabItem>
        <TabItem Header="History">
            <Grid Margin="0,4,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="HistoryFileLabel"
                           Foreground="{DynamicResource TextMutedBrush}"
                           FontSize="10"
                           Margin="0,0,0,6"/>
                <ListBox x:Name="HistoryList"
                         Grid.Row="1"
                         BorderThickness="0"
                         Background="Transparent">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,4">
                                <TextBlock Text="{Binding ArchivedAt}" FontSize="11"/>
                                <TextBlock Text="{Binding Reason}"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           FontSize="10"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </TabItem>
    </TabControl>
</UserControl>
