<shell:ShellDialogWindow xmlns:shell="clr-namespace:ChatGPTWrapper.Shell" x:Class="ChatGPTWrapper.Views.SyncFromThreadDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sync from play thread?"
        SizeToContent="Height"
        Width="520"
        MinHeight="220"
        MinWidth="420"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBaseBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0"
                   TextWrapping="Wrap"
                   Margin="0,0,0,12"
                   Text="The linked ChatGPT play thread and local log.json do not match. Utility and injected context messages are excluded from the comparison."/>
        <TextBlock x:Name="SummaryLine"
                   Grid.Row="1"
                   FontWeight="SemiBold"
                   Margin="0,0,0,8"/>
        <TextBlock x:Name="DetailLine"
                   Grid.Row="2"
                   TextWrapping="Wrap"
                   Opacity="0.85"
                   Margin="0,0,0,16"/>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Skip" Margin="0,0,8,0" Padding="14,6" MinHeight="32" IsCancel="True" Click="Skip_Click"/>
            <Button Content="Sync log from thread"
                    Style="{StaticResource PrimaryButtonStyle}"
                    MinWidth="160"
                    MinHeight="32"
                    IsDefault="True"
                    Click="Sync_Click"/>
        </StackPanel>
    </Grid>
</shell:ShellDialogWindow>
