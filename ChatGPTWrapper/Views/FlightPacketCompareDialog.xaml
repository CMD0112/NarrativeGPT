<shell:ShellDialogWindow xmlns:shell="clr-namespace:ChatGPTWrapper.Shell" x:Class="ChatGPTWrapper.Views.FlightPacketCompareDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Compare packets"
        Height="620"
        Width="860"
        MinHeight="520"
        MinWidth="640"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBaseBrush}"
        Foreground="{StaticResource TextPrimaryBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="MetaLine" Grid.Row="0" Margin="0,0,0,8"
                   Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"/>
        <TextBox x:Name="DiffBox" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11"/>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Copy diff" Padding="14,6" Margin="0,0,8,0" Click="Copy_Click"/>
            <Button Content="Close" Padding="14,6" IsDefault="True" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</shell:ShellDialogWindow>
