<UserControl x:Class="ChatGPTWrapper.Views.EntityExtendedFieldsEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="Add custom key/value pairs stored in extendedFields."
                   Foreground="{DynamicResource TextMutedBrush}"
                   FontSize="10"
                   TextWrapping="Wrap"
                   Margin="0,0,0,8"/>
        <StackPanel x:Name="RowsPanel"/>
        <Button Content="Add field…"
                Padding="8,4"
                HorizontalAlignment="Left"
                Margin="0,4,0,0"
                Click="AddField_Click"/>
    </StackPanel>
</UserControl>
