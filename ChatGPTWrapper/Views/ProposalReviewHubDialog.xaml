<shell:ShellDialogWindow xmlns:shell="clr-namespace:ChatGPTWrapper.Shell"
        x:Class="ChatGPTWrapper.Views.ProposalReviewHubDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Review proposals"
        Height="640"
        Width="960"
        MinHeight="520"
        MinWidth="720"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBaseBrush}"
        Foreground="{StaticResource TextPrimaryBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   TextWrapping="Wrap"
                   Foreground="{StaticResource TextMutedBrush}"
                   Margin="0,0,0,8"
                   Text="Review AI job results in one place — accept to apply, dismiss to discard. Dual-run jobs tag proposals by source (Local LLM vs ChatGPT) and appear under Dual-run compare for side-by-side raw output."/>

        <TextBlock x:Name="StatusLine"
                   Grid.Row="1"
                   Margin="0,0,0,8"
                   TextWrapping="Wrap"
                   Foreground="{StaticResource TextMutedBrush}"/>

        <Grid Grid.Row="2" MinHeight="320">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160" MinWidth="140"/>
                <ColumnDefinition Width="*" MinWidth="220"/>
                <ColumnDefinition Width="2*" MinWidth="280"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    BorderBrush="{StaticResource BorderStrongBrush}"
                    BorderThickness="1"
                    Background="{StaticResource BgSurfaceBrush}"
                    Padding="4">
                <ListBox x:Name="CategoryList"
                         BorderThickness="0"
                         Background="Transparent"
                         SelectionChanged="CategoryList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <TextBlock Text="{Binding Label}" FontWeight="SemiBold"/>
                                <TextBlock Text=" (" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding Count}" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text=")" Foreground="{StaticResource TextMutedBrush}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <Border Grid.Column="1"
                    Margin="8,0,0,0"
                    BorderBrush="{StaticResource BorderStrongBrush}"
                    BorderThickness="1"
                    Background="{StaticResource BgSurfaceBrush}"
                    Padding="4">
                <DockPanel>
                    <StackPanel x:Name="SourceFilterPanel" DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,4,4,8">
                        <TextBlock Text="Source:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox x:Name="SourceFilterCombo" MinWidth="160"
                                  SelectionChanged="SourceFilterCombo_SelectionChanged"/>
                    </StackPanel>
                    <ListBox x:Name="ItemList"
                             BorderThickness="0"
                             Background="Transparent"
                             SelectionChanged="ItemList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,4">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Preview}"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           FontSize="11"
                                           TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Subtitle}"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           FontSize="10"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                </DockPanel>
            </Border>

            <Border Grid.Column="2"
                    Margin="8,0,0,0"
                    BorderBrush="{StaticResource BorderStrongBrush}"
                    BorderThickness="1"
                    Background="{StaticResource BgSurfaceBrush}"
                    Padding="8">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button x:Name="AcceptButton"
                                Content="Accept"
                                Padding="12,6"
                                Margin="0,0,8,0"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="Accept_Click"/>
                        <Button x:Name="DismissButton"
                                Content="Dismiss"
                                Padding="12,6"
                                Margin="0,0,8,0"
                                Click="Dismiss_Click"/>
                        <Button x:Name="AcceptAllButton"
                                Content="Accept all in category"
                                Padding="12,6"
                                Margin="0,0,8,0"
                                Click="AcceptAll_Click"/>
                        <Button x:Name="DismissAllButton"
                                Content="Dismiss all in category"
                                Padding="12,6"
                                Margin="0,0,8,0"
                                Click="DismissAll_Click"/>
                        <Button x:Name="DetailedReviewButton"
                                Content="Detailed JSON review…"
                                Padding="12,6"
                                Visibility="Collapsed"
                                Click="DetailedReview_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="DetailPlaceholder"
                               DockPanel.Dock="Top"
                               Text="Select a category and proposal to inspect details."
                               Foreground="{StaticResource TextMutedBrush}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,8"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <TextBox x:Name="DetailBox"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 FontFamily="Consolas"
                                 FontSize="12"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button Content="Close"
                    Padding="12,6"
                    IsDefault="True"
                    Click="Close_Click"/>
        </StackPanel>
    </Grid>
</shell:ShellDialogWindow>
