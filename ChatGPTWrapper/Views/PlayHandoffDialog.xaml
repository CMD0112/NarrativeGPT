<Window x:Class="ChatGPTWrapper.Views.PlayHandoffDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hand off to new chat"
        Height="640"
        Width="720"
        MinHeight="480"
        MinWidth="560"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBaseBrush}"
        Foreground="{StaticResource TextPrimaryBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,12"
                   Foreground="{StaticResource TextMutedBrush}"
                   Text="Review carry-forward context, release the current play thread, and paste a handoff packet into a new Project chat to continue your story."/>
        <TabControl x:Name="WizardTabs" Grid.Row="1">
            <TabItem Header="1. Review">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8">
                        <TextBlock Text="Handoff mode" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <ComboBox x:Name="HandoffModeCombo" Margin="0,0,0,8" SelectionChanged="HandoffSettings_Changed">
                            <ComboBoxItem Content="Summary only" Tag="SummaryOnly"/>
                            <ComboBoxItem Content="Summary + recent transcript (6 turns)" Tag="SummaryWithTranscript" IsSelected="True"/>
                            <ComboBoxItem Content="Extended transcript (12 turns)" Tag="ExtendedTranscript"/>
                        </ComboBox>
                        <TextBlock Text="Carry-forward summary" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBox x:Name="SummaryBox" AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" MinHeight="100" Margin="0,0,0,8"
                                 TextChanged="HandoffSettings_Changed"/>
                        <TextBlock x:Name="MetaLine" FontFamily="Consolas" FontSize="11" Margin="0,0,0,8"/>
                        <TextBlock Text="Packet preview" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBox x:Name="PacketPreviewBox" IsReadOnly="True" AcceptsReturn="True"
                                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" MinHeight="180"/>
                        <WrapPanel Margin="0,8,0,0">
                            <Button Content="Copy packet" Padding="10,5" Margin="0,0,8,0" Click="Copy_Click"/>
                            <Button Content="Refresh preview" Padding="10,5" Click="RefreshPreview_Click"/>
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="2. Rotate">
                <StackPanel Margin="8">
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                               Text="Release the current play thread and copy the handoff packet to your clipboard. Then create a new Project chat and paste it as the first message."/>
                    <TextBlock x:Name="NewThreadStatusLine" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <Button x:Name="CreateNewThreadButton" Content="Hand off to new chat…" Padding="12,6"
                            HorizontalAlignment="Left" Click="CreateNewThread_Click"/>
                </StackPanel>
            </TabItem>
            <TabItem Header="3. Verify">
                <StackPanel Margin="8">
                    <TextBlock Text="Paste the handoff packet you sent in the new thread:" Margin="0,0,0,4"/>
                    <TextBox x:Name="VerifyPacketBox" AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" FontFamily="Consolas" MinHeight="200" Margin="0,0,0,8"/>
                    <WrapPanel Margin="0,0,0,8">
                        <Button Content="Verify hash" Padding="10,5" Margin="0,0,8,0" Click="Verify_Click"/>
                        <Button Content="Rollback handoff" Padding="10,5" Click="Rollback_Click"/>
                    </WrapPanel>
                    <TextBlock x:Name="VerifyResultLine" TextWrapping="Wrap" FontWeight="SemiBold"/>
                </StackPanel>
            </TabItem>
        </TabControl>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Close" Padding="14,6" IsDefault="True" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
