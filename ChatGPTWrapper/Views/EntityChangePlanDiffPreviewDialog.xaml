<Window x:Class="ChatGPTWrapper.Views.EntityChangePlanDiffPreviewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Canon change preview"
        Height="560"
        Width="780"
        MinHeight="400"
        MinWidth="620"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBaseBrush}"
        Foreground="{StaticResource TextPrimaryBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="SummaryLine" TextWrapping="Wrap" Margin="0,0,0,8"/>
        <TextBox x:Name="DiffPreviewBox"
                 Grid.Row="1"
                 IsReadOnly="True"
                 TextWrapping="NoWrap"
                 AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 FontFamily="Consolas"
                 FontSize="11"/>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Close" Padding="12,6" IsDefault="True" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
