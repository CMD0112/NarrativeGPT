<Window x:Class="ChatGPTWrapper.Views.ProjectLinkWizard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Link ChatGPT Project"
        Height="520"
        Width="520"
        MinHeight="460"
        MinWidth="480"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource DialogBgBrush}"
        Foreground="{StaticResource TextBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,12"
                   Text="Link this adventure to a ChatGPT Project. You must be signed in on the ChatGPT browser tab (shown when you open this dialog). Use Refresh list after signing in."/>
        <TextBlock x:Name="StatusLine" Grid.Row="1" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
        <TabControl x:Name="ModeTabs" Grid.Row="2" Margin="0,0,0,12">
            <TabItem Header="Existing project">
                <DockPanel Margin="8">
                    <Button x:Name="RefreshButton" DockPanel.Dock="Top" Content="Refresh list" Padding="10,4" Margin="0,0,0,8" Click="Refresh_Click"/>
                    <ListBox x:Name="ProjectList" DisplayMemberPath="Title"
                              Background="{StaticResource PanelBgBrush}"
                              Foreground="{StaticResource TextBrush}"
                              BorderBrush="{StaticResource BorderBrushDark}"/>
                </DockPanel>
            </TabItem>
            <TabItem Header="Create new">
                <StackPanel Margin="8">
                    <TextBlock Text="Project name" Margin="0,0,0,4"/>
                    <TextBox x:Name="NewProjectNameBox" Margin="0,0,0,8"/>
                    <TextBlock Text="Uses adventure title by default when empty." Foreground="{StaticResource MutedTextBrush}" FontSize="11"/>
                </StackPanel>
            </TabItem>
        </TabControl>
        <StackPanel Grid.Row="3" Margin="0,0,0,12">
            <TextBlock Foreground="{StaticResource MutedTextBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"
                       Text="After linking, publish source files manually via Source Manager (copy/drag to Project Files)."/>
            <CheckBox x:Name="UpdateInstructionsCheck" Content="Push narrator instructions from scenario" IsChecked="False" Margin="0,0,0,6"/>
            <CheckBox x:Name="CreateThreadCheck" Content="Create or pick play thread in Project" IsChecked="True"/>
        </StackPanel>
        <TextBlock x:Name="ErrorLine" Grid.Row="4" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Padding="14,6" Margin="0,0,8,0" IsCancel="True"/>
            <Button x:Name="LinkButton" Content="Link project" Style="{StaticResource PrimaryButtonStyle}" MinWidth="88" IsDefault="True" Click="Link_Click"/>
        </StackPanel>
    </Grid>
</Window>
