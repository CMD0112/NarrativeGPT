<UserControl x:Class="ChatGPTWrapper.Views.NarratorBehaviorPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="220">
    <StackPanel>
        <TextBlock Text="Scene profile" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,0,0,4"/>
        <ComboBox x:Name="SceneProfileCombo" Margin="0,0,0,8" Padding="4,2"
                  SelectionChanged="SceneProfile_Changed"/>
        <TextBlock x:Name="OverrideChipsText" TextWrapping="Wrap" FontSize="11"
                   Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,8"/>
        <TextBlock Text="Apply changes to" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,0,0,4"/>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <RadioButton x:Name="ScopeTurnRadio" Content="This send" Margin="0,0,12,0"
                         Checked="Scope_Changed"/>
            <RadioButton x:Name="ScopeSessionRadio" Content="Session" Margin="0,0,12,0"
                         Checked="Scope_Changed"/>
            <RadioButton x:Name="ScopeAdventureRadio" Content="Adventure default"
                         Checked="Scope_Changed"/>
        </StackPanel>
        <TextBlock x:Name="ScopeHintText" TextWrapping="Wrap" FontSize="11"
                   Foreground="{DynamicResource WarningBrush}" Margin="0,0,0,8"
                   Visibility="Collapsed"
                   Text="Adventure default updates the narrator contract baseline — use Play settings → Behavior for boundaries and portrayal rules."/>
        <TextBlock Text="Narration (delivery)" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,4"/>
        <TextBlock TextWrapping="Wrap" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"
                   Margin="0,0,0,6"
                   Text="Length, detail, tone, and pacing — how the reply is written. Definitions in narrator-scales.md § narration-scales."/>
        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="88"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Length" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,0,8,6"/>
            <ComboBox x:Name="ResponseLengthCombo" Grid.Row="0" Grid.Column="1" Padding="4,2" Margin="0,0,0,6"
                      SelectionChanged="Parameter_Changed"/>
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Detail" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,0,8,6"/>
            <ComboBox x:Name="DetailLevelCombo" Grid.Row="1" Grid.Column="1" Padding="4,2" Margin="0,0,0,6"
                      SelectionChanged="Parameter_Changed"/>
            <TextBlock Grid.Row="2" Grid.Column="0" Text="Tone" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,0,8,6"/>
            <ComboBox x:Name="ToneCombo" Grid.Row="2" Grid.Column="1" Padding="4,2" Margin="0,0,0,6"
                      SelectionChanged="Parameter_Changed" LostFocus="Parameter_Changed"/>
            <TextBlock Grid.Row="3" Grid.Column="0" Text="Pacing" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,0,8,6"/>
            <ComboBox x:Name="NarrativePacingCombo" Grid.Row="3" Grid.Column="1" Padding="4,2" Margin="0,0,0,6"
                      SelectionChanged="Parameter_Changed"/>
        </Grid>
        <TextBlock Text="Combat &amp; stakes" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,4"/>
        <TextBlock TextWrapping="Wrap" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"
                   Margin="0,0,0,6"
                   Text="Challenge, violence, and consequence weight — separate from narration delivery. Definitions in narrator-scales.md § combat-scales."/>
        <Grid Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="88"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Combat diff." VerticalAlignment="Center"
                       Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,0,8,6"/>
            <ComboBox x:Name="DifficultyCombo" Grid.Row="0" Grid.Column="1" Padding="4,2" Margin="0,0,0,6"
                      SelectionChanged="Parameter_Changed" LostFocus="Parameter_Changed"/>
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Violence" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,0,8,6"/>
            <ComboBox x:Name="ViolenceCombo" Grid.Row="1" Grid.Column="1" Padding="4,2" Margin="0,0,0,6"
                      SelectionChanged="Parameter_Changed"/>
            <TextBlock Grid.Row="2" Grid.Column="0" Text="Consequences" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,0,8,6"/>
            <ComboBox x:Name="ConsequenceWeightCombo" Grid.Row="2" Grid.Column="1" Padding="4,2" Margin="0,0,0,6"
                      SelectionChanged="Parameter_Changed"/>
        </Grid>
        <WrapPanel Margin="0,4,0,0">
            <Button Content="Reset scope" Padding="6,2" Margin="0,0,8,4"
                    Click="ResetScope_Click"/>
        </WrapPanel>
        <Expander Header="Turn &amp; session directives" Margin="0,8,0,0" IsExpanded="False">
            <StackPanel Margin="0,8,0,0">
                <TextBlock Text="Turn directive (next send only)" Margin="0,0,0,4"/>
                <TextBox x:Name="TurnDirectiveBox" AcceptsReturn="True" TextWrapping="Wrap"
                         MinHeight="48" Margin="0,0,0,8" LostFocus="AdvancedField_Changed"
                         ToolTip="Freeform instruction injected once into the next play packet."/>
                <TextBlock Text="Session addendum (this session)" Margin="0,0,0,4"/>
                <TextBox x:Name="SessionAddendumBox" AcceptsReturn="True" TextWrapping="Wrap"
                         MinHeight="48" Margin="0,0,0,8" LostFocus="AdvancedField_Changed"
                         ToolTip="Optional note appended to turn overrides for the rest of this play session."/>
                <CheckBox x:Name="EmphasizeBoundariesCheck" Content="Emphasize content boundaries"
                          Margin="0,0,0,6" Checked="AdvancedField_Changed" Unchecked="AdvancedField_Changed"/>
                <CheckBox x:Name="EmphasizePortrayalRulesCheck" Content="Emphasize portrayal rules"
                          Checked="AdvancedField_Changed" Unchecked="AdvancedField_Changed"/>
            </StackPanel>
        </Expander>
    </StackPanel>
</UserControl>
