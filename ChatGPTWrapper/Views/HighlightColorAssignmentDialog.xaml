<shell:ShellDialogWindow xmlns:shell="clr-namespace:ChatGPTWrapper.Shell" x:Class="ChatGPTWrapper.Views.HighlightColorAssignmentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Auto-color assignment"
        Height="520"
        Width="640"
        MinHeight="400"
        MinWidth="480"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBaseBrush}"
        Foreground="{StaticResource TextPrimaryBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Style="{StaticResource ShellSectionHintStyle}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,12"
                   Text="Configure how cast import and other automatic phrase colors are chosen. Presets are starting points — tweak options below and save as Custom."/>

        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <TextBlock Text="Preset" Margin="0,0,0,4"/>
            <ComboBox x:Name="ProfileCombo"
                      MinHeight="28"
                      DisplayMemberPath="Name"
                      SelectionChanged="ProfileCombo_SelectionChanged"/>
            <TextBlock x:Name="ProfileDescriptionText"
                       Margin="0,6,0,0"
                       Foreground="{StaticResource TextMutedBrush}"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <ScrollViewer Grid.Row="2" Style="{StaticResource ShellFormScrollViewerStyle}">
            <StackPanel>
                <TextBlock Text="Palette" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Source" VerticalAlignment="Center" Margin="0,0,8,8"/>
                    <ComboBox x:Name="PaletteSourceCombo" Grid.Row="0" Grid.Column="1" Margin="0,0,0,8" SelectionChanged="Option_Changed"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Hue anchor" VerticalAlignment="Center" Margin="0,0,8,8"/>
                    <ComboBox x:Name="HueAnchorCombo" Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" SelectionChanged="Option_Changed"/>
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Hue step (°)" VerticalAlignment="Center" Margin="0,0,8,8"/>
                    <TextBox x:Name="HueStepBox" Grid.Row="2" Grid.Column="1" Margin="0,0,0,8" LostFocus="Option_Changed"/>
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Generated colors" VerticalAlignment="Center" Margin="0,0,8,8"
                               ToolTip="0 = auto-scale with cast size (floor 48, max 96). Fixed values override the floor."/>
                    <TextBox x:Name="GeneratedCountBox" Grid.Row="3" Grid.Column="1" Margin="0,0,0,8" LostFocus="Option_Changed"/>
                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Contrast canvas" VerticalAlignment="Center" Margin="0,0,8,8"/>
                    <ComboBox x:Name="CanvasSourceCombo" Grid.Row="4" Grid.Column="1" Margin="0,0,0,8" SelectionChanged="Option_Changed"/>
                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Saturation" VerticalAlignment="Center" Margin="0,0,8,8"/>
                    <StackPanel Grid.Row="5" Grid.Column="1" Margin="0,0,0,8">
                        <CheckBox x:Name="SaturationAutoCheck" Content="Auto (canvas-adaptive)" IsChecked="True" Checked="Option_Changed" Unchecked="Option_Changed"/>
                        <Slider x:Name="SaturationSlider" Minimum="0.2" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True" IsEnabled="False" ValueChanged="Option_Changed"/>
                    </StackPanel>
                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Lightness" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <StackPanel Grid.Row="6" Grid.Column="1">
                        <CheckBox x:Name="LightnessAutoCheck" Content="Auto (canvas-adaptive)" IsChecked="True" Checked="Option_Changed" Unchecked="Option_Changed"/>
                        <Slider x:Name="LightnessSlider" Minimum="0.25" Maximum="0.85" TickFrequency="0.05" IsSnapToTickEnabled="True" IsEnabled="False" ValueChanged="Option_Changed"/>
                    </StackPanel>
                </Grid>

                <StackPanel x:Name="CustomSeedsPanel" Margin="0,0,0,12" Visibility="Collapsed">
                    <TextBlock Text="Custom seed colors" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <WrapPanel x:Name="CustomSeedsSwatchesPanel" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Add seed…" Padding="8,4" Margin="0,0,8,0" Click="AddSeedColor_Click"/>
                        <Button Content="Clear seeds" Padding="8,4" Click="ClearSeeds_Click"/>
                    </StackPanel>
                </StackPanel>

                <TextBlock Text="Assignment" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Strategy" VerticalAlignment="Center" Margin="0,0,8,8"/>
                    <ComboBox x:Name="StrategyCombo" Grid.Row="0" Grid.Column="1" Margin="0,0,0,8" SelectionChanged="Option_Changed"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Player color" VerticalAlignment="Center" Margin="0,0,8,8"/>
                    <ComboBox x:Name="PlayerColorCombo" Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" SelectionChanged="PlayerColorCombo_SelectionChanged"/>
                    <StackPanel x:Name="PlayerCustomColorPanel" Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8" Visibility="Collapsed">
                        <TextBox x:Name="PlayerCustomColorBox" Width="120" MinHeight="28" LostFocus="Option_Changed"/>
                        <Button Content="Pick…" Margin="8,0,0,0" Padding="8,4" Click="PickPlayerCustomColor_Click"/>
                    </StackPanel>
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Aliases" VerticalAlignment="Center" Margin="0,0,8,8"/>
                    <ComboBox x:Name="AliasColorCombo" Grid.Row="3" Grid.Column="1" Margin="0,0,0,8" SelectionChanged="Option_Changed"/>
                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Min contrast" VerticalAlignment="Center" Margin="0,0,8,8"/>
                    <Slider x:Name="MinContrastSlider" Grid.Row="4" Grid.Column="1" Minimum="3" Maximum="7" TickFrequency="0.5" IsSnapToTickEnabled="True" Margin="0,0,0,8" ValueChanged="Option_Changed"/>
                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Assignment salt" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal">
                        <TextBox x:Name="AssignmentSaltBox" Width="72" MinHeight="28" LostFocus="Option_Changed"/>
                        <Button Content="Shuffle assignment" Margin="8,0,0,0" Padding="8,4" Click="ShuffleAssignment_Click"/>
                    </StackPanel>
                </Grid>

                <TextBlock x:Name="StrategyHintText"
                           Foreground="{StaticResource TextMutedBrush}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,12"/>

                <Expander Header="Advanced" Margin="0,0,0,12">
                    <StackPanel Margin="0,8,0,0">
                        <Button Content="Export profile JSON…" HorizontalAlignment="Left" Padding="8,4" Margin="0,0,0,8" Click="ExportProfileJson_Click"/>
                        <Button Content="Import profile JSON…" HorizontalAlignment="Left" Padding="8,4" Click="ImportProfileJson_Click"/>
                    </StackPanel>
                </Expander>

                <CheckBox x:Name="AvoidDuplicatesCheck"
                          Content="Avoid duplicate colors when possible"
                          Margin="0,0,0,12"
                          Checked="Option_Changed"
                          Unchecked="Option_Changed"/>

                <TextBlock Text="Palette preview (current theme)" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <WrapPanel x:Name="PalettePreviewPanel" Margin="0,0,0,8"/>
            </StackPanel>
        </ScrollViewer>

        <TextBlock x:Name="ValidationText"
                   Grid.Row="3"
                   Foreground="{StaticResource ErrorBrush}"
                   TextWrapping="Wrap"
                   Margin="0,8,0,0"
                   Visibility="Collapsed"/>

        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Content="Cancel"
                    Padding="12,6"
                    MinWidth="80"
                    Margin="0,0,8,0"
                    IsCancel="True"/>
            <Button Content="OK"
                    Padding="12,6"
                    MinWidth="80"
                    IsDefault="True"
                    Click="Ok_Click"/>
        </StackPanel>
    </Grid>
</shell:ShellDialogWindow>
