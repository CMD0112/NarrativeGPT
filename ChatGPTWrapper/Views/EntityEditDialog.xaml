<Window x:Class="ChatGPTWrapper.Views.EntityEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ChatGPTWrapper.Views"
        Title="Entity"
        Height="640"
        Width="720"
        MinHeight="520"
        MinWidth="620"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBaseBrush}"
        Foreground="{StaticResource TextPrimaryBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Style="{StaticResource ShellCardStyle}"
                Padding="12"
                Margin="0,0,0,12">
            <StackPanel>
                <WrapPanel x:Name="HeaderLabelsPanel" Margin="0,0,0,8"/>
                <TextBlock x:Name="HeaderTitleBlock"
                           FontSize="{StaticResource FontSizeTitle}"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <local:EntityEditFormHost x:Name="FormHost" ShowInlineActions="False"/>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Button x:Name="DeleteButton"
                    Content="Delete…"
                    Padding="12,6"
                    HorizontalAlignment="Left"
                    Visibility="Collapsed"
                    Click="Delete_Click"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Padding="12,6" Margin="0,0,8,0" IsCancel="True"/>
                <Button Content="Save" Style="{StaticResource PrimaryButtonStyle}" MinWidth="88" IsDefault="True" Click="Save_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
