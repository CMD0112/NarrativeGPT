<shell:ShellDialogWindow xmlns:shell="clr-namespace:ChatGPTWrapper.Shell" x:Class="ChatGPTWrapper.Views.EntityEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ChatGPTWrapper.Views"
        Title="Entity"
        Height="720"
        Width="860"
        MinHeight="520"
        MinWidth="640"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBaseBrush}"
        Foreground="{StaticResource TextPrimaryBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="320"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource ShellCardStyle}" Padding="12" Margin="0,0,0,12">
            <DockPanel LastChildFill="True">
                <Border x:Name="PortraitThumbBorder"
                        DockPanel.Dock="Left"
                        Width="72"
                        Height="72"
                        Margin="0,0,12,0"
                        CornerRadius="6"
                        Background="{StaticResource BgElevatedBrush}"
                        BorderBrush="{StaticResource BorderSubtleBrush}"
                        BorderThickness="1"
                        ClipToBounds="True">
                    <Grid>
                        <Image x:Name="PortraitThumbImage" Stretch="UniformToFill" Visibility="Collapsed"/>
                        <TextBlock x:Name="PortraitPlaceholderText"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextMutedBrush}"/>
                    </Grid>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <WrapPanel x:Name="HeaderLabelsPanel" Margin="0,0,0,8"/>
                    <TextBlock x:Name="HeaderTitleBlock"
                               FontSize="{StaticResource FontSizeTitle}"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"/>
                    <TextBlock x:Name="HeaderSyncBadge"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Margin="0,6,0,0"
                               Visibility="Collapsed"/>
                    <StackPanel x:Name="HeaderStatePanel" Margin="0,8,0,0" Visibility="Collapsed">
                        <TextBlock x:Name="HeaderStateSkim"
                                   FontSize="10"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   TextWrapping="Wrap"/>
                        <TextBlock x:Name="HeaderStateLink"
                                   Text="Edit in State →"
                                   FontSize="10"
                                   Foreground="{StaticResource AccentLinkBrush}"
                                   Margin="0,4,0,0"
                                   Cursor="Hand"
                                   MouseLeftButtonUp="HeaderStateLink_Click"/>
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <TabControl x:Name="DialogTabs" Grid.Row="1" SelectionChanged="DialogTabs_SelectionChanged">
            <TabItem Header="Profile">
                <ScrollViewer Style="{StaticResource ShellTabScrollViewerStyle}">
                    <local:EntityEditFormHost x:Name="FormHost"/>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Sources">
                <ContentControl x:Name="SourcesContentHost"/>
            </TabItem>
            <TabItem Header="Mentions">
                <ContentControl x:Name="MentionsContentHost"/>
            </TabItem>
            <TabItem Header="History">
                <ContentControl x:Name="HistoryContentHost"/>
            </TabItem>
        </TabControl>

        <local:EntityWorkspaceHost x:Name="Workspace" Visibility="Collapsed"/>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Button x:Name="DeleteButton"
                    Content="Delete…"
                    Padding="12,6"
                    HorizontalAlignment="Left"
                    Visibility="Collapsed"
                    Click="Delete_Click"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Padding="12,6" Margin="0,0,8,0" IsCancel="True"/>
                <Button Content="Save" Style="{StaticResource PrimaryButtonStyle}" MinWidth="88" IsDefault="True" Click="Save_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</shell:ShellDialogWindow>
