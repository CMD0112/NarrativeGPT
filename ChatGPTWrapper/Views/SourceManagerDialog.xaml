<Window x:Class="ChatGPTWrapper.Views.SourceManagerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Source Manager"
        Height="720"
        Width="920"
        MinHeight="560"
        MinWidth="720"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBaseBrush}"
        Foreground="{StaticResource TextPrimaryBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Expander x:Name="WalkthroughExpander" Grid.Row="0" Header="How to publish" IsExpanded="True" Margin="0,0,0,10">
            <StackPanel Margin="8,4,0,0">
                <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,0,0,6"
                           Text="1. Refresh export to write canonical files under your adventure sources folder."/>
                <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,0,0,6"
                           Text="2. Design instructions — define boundaries in the designer, Generate instructions file, then Copy instructions and paste into ChatGPT Project → Custom instructions. Mark instructions pasted when done."/>
                <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,0,0,6"
                           Text="3. Upload canon-format.md first (format reference), then lore files — open canonical folder (Explorer) and drag .md files onto ChatGPT Project → Files while this window stays open beside the browser. Or Copy from the grid. Mark Published when uploaded."/>
                <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,0,0,6"
                           Text="4. Optional: Probe project to download remote copies for comparison. Compare if project match shows Differ."/>
                <TextBlock x:Name="CanonicalPathLine" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
            </StackPanel>
        </Expander>

        <TextBlock x:Name="RepublishHintLine" Grid.Row="1" TextWrapping="Wrap" FontSize="11"
                   Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8"/>

        <Border Grid.Row="2" Padding="10,8" Margin="0,0,0,10" CornerRadius="{StaticResource RadiusControl}"
                Background="{StaticResource BgSurfaceBrush}">
            <StackPanel>
                <TextBlock Text="Project instructions" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBlock x:Name="InstructionStatusLine" Foreground="{StaticResource TextMutedBrush}" FontSize="11"
                           TextWrapping="Wrap" Margin="0,0,0,6"/>
                <TextBlock x:Name="InstructionDriftLine" Foreground="{StaticResource TextMutedBrush}" FontSize="11"
                           TextWrapping="Wrap" Margin="0,0,0,8"/>
                <WrapPanel>
                    <Button Content="Design instructions…" Padding="10,5" Margin="0,0,8,4" Click="DesignInstructions_Click"/>
                    <Button Content="Copy instructions" Padding="10,5" Margin="0,0,8,4" Click="CopyInstructions_Click"/>
                    <Button Content="Preview instructions…" Padding="10,5" Margin="0,0,8,4" Click="PreviewInstructions_Click"/>
                    <Button Content="Mark instructions pasted" Padding="10,5" Margin="0,0,8,4" Click="MarkInstructionsPasted_Click"/>
                    <Button x:Name="OpenProjectSettingsButton" Content="Open project settings" Padding="10,5"
                            Margin="0,0,8,4" Click="OpenProjectSettings_Click"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="200"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="260" MinWidth="180" MaxWidth="420"/>
            </Grid.ColumnDefinitions>
            <GridSplitter Grid.Column="1"
                          Style="{StaticResource SidePanelGridSplitterStyle}"
                          ResizeBehavior="PreviousAndNext"
                          ResizeDirection="Columns"
                          Width="8"/>
            <DockPanel Grid.Column="0">
                <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Button Content="Refresh export" Padding="10,5" Margin="0,0,8,4" Click="RefreshExport_Click"/>
                    <Button Content="Check canon" Padding="10,5" Margin="0,0,8,4" Click="CheckCanon_Click"
                            ToolTip="Validate sectioned sources against the canon schema"/>
                    <Button Content="Open folder for drag" Padding="10,5" Margin="0,0,8,4" Click="OpenFolderForDrag_Click"
                            ToolTip="Opens Explorer so you can drag files to ChatGPT while this window stays open"/>
                    <Button Content="Open canonical folder" Padding="10,5" Margin="0,0,8,4" Click="OpenCanonicalFolder_Click"/>
                    <Button Content="Open history folder" Padding="10,5" Margin="0,0,8,4" Click="OpenHistoryFolder_Click"/>
                    <Button x:Name="ProbeAllButton" Content="Probe project" Padding="10,5" Margin="0,0,8,4" Click="ProbeAll_Click"/>
                    <Button Content="Mark all uploaded" Padding="10,5" Margin="0,0,8,4" Click="MarkAllUploaded_Click"/>
                </WrapPanel>
                <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                    <Button Content="Open canonical" Padding="8,4" Margin="0,0,6,4" Click="OpenCanonical_Click"/>
                    <Button Content="Copy" Padding="8,4" Margin="0,0,6,4" Click="CopyFile_Click"/>
                    <Button Content="Mark uploaded" Padding="8,4" Margin="0,0,6,4" Click="MarkUploaded_Click"/>
                    <Button x:Name="ProbeFileButton" Content="Probe" Padding="8,4" Margin="0,0,6,4" Click="ProbeFile_Click"/>
                    <Button x:Name="CompareButton" Content="Compare with project" Padding="8,4" Margin="0,0,6,4" Click="Compare_Click"/>
                    <Button Content="View history" Padding="8,4" Margin="0,0,6,4" Click="ViewHistory_Click"/>
                    <Button Content="Restore version…" Padding="8,4" Margin="0,0,6,4" Click="RestoreVersion_Click"/>
                    <Button Content="Synthesize with AI…" Padding="8,4" Margin="0,0,6,4" Click="SynthesizeSource_Click"/>
                </WrapPanel>
                <DataGrid x:Name="FilesGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                          SelectionMode="Single" PreviewMouseMove="FilesGrid_PreviewMouseMove"
                          SelectionChanged="FilesGrid_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="File" Binding="{Binding RelativePath}" Width="*" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding LocalStatus}" Width="100" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Last uploaded" Binding="{Binding LastUploaded}" Width="120" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Project match" Binding="{Binding ProjectMatch}" Width="110" IsReadOnly="True"/>
                        <DataGridCheckBoxColumn Header="Published" Binding="{Binding IsPublished, UpdateSourceTrigger=PropertyChanged}" Width="72"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
            <DockPanel Grid.Column="2">
                <TextBlock DockPanel.Dock="Top" Text="Version history" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                    <Button Content="Preview archive" Padding="8,4" Margin="0,0,6,4" Click="PreviewArchive_Click"/>
                    <Button Content="Compare vs current" Padding="8,4" Margin="0,0,0,4" Click="CompareArchive_Click"/>
                </WrapPanel>
                <ListBox x:Name="HistoryList" DisplayMemberPath="DisplayLabel" SelectionChanged="HistoryList_SelectionChanged"/>
            </DockPanel>
        </Grid>

        <StackPanel Grid.Row="4" Margin="0,12,0,0">
            <TextBlock x:Name="StatusLine" Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="ApiSyncDiagnosticsButton" Content="API sync diagnostics…" Padding="12,6" Margin="0,0,8,0"
                        Click="ApiSyncDiagnostics_Click"/>
                <Button Content="Close" Padding="12,6" Margin="0,0,8,0" IsCancel="True" Click="Close_Click"/>
                <Button Content="Save" Style="{StaticResource PrimaryButtonStyle}" MinWidth="88" IsDefault="True" Click="Save_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
