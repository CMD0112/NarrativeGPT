<Window x:Class="ChatGPTWrapper.Views.AdventureDesignWizard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Design adventure — Setup"
        Height="480"
        Width="560"
        MinHeight="400"
        MinWidth="480"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBaseBrush}"
        Foreground="{StaticResource TextPrimaryBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="TitleLine" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <TextBlock Grid.Row="1" TextWrapping="Wrap" Margin="0,0,0,4"
                   Foreground="{StaticResource TextMutedBrush}"
                   Text="Set up your adventure, link a ChatGPT Project, then continue to Design mode where you collaborate in a dedicated project thread."/>
        <TextBlock x:Name="StatusLine" Grid.Row="2" TextWrapping="Wrap" Margin="0,0,0,8"
                   Foreground="{DynamicResource AccentLinkBrush}"/>
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="DraftPanel" Margin="4"/>
        </ScrollViewer>
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0"
                    Style="{StaticResource ShellCommandBarStyle}">
            <Button x:Name="LinkProjectButton" Content="Link Project…"
                    Style="{StaticResource ShellCommandBarSecondarySlot}"
                    Margin="0,0,8,0"
                    Click="LinkProject_Click"/>
            <Button x:Name="ContinueButton" Content="Continue to Design →"
                    Style="{StaticResource ShellCommandBarPrimarySlot}"
                    Margin="0,0,8,0"
                    Click="Continue_Click"/>
            <Button Content="Cancel"
                    Style="{StaticResource ShellCommandBarSecondarySlot}"
                    IsCancel="True"
                    Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
