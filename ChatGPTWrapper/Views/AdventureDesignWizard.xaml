<Window x:Class="ChatGPTWrapper.Views.AdventureDesignWizard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Design adventure — Setup"
        Height="480"
        Width="560"
        MinHeight="400"
        MinWidth="480"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource DialogBgBrush}"
        Foreground="{StaticResource TextBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="TitleLine" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <TextBlock Grid.Row="1" TextWrapping="Wrap" Margin="0,0,0,4"
                   Foreground="{StaticResource MutedTextBrush}"
                   Text="Set up your adventure, link a ChatGPT Project, then continue to Design mode where you collaborate in a dedicated project thread."/>
        <TextBlock x:Name="StatusLine" Grid.Row="1" TextWrapping="Wrap" Margin="0,40,0,8"
                   Foreground="{StaticResource AccentBrush}"/>
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="DraftPanel" Margin="4"/>
        </ScrollViewer>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="LinkProjectButton" Content="Link Project…" Padding="10,5" Margin="0,0,6,0"
                    Click="LinkProject_Click"/>
            <Button x:Name="ContinueButton" Content="Continue to Design →" Style="{StaticResource PrimaryButtonStyle}"
                    Padding="12,6" Margin="0,0,6,0" Click="Continue_Click"/>
            <Button Content="Cancel" Padding="12,6" IsCancel="True" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
