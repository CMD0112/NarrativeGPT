<Window x:Class="ChatGPTWrapper.Views.PreferencesHubDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Preferences"
        SizeToContent="WidthAndHeight"
        MinWidth="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BgBaseBrush}">
    <Border Style="{StaticResource ShellCardStyle}" Margin="16">
        <StackPanel>
            <TextBlock Text="Preferences"
                       Style="{StaticResource ShellSectionHeaderStyle}"
                       Margin="0,0,0,4"/>
            <TextBlock Text="Open a settings area below."
                       Style="{StaticResource ShellSectionHintStyle}"
                       Margin="0,0,0,12"/>

            <Button Content="Appearance &amp; theme…"
                    Style="{StaticResource ShellCommandBarSecondarySlot}"
                    HorizontalAlignment="Stretch"
                    Margin="0,0,0,8"
                    Click="AppearanceTheme_Click"/>
            <Button Content="Continuous view &amp; format…"
                    Style="{StaticResource ShellCommandBarSecondarySlot}"
                    HorizontalAlignment="Stretch"
                    Margin="0,0,0,8"
                    Click="ContinuousView_Click"/>
            <Button Content="Wrapper settings…"
                    Style="{StaticResource ShellCommandBarSecondarySlot}"
                    HorizontalAlignment="Stretch"
                    Margin="0,0,0,8"
                    Click="WrapperSettings_Click"/>
            <Button x:Name="PlaySettingsButton"
                    Content="Play session settings…"
                    Style="{StaticResource ShellCommandBarSecondarySlot}"
                    HorizontalAlignment="Stretch"
                    Margin="0,0,0,12"
                    Click="PlaySettings_Click"/>

            <Button Content="Close"
                    Style="{StaticResource ShellCommandBarSecondarySlot}"
                    HorizontalAlignment="Right"
                    MinWidth="88"
                    IsCancel="True"/>
        </StackPanel>
    </Border>
</Window>
