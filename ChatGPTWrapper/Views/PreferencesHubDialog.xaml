<shell:ShellDialogWindow xmlns:shell="clr-namespace:ChatGPTWrapper.Shell" x:Class="ChatGPTWrapper.Views.PreferencesHubDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Preferences"
        Height="640"
        Width="520"
        MinHeight="480"
        MinWidth="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource BgBaseBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Style="{StaticResource ShellCardStyle}">
        <ScrollViewer Style="{StaticResource ShellFormScrollViewerStyle}">
            <StackPanel>
                <TextBlock Text="Preferences"
                           Style="{StaticResource ShellSectionHeaderStyle}"
                           Margin="0,0,0,4"/>
                <TextBlock Text="Settings grouped by scope. Use in-context controls in Play or Design when you are already in a session."
                           Style="{StaticResource ShellSectionHintStyle}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,12"/>

                <Border Style="{StaticResource ShellCardStyle}" Background="{DynamicResource BgElevatedBrush}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Reading mode" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBlock x:Name="TranscriptModeLine" TextWrapping="Wrap" Margin="0,0,0,4"/>
                        <TextBlock Text="Switch Native, Continuous, or Weave from the View menu. Typography for Continuous and Weave is under Reading &amp; format below."
                                   Style="{StaticResource ShellSectionHintStyle}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="Global" Style="{StaticResource ShellSectionHeaderStyle}" Margin="0,0,0,8"/>

                <Border Style="{StaticResource ShellCardStyle}" Margin="0,0,0,8" Padding="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="Appearance &amp; theme" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Border Style="{StaticResource ShellBadgeStyle}" Margin="8,0,0,0">
                                <TextBlock Text="Global" FontSize="10"/>
                            </Border>
                        </StackPanel>
                        <Button Grid.Row="0" Grid.Column="1" Grid.RowSpan="3"
                                Content="Open…"
                                Style="{StaticResource ShellCommandBarSecondarySlot}"
                                VerticalAlignment="Center"
                                MinWidth="72"
                                Click="AppearanceTheme_Click"/>
                        <TextBlock Grid.Row="1" Grid.Column="0"
                                   Text="Shell chrome, dialogs, and WebView theme tokens."
                                   Style="{StaticResource ShellSectionHintStyle}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,8,0"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource ShellCardStyle}" Margin="0,0,0,8" Padding="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="Reading &amp; format" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Border Style="{StaticResource ShellBadgeStyle}" Margin="8,0,0,0">
                                <TextBlock Text="Per mode" FontSize="10"/>
                            </Border>
                        </StackPanel>
                        <Button Grid.Row="0" Grid.Column="1" Grid.RowSpan="2"
                                Content="Open…"
                                Style="{StaticResource ShellCommandBarSecondarySlot}"
                                VerticalAlignment="Center"
                                MinWidth="72"
                                Click="ContinuousView_Click"/>
                        <TextBlock Grid.Row="1" Grid.Column="0"
                                   Text="Transcript typography, colors, highlights, and thread display. Primary entry: View → Format…"
                                   Style="{StaticResource ShellSectionHintStyle}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,8,0"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource ShellCardStyle}" Margin="0,0,0,16" Padding="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="Storage &amp; paths" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Border Style="{StaticResource ShellBadgeStyle}" Margin="8,0,0,0">
                                <TextBlock Text="Wrapper" FontSize="10"/>
                            </Border>
                        </StackPanel>
                        <Button Grid.Row="0" Grid.Column="1" Grid.RowSpan="2"
                                Content="Open…"
                                Style="{StaticResource ShellCommandBarSecondarySlot}"
                                VerticalAlignment="Center"
                                MinWidth="72"
                                Click="WrapperSettings_Click"/>
                        <TextBlock Grid.Row="1" Grid.Column="0"
                                   Text="Adventures folder location and local storage paths."
                                   Style="{StaticResource ShellSectionHintStyle}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,8,0"/>
                    </Grid>
                </Border>

                <StackPanel x:Name="AdventureSection" Visibility="Collapsed">
                    <TextBlock Text="Active adventure" Style="{StaticResource ShellSectionHeaderStyle}" Margin="0,0,0,4"/>
                    <TextBlock x:Name="AdventureTitleLine"
                               Style="{StaticResource ShellSectionHintStyle}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,8"/>

                    <Border Style="{StaticResource ShellCardStyle}" Margin="0,0,0,8" Padding="12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock x:Name="AdventureSettingsTitle" Text="Play settings" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <Border Style="{StaticResource ShellBadgeStyle}" Margin="8,0,0,0">
                                    <TextBlock Text="Adventure" FontSize="10"/>
                                </Border>
                            </StackPanel>
                            <TextBlock x:Name="AdventureSettingsHint"
                                       Text="Shortcut to the full play settings dialog. Prefer Play header ⚙ when you are in a session."
                                       Style="{StaticResource ShellSectionHintStyle}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,8"/>
                            <Button x:Name="PlaySettingsButton"
                                    Content="Open play settings…"
                                    Style="{StaticResource ShellCommandBarSecondarySlot}"
                                    HorizontalAlignment="Stretch"
                                    Margin="0,0,0,8"
                                    Click="PlaySettings_Click"/>
                            <Button x:Name="ThreadsHubButton"
                                    Content="Open Threads hub…"
                                    Style="{StaticResource ShellCommandBarSecondarySlot}"
                                    HorizontalAlignment="Stretch"
                                    Margin="0,0,0,8"
                                    Click="PlayThreads_Click"/>
                            <TextBlock x:Name="PlayJumpSectionLabel" Text="Jump to section" Style="{StaticResource ShellSectionHintStyle}" Margin="0,0,0,4"/>
                            <WrapPanel x:Name="PlayJumpSection">
                                <Button Content="Behavior"
                                        Style="{StaticResource ShellCommandBarSecondarySlot}"
                                        Padding="10,5"
                                        Margin="0,0,6,4"
                                        Click="PlayBehavior_Click"/>
                                <Button Content="Layout"
                                        Style="{StaticResource ShellCommandBarSecondarySlot}"
                                        Padding="10,5"
                                        Margin="0,0,6,4"
                                        Click="PlayLayout_Click"/>
                                <Button Content="Sources"
                                        Style="{StaticResource ShellCommandBarSecondarySlot}"
                                        Padding="10,5"
                                        Margin="0,0,6,4"
                                        Click="PlaySources_Click"/>
                                <Button Content="Session"
                                        Style="{StaticResource ShellCommandBarSecondarySlot}"
                                        Padding="10,5"
                                        Margin="0,0,6,4"
                                        Click="PlayThreads_Click"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="NoAdventureSection" Visibility="Visible">
                    <TextBlock Text="Adventure settings"
                               Style="{StaticResource ShellSectionHeaderStyle}"
                               Margin="0,0,0,4"/>
                    <TextBlock Text="Start or select an adventure in Play or Design to open session and thread settings from here."
                               Style="{StaticResource ShellSectionHintStyle}"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <Button Content="Close"
                        Style="{StaticResource ShellCommandBarSecondarySlot}"
                        HorizontalAlignment="Right"
                        MinWidth="88"
                        Margin="0,16,0,0"
                        IsCancel="True"/>
            </StackPanel>
        </ScrollViewer>
        </Border>
    </Grid>
</shell:ShellDialogWindow>
