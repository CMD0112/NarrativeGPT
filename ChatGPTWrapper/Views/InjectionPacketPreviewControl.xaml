<UserControl x:Class="ChatGPTWrapper.Views.InjectionPacketPreviewControl"

             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

             xmlns:services="clr-namespace:ChatGPTWrapper.Adventure.Services"

             MinWidth="240"

             MinHeight="120">

    <UserControl.Resources>

        <DataTemplate DataType="{x:Type services:InjectionSectionViewModel}">

            <Border Padding="6,5" Margin="0,0,0,2" CornerRadius="3"

                    Background="{StaticResource BgSurfaceBrush}">

                <Grid>

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*"/>

                        <ColumnDefinition Width="Auto"/>

                    </Grid.ColumnDefinitions>

                    <StackPanel>

                        <TextBlock Text="{Binding DisplayName}" FontSize="11"/>

                        <TextBlock Text="{Binding Note}" FontSize="10"

                                   Foreground="{StaticResource TextMutedBrush}"

                                   TextWrapping="Wrap"/>

                    </StackPanel>

                    <TextBlock Grid.Column="1" Text="{Binding StatusBadge}" FontSize="10" FontWeight="SemiBold"

                               Margin="8,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"

                               MaxWidth="200" TextAlignment="Right"/>

                </Grid>

            </Border>

        </DataTemplate>

    </UserControl.Resources>



    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">

        <StackPanel>

            <Border x:Name="EmptyStatePanel" Padding="10" CornerRadius="4"

                    Background="{StaticResource BgInsetBrush}" Margin="0,0,0,8"

                    Visibility="Collapsed">

                <TextBlock x:Name="EmptyStateText" TextWrapping="Wrap" FontSize="11"

                           Foreground="{StaticResource TextMutedBrush}"

                           Text="Enter a sample player line above to preview the injected packet."/>

            </Border>



            <Border x:Name="SummaryPanel" Padding="8" CornerRadius="4"

                    Background="{StaticResource BgInsetBrush}" Margin="0,0,0,8">

                <StackPanel>

                    <WrapPanel Margin="0,0,0,6">

                        <Border x:Name="DelegationBadge" Padding="6,2" CornerRadius="3" Margin="0,0,8,4"

                                Background="{StaticResource AccentSubtleBrush}">

                            <TextBlock x:Name="DelegationBadgeText" FontSize="11" FontWeight="SemiBold"/>

                        </Border>

                        <TextBlock x:Name="ModeBadgeText" FontSize="11" VerticalAlignment="Center"

                                   Foreground="{StaticResource TextMutedBrush}" Margin="0,0,8,4"/>

                        <TextBlock x:Name="HashBadgeText" FontSize="10" VerticalAlignment="Center"

                                   Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>

                    </WrapPanel>

                    <Grid Margin="0,0,0,4">

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="*"/>

                            <ColumnDefinition Width="Auto"/>

                        </Grid.ColumnDefinitions>

                        <ProgressBar x:Name="CharBudgetBar" Height="6" Minimum="0" Maximum="1"/>

                        <TextBlock x:Name="CharBudgetLabel" Grid.Column="1" FontSize="10"

                                   Foreground="{StaticResource TextMutedBrush}" Margin="8,0,0,0"

                                   VerticalAlignment="Center"/>

                    </Grid>

                    <TextBlock x:Name="MetaLineText" TextWrapping="Wrap" FontSize="10"

                               Foreground="{StaticResource TextMutedBrush}"/>

                </StackPanel>

            </Border>



            <TextBlock Text="Sections in next packet" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,4"/>

            <ListBox x:Name="SectionList" Margin="0,0,0,8" BorderThickness="0" Background="Transparent"

                     SelectionChanged="SectionList_SelectionChanged"

                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"

                     ScrollViewer.VerticalScrollBarVisibility="Disabled">

                <ListBox.ItemContainerStyle>

                    <Style TargetType="ListBoxItem">

                        <Setter Property="Padding" Value="0"/>

                        <Setter Property="Margin" Value="0"/>

                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>

                        <Setter Property="Background" Value="Transparent"/>

                        <Setter Property="Template">

                            <Setter.Value>

                                <ControlTemplate TargetType="ListBoxItem">

                                    <Border x:Name="Row" Background="{TemplateBinding Background}"

                                            Padding="0" CornerRadius="3">

                                        <ContentPresenter/>

                                    </Border>

                                    <ControlTemplate.Triggers>

                                        <Trigger Property="IsMouseOver" Value="True">

                                            <Setter TargetName="Row" Property="Background" Value="{StaticResource RowHoverBrush}"/>

                                        </Trigger>

                                        <Trigger Property="IsSelected" Value="True">

                                            <Setter TargetName="Row" Property="Background" Value="{StaticResource RowSelectedBrush}"/>

                                        </Trigger>

                                    </ControlTemplate.Triggers>

                                </ControlTemplate>

                            </Setter.Value>

                        </Setter>

                    </Style>

                </ListBox.ItemContainerStyle>

            </ListBox>



            <Expander x:Name="DeltaExpander" Header="What changed since last refresh" IsExpanded="True"

                      Margin="0,0,0,8" Visibility="Collapsed">

                <ItemsControl x:Name="DeltaList" Margin="0,4,0,0">

                    <ItemsControl.ItemTemplate>

                        <DataTemplate>

                            <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="10"

                                       Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>

                        </DataTemplate>

                    </ItemsControl.ItemTemplate>

                </ItemsControl>

            </Expander>



            <Expander x:Name="PacketBodyExpander" Header="Full packet text" IsExpanded="True">

                <TextBox x:Name="PacketBodyBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"

                         FontFamily="Consolas" FontSize="11" MinHeight="160" MaxHeight="480"

                         VerticalScrollBarVisibility="Auto" Background="{StaticResource BgInsetBrush}"

                         Margin="0,4,0,0"/>

            </Expander>

        </StackPanel>

    </ScrollViewer>

</UserControl>


