<Window x:Class="ChatGPTWrapper.Views.ResponseReviewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Review narrator response"
        Height="520"
        Width="640"
        MinHeight="400"
        MinWidth="480"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource DialogBgBrush}"
        Foreground="{StaticResource TextBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Review before accepting into the adventure log." Margin="0,0,0,8" Foreground="{StaticResource MutedTextBrush}"/>
        <TextBox x:Name="ResponseBox" Grid.Row="1" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
        <TextBlock x:Name="ErrorLine" Grid.Row="2" Margin="0,8,0,8" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap"/>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Reject" Margin="0,0,8,0" Padding="14,6" Click="Reject_Click"/>
            <Button Content="Retry" Margin="0,0,8,0" Padding="14,6" Click="Retry_Click"/>
            <Button Content="Accept" Style="{StaticResource PrimaryButtonStyle}" MinWidth="88" Margin="0,0,8,0" IsDefault="True" Click="Accept_Click"/>
            <Button Content="Accept edited" Padding="14,6" Click="AcceptEdited_Click"/>
        </StackPanel>
    </Grid>
</Window>
