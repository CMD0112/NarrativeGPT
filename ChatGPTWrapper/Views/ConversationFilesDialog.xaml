<shell:ShellDialogWindow xmlns:shell="clr-namespace:ChatGPTWrapper.Shell" x:Class="ChatGPTWrapper.Views.ConversationFilesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Conversation files"
        Height="420"
        Width="520"
        MinHeight="400"
        MinWidth="440"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBaseBrush}"
        Foreground="{StaticResource TextPrimaryBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="StatusLine" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
        <ListView x:Name="FilesList" Grid.Row="1" Margin="0,0,0,8">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Name" Width="220" DisplayMemberBinding="{Binding Name}"/>
                    <GridViewColumn Header="MIME" Width="100" DisplayMemberBinding="{Binding MimeType}"/>
                    <GridViewColumn Header="File id" Width="180" DisplayMemberBinding="{Binding FileId}"/>
                </GridView>
            </ListView.View>
        </ListView>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Download selected" Padding="12,6" Margin="0,0,8,0" Click="Download_Click"/>
            <Button Content="Close" Padding="12,6" IsDefault="True" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</shell:ShellDialogWindow>
