<shell:ShellDialogWindow xmlns:shell="clr-namespace:ChatGPTWrapper.Shell"
                         x:Class="ChatGPTWrapper.Views.KeyboardShortcutsDialog"
                         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                         Title="Keyboard shortcuts"
                         Height="560"
                         Width="640"
                         MinHeight="420"
                         MinWidth="520"
                         WindowStartupLocation="CenterOwner"
                         Background="{DynamicResource BgBaseBrush}"
                         Foreground="{DynamicResource TextPrimaryBrush}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <Style x:Key="ShortcutChordButtonStyle" TargetType="Button" BasedOn="{StaticResource ShellCommandBarSecondarySlot}">
            <Setter Property="MinWidth" Value="148"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>
        <DataTemplate x:Key="ShortcutRowTemplate">
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding DisplayName}" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding StatusMessage}"
                               TextWrapping="Wrap"
                               Margin="0,2,0,0"
                               Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource ShellSectionHintStyle}">
                                <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsErrorStatus}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsWarningStatus}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
                <Button Grid.Column="1"
                        Content="{Binding ChordLabel}"
                        ToolTip="Click to change shortcut"
                        Click="ChordButton_Click"
                        Tag="{Binding}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ShortcutChordButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRecording}" Value="True">
                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}"/>
                                    <Setter Property="BorderThickness" Value="2"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Grid.Column="2"
                        Content="Reset"
                        Margin="8,0,0,0"
                        Style="{StaticResource ShellCommandBarSecondarySlot}"
                        Padding="10,5"
                        VerticalAlignment="Center"
                        Visibility="{Binding IsCustomized, Converter={StaticResource BoolToVisibilityConverter}}"
                        Click="ResetShortcut_Click"
                        Tag="{Binding}"/>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="ShortcutGroupTemplate">
            <Border Style="{StaticResource ShellCardStyle}" Margin="0,0,0,12" Padding="12">
                <StackPanel>
                    <TextBlock Text="{Binding Name}"
                               Style="{StaticResource ShellSectionHeaderStyle}"
                               FontSize="{DynamicResource FontSizeBody}"
                               Margin="0,0,0,10"/>
                    <ItemsControl ItemsSource="{Binding Shortcuts}"
                                  ItemTemplate="{StaticResource ShortcutRowTemplate}"/>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,12">
            <TextBlock Text="Keyboard shortcuts"
                       Style="{StaticResource ShellSectionHeaderStyle}"
                       Margin="0,0,0,4"/>
            <TextBlock Text="Click a chord to assign a new one. Shell shortcuts work when the wrapper has focus. Ctrl+Alt play chords also work while the chat WebView is focused. Browser-owned chords (for example Ctrl+F in the chat page) are not overridden."
                       Style="{StaticResource ShellSectionHintStyle}"
                       TextWrapping="Wrap"/>
            <Border x:Name="RecordingBanner"
                    Margin="0,8,0,0"
                    Padding="10,6"
                    Background="{DynamicResource BgElevatedBrush}"
                    BorderBrush="{DynamicResource AccentPrimaryBrush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource RadiusCard}"
                    Visibility="Collapsed">
                <TextBlock Text="Listening for a new shortcut — press the key combination. Esc cancels."
                           Style="{StaticResource ShellSectionHintStyle}"/>
            </Border>
        </StackPanel>
        <Border Grid.Row="1" Style="{StaticResource ShellCardStyle}" Padding="12">
            <ScrollViewer Style="{StaticResource ShellFormScrollViewerStyle}">
                <ItemsControl x:Name="ShortcutGroups"
                              ItemTemplate="{StaticResource ShortcutGroupTemplate}"/>
            </ScrollViewer>
        </Border>
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button x:Name="ResetAllButton"
                    Content="Reset all"
                    Style="{StaticResource ShellCommandBarSecondarySlot}"
                    Padding="12,6"
                    Margin="0,0,8,0"
                    Click="ResetAll_Click"/>
            <Button Content="Close"
                    Style="{StaticResource ShellCommandBarSecondarySlot}"
                    Padding="12,6"
                    IsCancel="True"/>
        </StackPanel>
    </Grid>
</shell:ShellDialogWindow>
