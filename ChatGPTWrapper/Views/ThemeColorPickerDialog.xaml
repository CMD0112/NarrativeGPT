<shell:ShellDialogWindow xmlns:shell="clr-namespace:ChatGPTWrapper.Shell" x:Class="ChatGPTWrapper.Views.ThemeColorPickerDialog"

        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

        Title="Pick color"

        Width="640"

        MinWidth="560"

        Height="520"

        MinHeight="400"

        WindowStartupLocation="CenterOwner"

        Background="{DynamicResource BgBaseBrush}"

        Foreground="{DynamicResource TextPrimaryBrush}"

        ResizeMode="CanResizeWithGrip"

        SizeToContent="Manual">

    <shell:ShellDialogWindow.Resources>

        <Style x:Key="ColorChannelTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">

            <Setter Property="Padding" Value="4,2"/>

            <Setter Property="MinWidth" Value="40"/>

            <Setter Property="Width" Value="44"/>

            <Setter Property="Height" Value="26"/>

            <Setter Property="VerticalAlignment" Value="Center"/>

            <Setter Property="VerticalContentAlignment" Value="Center"/>

            <Setter Property="HorizontalContentAlignment" Value="Right"/>

            <Setter Property="TextAlignment" Value="Right"/>

            <Setter Property="FontFamily" Value="Consolas"/>

        </Style>

        <Style x:Key="ColorChannelSliderStyle" TargetType="Slider" BasedOn="{StaticResource {x:Type Slider}}">

            <Setter Property="Margin" Value="6,0"/>

            <Setter Property="VerticalAlignment" Value="Center"/>

        </Style>

        <Style x:Key="ColorChannelLabelStyle" TargetType="TextBlock">

            <Setter Property="VerticalAlignment" Value="Center"/>

            <Setter Property="Width" Value="14"/>

            <Setter Property="FontWeight" Value="SemiBold"/>

        </Style>

    </shell:ShellDialogWindow.Resources>

    <Grid>

        <Grid.RowDefinitions>

            <RowDefinition Height="*"/>

            <RowDefinition Height="Auto"/>

        </Grid.RowDefinitions>



        <ScrollViewer x:Name="MainScrollViewer"

                      Grid.Row="0"

                      Style="{StaticResource ShellFormScrollViewerStyle}"

                      VerticalScrollBarVisibility="Auto"

                      HorizontalScrollBarVisibility="Disabled"

                      Padding="16,16,16,8">

            <Border Style="{StaticResource ShellCardStyle}">

                <Grid>

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="Auto"/>

                    </Grid.RowDefinitions>



                    <TextBlock Grid.Row="0"

                               Text="Pick color"

                               Style="{StaticResource ShellSectionHeaderStyle}"

                               Margin="0,0,0,4"/>

                    <TextBlock Grid.Row="1"

                               Text="Drag on the spectrum or fine-tune channels. Expand More tuning for harmonies and shading."

                               Style="{StaticResource ShellSectionHintStyle}"

                               TextWrapping="Wrap"

                               Margin="0,0,0,12"/>



                    <Grid Grid.Row="2" Margin="0,0,0,10">

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="260" MinWidth="220"/>

                            <ColumnDefinition Width="16"/>

                            <ColumnDefinition Width="*" MinWidth="260"/>

                        </Grid.ColumnDefinitions>



                        <StackPanel Grid.Column="0">

                            <Border x:Name="SvPlane"

                                    Height="160"

                                    CornerRadius="{DynamicResource RadiusCard}"

                                    BorderBrush="{DynamicResource BorderStrongBrush}"

                                    BorderThickness="1"

                                    Margin="0,0,0,10"

                                    Cursor="Cross"

                                    MouseLeftButtonDown="SvPlane_MouseLeftButtonDown"

                                    MouseMove="SvPlane_MouseMove"

                                    MouseLeftButtonUp="SvPlane_MouseLeftButtonUp">

                                <Grid>

                                    <Border x:Name="SvHueLayer" CornerRadius="{DynamicResource RadiusCard}"/>

                                    <Border CornerRadius="{DynamicResource RadiusCard}">

                                        <Border.Background>

                                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">

                                                <GradientStop Color="#FFFFFFFF" Offset="0"/>

                                                <GradientStop Color="#00FFFFFF" Offset="1"/>

                                            </LinearGradientBrush>

                                        </Border.Background>

                                    </Border>

                                    <Border CornerRadius="{DynamicResource RadiusCard}">

                                        <Border.Background>

                                            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">

                                                <GradientStop Color="#00000000" Offset="0"/>

                                                <GradientStop Color="#FF000000" Offset="1"/>

                                            </LinearGradientBrush>

                                        </Border.Background>

                                    </Border>

                                    <Canvas x:Name="SvThumbCanvas" IsHitTestVisible="False">

                                        <Ellipse x:Name="SvThumb"

                                                 Width="14"

                                                 Height="14"

                                                 Stroke="{DynamicResource TextPrimaryBrush}"

                                                 StrokeThickness="2"

                                                 Fill="Transparent"/>

                                    </Canvas>

                                </Grid>

                            </Border>



                            <Border Height="14"

                                    CornerRadius="{DynamicResource RadiusControl}"

                                    BorderBrush="{DynamicResource BorderSubtleBrush}"

                                    BorderThickness="1"

                                    Margin="0,0,0,10">

                                <Grid>

                                    <Border CornerRadius="{DynamicResource RadiusControl}">

                                        <Border.Background>

                                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">

                                                <GradientStop Color="#FFFF0000" Offset="0.000"/>

                                                <GradientStop Color="#FFFFFF00" Offset="0.167"/>

                                                <GradientStop Color="#FF00FF00" Offset="0.333"/>

                                                <GradientStop Color="#FF00FFFF" Offset="0.500"/>

                                                <GradientStop Color="#FF0000FF" Offset="0.667"/>

                                                <GradientStop Color="#FFFF00FF" Offset="0.833"/>

                                                <GradientStop Color="#FFFF0000" Offset="1.000"/>

                                            </LinearGradientBrush>

                                        </Border.Background>

                                    </Border>

                                    <Slider x:Name="HueSlider"

                                            Minimum="0"

                                            Maximum="360"

                                            ValueChanged="HueSlider_ValueChanged"

                                            IsMoveToPointEnabled="True"

                                            Margin="0,-4,0,-4"/>

                                </Grid>

                            </Border>



                            <Border Padding="10,8"

                                    CornerRadius="{DynamicResource RadiusControl}"

                                    Background="{DynamicResource BgInsetBrush}"

                                    BorderBrush="{DynamicResource BorderSubtleBrush}"

                                    BorderThickness="1">

                                <Grid>

                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition Width="*"/>

                                        <ColumnDefinition Width="*"/>

                                        <ColumnDefinition Width="*"/>

                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,6,0">

                                        <TextBlock Text="H" Style="{StaticResource ShellSectionHintStyle}" Margin="0,0,0,4"/>

                                        <TextBox x:Name="HueHsvBox"

                                                 Style="{StaticResource ColorChannelTextBoxStyle}"

                                                 MaxLength="3"

                                                 HorizontalAlignment="Stretch"

                                                 TextChanged="HsvBox_TextChanged"

                                                 Tag="HsvH"/>

                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Margin="3,0">

                                        <TextBlock Text="S %" Style="{StaticResource ShellSectionHintStyle}" Margin="0,0,0,4"/>

                                        <TextBox x:Name="SaturationHsvBox"

                                                 Style="{StaticResource ColorChannelTextBoxStyle}"

                                                 MaxLength="3"

                                                 HorizontalAlignment="Stretch"

                                                 TextChanged="HsvBox_TextChanged"

                                                 Tag="HsvS"/>

                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Margin="6,0,0,0">

                                        <TextBlock Text="V %" Style="{StaticResource ShellSectionHintStyle}" Margin="0,0,0,4"/>

                                        <TextBox x:Name="ValueHsvBox"

                                                 Style="{StaticResource ColorChannelTextBoxStyle}"

                                                 MaxLength="3"

                                                 HorizontalAlignment="Stretch"

                                                 TextChanged="HsvBox_TextChanged"

                                                 Tag="HsvV"/>

                                    </StackPanel>

                                </Grid>

                            </Border>

                        </StackPanel>



                        <StackPanel Grid.Column="2">

                            <Border Margin="0,0,0,10"

                                    Padding="10"

                                    CornerRadius="{DynamicResource RadiusControl}"

                                    Background="{DynamicResource BgInsetBrush}"

                                    BorderBrush="{DynamicResource BorderSubtleBrush}"

                                    BorderThickness="1">

                                <Grid>

                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition Width="Auto"/>

                                        <ColumnDefinition Width="Auto"/>

                                        <ColumnDefinition Width="*"/>

                                    </Grid.ColumnDefinitions>

                                    <StackPanel Margin="0,0,10,0">

                                        <TextBlock Text="Color"

                                                   Style="{StaticResource ShellSectionHintStyle}"

                                                   Margin="0,0,0,4"/>

                                        <Border Width="48"

                                                Height="48"

                                                CornerRadius="{DynamicResource RadiusControl}"

                                                BorderBrush="{DynamicResource BorderStrongBrush}"

                                                BorderThickness="1"

                                                Background="{DynamicResource BgBaseBrush}">

                                            <Border x:Name="PreviewSwatch"

                                                    Margin="3"

                                                    CornerRadius="4"

                                                    BorderBrush="{DynamicResource BorderSubtleBrush}"

                                                    BorderThickness="1"/>

                                        </Border>

                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Margin="0,0,12,0">

                                        <TextBlock Text="On background"

                                                   Style="{StaticResource ShellSectionHintStyle}"

                                                   Margin="0,0,0,4"/>

                                        <Border x:Name="PreviewOnBackgroundBorder"

                                                Width="48"

                                                Height="48"

                                                CornerRadius="{DynamicResource RadiusControl}"

                                                BorderBrush="{DynamicResource BorderStrongBrush}"

                                                BorderThickness="1"

                                                ToolTip="How this color reads on the context background">

                                            <TextBlock x:Name="PreviewOnBackgroundText"

                                                       Text="Aa"

                                                       HorizontalAlignment="Center"

                                                       VerticalAlignment="Center"

                                                       FontSize="17"

                                                       FontWeight="SemiBold"/>

                                        </Border>

                                    </StackPanel>

                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">

                                        <TextBlock Text="Hex"

                                                   Style="{StaticResource ShellSectionHintStyle}"

                                                   Margin="0,0,0,4"/>

                                        <Grid>

                                            <Grid.ColumnDefinitions>

                                                <ColumnDefinition Width="*"/>

                                                <ColumnDefinition Width="Auto"/>

                                            </Grid.ColumnDefinitions>

                                            <TextBox x:Name="HexBox"

                                                     FontFamily="Consolas"

                                                     MaxLength="32"

                                                     TextChanged="HexBox_TextChanged"/>

                                            <Button Grid.Column="1"

                                                    Content="Copy"

                                                    Margin="8,0,0,0"

                                                    Padding="8,4"

                                                    Style="{StaticResource ShellCommandBarSecondarySlot}"

                                                    Tag="hex"

                                                    Click="CopyFormatButton_Click"/>

                                        </Grid>

                                        <TextBlock x:Name="NearestColorNameText"

                                                   Style="{StaticResource ShellSectionHintStyle}"

                                                   Margin="0,4,0,0"

                                                   TextWrapping="Wrap"/>

                                    </StackPanel>

                                </Grid>

                            </Border>



                            <Border x:Name="ContrastPanel"

                                    Margin="0,0,0,10"

                                    Padding="10,8"

                                    CornerRadius="{DynamicResource RadiusControl}"

                                    Background="{DynamicResource BgInsetBrush}"

                                    BorderBrush="{DynamicResource BorderSubtleBrush}"

                                    BorderThickness="1">

                                <Grid>

                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition Width="*"/>

                                        <ColumnDefinition Width="Auto"/>

                                    </Grid.ColumnDefinitions>

                                    <TextBlock x:Name="ContrastRatioText"

                                               Style="{StaticResource ShellSectionHintStyle}"

                                               VerticalAlignment="Center"

                                               TextWrapping="Wrap"/>

                                    <Button x:Name="FixContrastButton"

                                            Grid.Column="1"

                                            Content="Fix contrast"

                                            Style="{StaticResource ShellCommandBarSecondarySlot}"

                                            Padding="8,4"

                                            Margin="8,0,0,0"

                                            Click="FixContrastButton_Click"/>

                                </Grid>

                            </Border>



                            <Border Padding="10,8"

                                    CornerRadius="{DynamicResource RadiusControl}"

                                    BorderBrush="{DynamicResource BorderSubtleBrush}"

                                    BorderThickness="1">

                                <Grid>

                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition Width="*"/>

                                        <ColumnDefinition Width="12"/>

                                        <ColumnDefinition Width="*"/>

                                    </Grid.ColumnDefinitions>



                                    <StackPanel Grid.Column="0">

                                        <TextBlock Text="RGB"

                                                   Style="{StaticResource ShellSectionHintStyle}"

                                                   Margin="0,0,0,6"/>

                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="24"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Ellipse Width="8" Height="8" Fill="#FFE57373" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                <TextBlock Text="R" Style="{StaticResource ColorChannelLabelStyle}" Width="Auto"/>
                                            </StackPanel>
                                            <Slider x:Name="RedSlider" Grid.Column="1" Style="{StaticResource ColorChannelSliderStyle}" Minimum="0" Maximum="255" ValueChanged="RgbSlider_ValueChanged"/>
                                            <TextBox x:Name="RedBox" Grid.Column="2" Style="{StaticResource ColorChannelTextBoxStyle}" MaxLength="3" TextChanged="RgbBox_TextChanged" Tag="R"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="24"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Ellipse Width="8" Height="8" Fill="#FF6BCB8E" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                <TextBlock Text="G" Style="{StaticResource ColorChannelLabelStyle}" Width="Auto"/>
                                            </StackPanel>
                                            <Slider x:Name="GreenSlider" Grid.Column="1" Style="{StaticResource ColorChannelSliderStyle}" Minimum="0" Maximum="255" ValueChanged="RgbSlider_ValueChanged"/>
                                            <TextBox x:Name="GreenBox" Grid.Column="2" Style="{StaticResource ColorChannelTextBoxStyle}" MaxLength="3" TextChanged="RgbBox_TextChanged" Tag="G"/>
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="24"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Ellipse Width="8" Height="8" Fill="#FF5B9FD4" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                <TextBlock Text="B" Style="{StaticResource ColorChannelLabelStyle}" Width="Auto"/>
                                            </StackPanel>
                                            <Slider x:Name="BlueSlider" Grid.Column="1" Style="{StaticResource ColorChannelSliderStyle}" Minimum="0" Maximum="255" ValueChanged="RgbSlider_ValueChanged"/>
                                            <TextBox x:Name="BlueBox" Grid.Column="2" Style="{StaticResource ColorChannelTextBoxStyle}" MaxLength="3" TextChanged="RgbBox_TextChanged" Tag="B"/>
                                        </Grid>

                                    </StackPanel>



                                    <StackPanel Grid.Column="2">

                                        <TextBlock Text="HSL"

                                                   Style="{StaticResource ShellSectionHintStyle}"

                                                   Margin="0,0,0,6"/>

                                        <Grid Margin="0,0,0,4">

                                            <Grid.ColumnDefinitions>

                                                <ColumnDefinition Width="14"/>

                                                <ColumnDefinition Width="*"/>

                                                <ColumnDefinition Width="Auto"/>

                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="H" Style="{StaticResource ColorChannelLabelStyle}"/>

                                            <Slider x:Name="HueHslSlider" Grid.Column="1" Style="{StaticResource ColorChannelSliderStyle}" Minimum="0" Maximum="360" ValueChanged="HslSlider_ValueChanged"/>

                                            <TextBox x:Name="HueHslBox" Grid.Column="2" Style="{StaticResource ColorChannelTextBoxStyle}" MaxLength="3" TextChanged="HslBox_TextChanged" Tag="H"/>

                                        </Grid>

                                        <Grid Margin="0,0,0,4">

                                            <Grid.ColumnDefinitions>

                                                <ColumnDefinition Width="14"/>

                                                <ColumnDefinition Width="*"/>

                                                <ColumnDefinition Width="Auto"/>

                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="S" Style="{StaticResource ColorChannelLabelStyle}"/>

                                            <Slider x:Name="SaturationSlider" Grid.Column="1" Style="{StaticResource ColorChannelSliderStyle}" Minimum="0" Maximum="100" ValueChanged="HslSlider_ValueChanged"/>

                                            <TextBox x:Name="SaturationBox" Grid.Column="2" Style="{StaticResource ColorChannelTextBoxStyle}" MaxLength="3" TextChanged="HslBox_TextChanged" Tag="S"/>

                                        </Grid>

                                        <Grid>

                                            <Grid.ColumnDefinitions>

                                                <ColumnDefinition Width="14"/>

                                                <ColumnDefinition Width="*"/>

                                                <ColumnDefinition Width="Auto"/>

                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="L" Style="{StaticResource ColorChannelLabelStyle}"/>

                                            <Slider x:Name="LightnessSlider" Grid.Column="1" Style="{StaticResource ColorChannelSliderStyle}" Minimum="0" Maximum="100" ValueChanged="HslSlider_ValueChanged"/>

                                            <TextBox x:Name="LightnessBox" Grid.Column="2" Style="{StaticResource ColorChannelTextBoxStyle}" MaxLength="3" TextChanged="HslBox_TextChanged" Tag="L"/>

                                        </Grid>

                                    </StackPanel>

                                </Grid>

                            </Border>

                        </StackPanel>

                    </Grid>



                    <StackPanel x:Name="HelpersSection" Grid.Row="3" Margin="0,0,0,10">

                        <TextBlock Text="Quick helpers"

                                   Style="{StaticResource ShellSectionHintStyle}"

                                   Margin="0,0,0,4"/>

                        <TextBlock x:Name="HelpersHintText"

                                   Style="{StaticResource ShellSectionHintStyle}"

                                   TextWrapping="Wrap"

                                   Margin="0,0,0,6"/>

                        <WrapPanel x:Name="HelpersWrapPanel"/>

                    </StackPanel>



                    <StackPanel x:Name="RecentColorsPanel" Grid.Row="4" Margin="0,0,0,10">

                        <TextBlock Text="Recent"

                                   Style="{StaticResource ShellSectionHintStyle}"

                                   Margin="0,0,0,4"/>

                        <WrapPanel x:Name="RecentColorsWrapPanel"/>

                    </StackPanel>



                    <Expander x:Name="MoreTuningExpander"

                              Grid.Row="5"

                              Header="More tuning"

                              IsExpanded="False"

                              Expanded="MoreTuningExpander_Expanded"

                              Collapsed="MoreTuningExpander_Collapsed">

                        <ScrollViewer Style="{StaticResource ShellTabScrollViewerStyle}"

                                      VerticalScrollBarVisibility="Auto"

                                      MaxHeight="280">

                            <StackPanel>

                                <TextBlock Text="Formats"

                                           Style="{StaticResource ShellSectionHintStyle}"

                                           Margin="0,0,0,4"/>

                                <Grid Margin="0,0,0,4">

                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition Width="*"/>

                                        <ColumnDefinition Width="Auto"/>

                                    </Grid.ColumnDefinitions>

                                    <TextBox x:Name="RgbFormatBox" IsReadOnly="True" FontFamily="Consolas" Margin="0,0,8,0"/>

                                    <Button Grid.Column="1" Content="Copy" Style="{StaticResource ShellCommandBarSecondarySlot}" Padding="8,4" Tag="rgb" Click="CopyFormatButton_Click"/>

                                </Grid>

                                <Grid Margin="0,0,0,4">

                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition Width="*"/>

                                        <ColumnDefinition Width="Auto"/>

                                    </Grid.ColumnDefinitions>

                                    <TextBox x:Name="HslFormatBox" IsReadOnly="True" FontFamily="Consolas" Margin="0,0,8,0"/>

                                    <Button Grid.Column="1" Content="Copy" Style="{StaticResource ShellCommandBarSecondarySlot}" Padding="8,4" Tag="hsl" Click="CopyFormatButton_Click"/>

                                </Grid>

                                <Grid Margin="0,0,0,12">

                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition Width="*"/>

                                        <ColumnDefinition Width="Auto"/>

                                    </Grid.ColumnDefinitions>

                                    <TextBox x:Name="HsvFormatBox" IsReadOnly="True" FontFamily="Consolas" Margin="0,0,8,0"/>

                                    <Button Grid.Column="1" Content="Copy" Style="{StaticResource ShellCommandBarSecondarySlot}" Padding="8,4" Tag="hsv" Click="CopyFormatButton_Click"/>

                                </Grid>



                                <TextBlock Text="Harmonies"

                                           Style="{StaticResource ShellSectionHintStyle}"

                                           Margin="0,0,0,4"/>

                                <TextBlock Text="Analogous"

                                           Style="{StaticResource ShellSectionHintStyle}"

                                           Margin="0,0,0,4"

                                           Opacity="0.85"/>

                                <WrapPanel x:Name="HarmonyAnalogousPanel" Margin="0,0,0,8"/>

                                <TextBlock Text="Complement"

                                           Style="{StaticResource ShellSectionHintStyle}"

                                           Margin="0,0,0,4"

                                           Opacity="0.85"/>

                                <WrapPanel x:Name="HarmonyComplementPanel" Margin="0,0,0,8"/>

                                <TextBlock Text="Triad"

                                           Style="{StaticResource ShellSectionHintStyle}"

                                           Margin="0,0,0,4"

                                           Opacity="0.85"/>

                                <WrapPanel x:Name="HarmonyTriadPanel" Margin="0,0,0,12"/>



                                <TextBlock Text="Shading (lightness × saturation)"

                                           Style="{StaticResource ShellSectionHintStyle}"

                                           Margin="0,0,0,6"/>

                                <Border Padding="6"

                                        CornerRadius="{DynamicResource RadiusControl}"

                                        Background="{DynamicResource BgInsetBrush}"

                                        BorderBrush="{DynamicResource BorderSubtleBrush}"

                                        BorderThickness="1"

                                        HorizontalAlignment="Left">

                                    <UniformGrid x:Name="ShadingGrid"

                                                 Rows="5"

                                                 Columns="5"/>

                                </Border>

                            </StackPanel>

                        </ScrollViewer>

                    </Expander>

                </Grid>

            </Border>

        </ScrollViewer>



        <Border Grid.Row="1"

                Padding="16,10,16,16"

                BorderBrush="{DynamicResource BorderSubtleBrush}"

                BorderThickness="0,1,0,0"

                Background="{DynamicResource BgBaseBrush}">

            <StackPanel Orientation="Horizontal"

                        HorizontalAlignment="Right">

                <Button Content="Cancel"

                        Style="{StaticResource ShellCommandBarSecondarySlot}"

                        Padding="12,6"

                        Margin="0,0,8,0"

                        IsCancel="True"/>

                <Button Content="OK"

                        Style="{StaticResource ShellCommandBarPrimarySlot}"

                        Padding="12,6"

                        IsDefault="True"

                        Click="Ok_Click"/>

            </StackPanel>

        </Border>

    </Grid>

</shell:ShellDialogWindow>

