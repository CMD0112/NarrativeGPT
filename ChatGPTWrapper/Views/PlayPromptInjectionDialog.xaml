                                                                               FontSize="{DynamicResource FontSizeHint}"
                                                                               Foreground="{DynamicResource TextMutedBrush}"
                                                                               Margin="4,10,0,4"/>
                                                                    <ItemsPresenter/>
                                                                </StackPanel>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </GroupStyle.ContainerStyle>
                                        </GroupStyle>
                                    </ListBox.GroupStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="2,4">
                                                <TextBlock Text="{Binding DisplayLabel}"
