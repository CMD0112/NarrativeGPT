<shell:ShellDialogWindow xmlns:shell="clr-namespace:ChatGPTWrapper.Shell" x:Class="ChatGPTWrapper.Views.PlayPromptInjectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Play settings"
        Height="760"
        Width="920"
        MinHeight="520"
        MinWidth="640"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBaseBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        xmlns:local="clr-namespace:ChatGPTWrapper.Views"
        xmlns:services="clr-namespace:ChatGPTWrapper.Adventure.Services">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Tabs follow scope: this send → world state → utility jobs → layout &amp; contract → session threads. Packet overrides also live in the play cockpit. Project instructions and sources are separate channels (Sources tab)."
                   TextWrapping="Wrap"
                   Foreground="{StaticResource TextMutedBrush}"
                   FontSize="11"
                   Margin="0,0,0,12"/>

        <Grid Grid.Row="1" MinHeight="360">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="300"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="400" MinWidth="320"/>
            </Grid.ColumnDefinitions>

        <TabControl x:Name="SettingsTabControl" Grid.Column="0" Background="{StaticResource BgSurfaceBrush}">
            <TabItem x:Name="InjectionTab" Header="Injection">
                <ScrollViewer Style="{StaticResource ShellTabScrollViewerStyle}">
                    <StackPanel>
                        <TextBlock TextWrapping="Wrap" Style="{StaticResource ShellSectionHintStyle}" Margin="0,0,0,12"
                                   Text="Controls which packet sections are included on the next Send and narrator behavior overrides (scope, pacing, violence, etc.). The live preview on the right reflects unsaved edits from this tab, World, Behavior, Play packet, and Memory &amp; cards. Click Save or OK to write changes to disk — until then, Send uses the last saved settings on disk, not this preview."/>

                        <GroupBox Header="Preset &amp; budget" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Injection preset" Margin="0,0,0,4"/>
                                <ComboBox x:Name="InjectionPresetCombo" Margin="0,0,0,4"
                                          HorizontalAlignment="Stretch"
                                          SelectionChanged="InjectionPolicy_Changed"/>
                                <TextBlock x:Name="InjectionPresetHint" TextWrapping="Wrap"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           FontSize="11" Margin="0,0,0,10"/>
                                <TextBlock Text="Max packet characters" Margin="0,0,0,4"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="72"/>
                                    </Grid.ColumnDefinitions>
                                    <Slider x:Name="MaxPacketSlider" Minimum="4000" Maximum="50000" TickFrequency="2000"
                                            IsSnapToTickEnabled="True" ValueChanged="MaxPacketSlider_ValueChanged"/>
                                    <TextBox x:Name="MaxPacketSliderBox" Grid.Column="1" Margin="8,0,0,0"
                                             HorizontalContentAlignment="Right"
                                             LostFocus="MaxPacketSliderBox_LostFocus"/>
                                </Grid>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Sections to include" Margin="0,0,0,12">
                            <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <CheckBox x:Name="IncludeSummaryCheck" Grid.Row="0" Grid.Column="0"
                                          Content="Story so far" Margin="0,0,8,6"
                                          Checked="InjectionPolicy_Changed" Unchecked="InjectionPolicy_Changed"/>
                                <CheckBox x:Name="IncludeStateCheck" Grid.Row="0" Grid.Column="1"
                                          Content="Current state" Margin="0,0,0,6"
                                          Checked="InjectionPolicy_Changed" Unchecked="InjectionPolicy_Changed"/>
                                <CheckBox x:Name="IncludeMemoryCheck" Grid.Row="1" Grid.Column="0"
                                          Content="Pinned memory" Margin="0,0,8,6"
                                          Checked="InjectionPolicy_Changed" Unchecked="InjectionPolicy_Changed"/>
                                <CheckBox x:Name="IncludeTranscriptCheck" Grid.Row="1" Grid.Column="1"
                                          Content="Recent transcript" Margin="0,0,0,6"
                                          Checked="InjectionPolicy_Changed" Unchecked="InjectionPolicy_Changed"/>
                                <CheckBox x:Name="IncludeCardsCheck" Grid.Row="2" Grid.Column="0"
                                          Content="Lore cards" Margin="0,0,8,6"
                                          Checked="InjectionPolicy_Changed" Unchecked="InjectionPolicy_Changed"/>
                                <CheckBox x:Name="IncludeSourcesCheck" Grid.Row="2" Grid.Column="1"
                                          Content="Source pointers (thin)" Margin="0,0,0,6"
                                          Checked="InjectionPolicy_Changed" Unchecked="InjectionPolicy_Changed"/>
                                <CheckBox x:Name="InjectAttachmentGuidanceInjectionCheck" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                                          Content="Attachment guidance" Margin="0,0,0,4"
                                          Checked="InjectAttachmentGuidance_Changed" Unchecked="InjectAttachmentGuidance_Changed"/>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="Transcript max turns (0 = preset default):" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox x:Name="TranscriptMaxTurnsBox" Width="48" LostFocus="InjectionPolicy_Changed"/>
                            </StackPanel>
                            </StackPanel>
                        </GroupBox>

                        <Expander Header="Formatting" IsExpanded="False">
                            <StackPanel Margin="0,8,0,0">
                                <CheckBox x:Name="UseContextTagsCheck" Content="Use context tags ([[cgw:…]])"
                                          Margin="0,0,0,4" Checked="InjectionPolicy_Changed" Unchecked="InjectionPolicy_Changed"/>
                                <CheckBox x:Name="UseSectionInjectionCheck" Content="Section injection v2 (pointers)"
                                          Margin="0,0,0,4" Checked="InjectionPolicy_Changed" Unchecked="InjectionPolicy_Changed"/>
                            </StackPanel>
                        </Expander>

                        <GroupBox Header="Narrator behavior" Margin="0,12,0,0">
                            <local:NarratorBehaviorPanel x:Name="InjectionNarratorPanel" ScopeGroupName="NarratorScopePlaySettings"
                                                         SettingsChanged="InjectionNarratorPanel_SettingsChanged"/>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem x:Name="NextSendTab" Header="Next send">
                <ScrollViewer Style="{StaticResource ShellTabScrollViewerStyle}">
                    <StackPanel>
                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="11" Margin="0,0,0,10"
                                   Text="Send precedence: 1) in-page composer (Play mode), 2) fallback player line below, 3) first line of continuation queue (consumed on Send)."/>
                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="11" Margin="0,0,0,10"
                                   Text="Repair: if a turn reached ChatGPT without injected context, copy a repair packet and paste it into a user-message edit on the play thread."/>
                        <TextBlock Text="Continuation queue (one line per queued player input)" Margin="0,0,0,4"/>
                        <TextBox x:Name="QueueBox" MinHeight="64" AcceptsReturn="True" TextWrapping="Wrap"
                                 Margin="0,0,0,12" TextChanged="QueueBox_TextChanged" LostFocus="QueueBox_LostFocus"/>
                        <TextBlock Text="Fallback player line" Margin="0,0,0,4"/>
                        <TextBox x:Name="PreviewPlayerLineBox" MinHeight="32" AcceptsReturn="True"
                                 TextWrapping="Wrap" Margin="0,0,0,8" TextChanged="PreviewPlayerLineBox_TextChanged"
                                 LostFocus="PreviewPlayerLineBox_LostFocus"/>
                        <TextBlock Text="Next-send overrides (injected once per packet)" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <WrapPanel Margin="0,0,0,8">
                            <TextBlock Text="Response length:" VerticalAlignment="Center" Margin="0,0,8,4"/>
                            <ComboBox x:Name="TurnOverrideResponseLengthCombo" Width="120" Margin="0,0,12,4"
                                      SelectionChanged="TurnOverrideSettings_Changed"/>
                            <TextBlock Text="Detail level:" VerticalAlignment="Center" Margin="0,0,8,4"/>
                            <ComboBox x:Name="TurnOverrideDetailLevelCombo" Width="120" Margin="0,0,12,4"
                                      SelectionChanged="TurnOverrideSettings_Changed"/>
                            <TextBlock Text="Tone:" VerticalAlignment="Center" Margin="0,0,8,4"/>
                            <ComboBox x:Name="TurnOverrideToneCombo" Width="120" Margin="0,0,12,4" IsEditable="True"
                                      SelectionChanged="TurnOverrideSettings_Changed" LostFocus="TurnOverrideSettings_Changed"/>
                            <TextBlock Text="Difficulty:" VerticalAlignment="Center" Margin="0,0,8,4"/>
                            <ComboBox x:Name="TurnOverrideDifficultyCombo" Width="120" Margin="0,0,12,4" IsEditable="True"
                                      SelectionChanged="TurnOverrideSettings_Changed" LostFocus="TurnOverrideSettings_Changed"/>
                            <Button Content="Reset overrides" Padding="8,4" Margin="0,0,0,4"
                                    Click="ResetTurnOverrides_Click"/>
                        </WrapPanel>
                        <TextBlock Text="Packet preview (read-only)" Margin="0,0,0,4"
                                   Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                        <TextBlock Text="Packet only — does not change Project instructions or sources."
                                   FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,6"/>
                        <TextBlock x:Name="PacketMetaLine" TextWrapping="Wrap"
                                   Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,0,0,6"/>
                        <TextBlock x:Name="SectionManifestLine" TextWrapping="Wrap"
                                   Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,0,0,6"/>
                        <TextBox x:Name="MergedPreviewBox" IsReadOnly="True" AcceptsReturn="True"
                                 TextWrapping="Wrap" VerticalScrollBarVisibility="Disabled" FontFamily="Consolas"
                                 MinHeight="160" Margin="0,0,0,8"/>
                        <WrapPanel>
                            <Button Content="Refresh preview" Padding="10,5" Margin="0,0,8,4" Click="RefreshPreview_Click"/>
                            <Button Content="Copy packet" Padding="10,5" Margin="0,0,8,4" Click="CopyPacket_Click"/>
                            <Button x:Name="CopyRepairPacketButton" Content="Copy packet for edit repair" Padding="10,5"
                                    Margin="0,0,8,4" Click="CopyRepairPacket_Click"/>
                            <Button Content="View full…" Padding="10,5" Margin="0,0,8,4" Click="ViewFull_Click"/>
                            <Button x:Name="PreviewNarrativePacketButton" Content="Preview narrative start packet" Padding="10,5"
                                    Margin="0,0,8,4" Click="PreviewNarrativePacket_Click"/>
                            <Button x:Name="CopyNarrativePacketButton" Content="Copy narrative start packet" Padding="10,5"
                                    Margin="0,0,8,4" Click="CopyNarrativePacket_Click"/>
                            <Button x:Name="PreviewHandoffPacketButton" Content="Preview handoff packet" Padding="10,5"
                                    Margin="0,0,8,4" Click="PreviewHandoffPacket_Click" Visibility="Collapsed"/>
                            <Button x:Name="CopyHandoffPacketButton" Content="Copy handoff packet" Padding="10,5"
                                    Margin="0,0,8,4" Click="CopyHandoffPacket_Click" Visibility="Collapsed"/>
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem x:Name="WorldTab" Header="World">
                <ScrollViewer Style="{StaticResource ShellTabScrollViewerStyle}">
                    <StackPanel>
                        <TextBlock Text="Fields merged into prompt packets on Send." Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="11" Margin="0,0,0,10"/>
                        <StackPanel x:Name="SummaryReviewPanel" Margin="0,0,0,12" Visibility="Collapsed">
                            <TextBlock Text="Proposed rolling summary" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBlock Text="From your last digest job — accept to replace the rolling summary below."
                                       Foreground="{StaticResource TextMutedBrush}"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,8"/>
                            <TextBox x:Name="ProposedSummaryBox" AcceptsReturn="True" MinHeight="64" TextWrapping="Wrap"
                                     Margin="0,0,0,8"/>
                            <WrapPanel>
                                <Button Content="Accept (Y)" Padding="8,4" Margin="0,0,6,0" Click="AcceptSummary_Click"/>
                                <Button Content="Dismiss (N)" Padding="8,4" Margin="0,0,6,0" Click="DismissSummary_Click"/>
                                <Button Content="Review all…" Padding="8,4" Tag="{x:Static services:ProposalReviewCategory.Summary}" Click="ReviewAllProposals_Click"/>
                            </WrapPanel>
                        </StackPanel>
                        <WrapPanel Margin="0,0,0,8">
                            <Button Content="Refresh summary (AI)" Padding="8,4" Margin="0,0,6,0"
                                    Click="RefreshSummaryAi_Click"/>
                        </WrapPanel>
                        <TextBlock Text="Rolling summary" Margin="0,0,0,4"/>
                        <TextBox x:Name="SummaryBox" AcceptsReturn="True" MinHeight="96" TextWrapping="Wrap" Margin="0,0,0,10"
                                 TextChanged="InjectionAffectingText_Changed"/>
                        <TextBlock Text="Location" Margin="0,0,0,4"/>
                        <TextBox x:Name="LocationBox" Margin="0,0,0,10" TextChanged="InjectionAffectingText_Changed"/>
                        <TextBlock Text="Objectives" Margin="0,0,0,4"/>
                        <TextBox x:Name="ObjectivesBox" AcceptsReturn="True" MinHeight="64" TextWrapping="Wrap" Margin="0,0,0,10"
                                 TextChanged="InjectionAffectingText_Changed"/>
                        <TextBlock Text="Author's note (style only)" Margin="0,0,0,4"/>
                        <TextBox x:Name="AuthorsNoteBox" AcceptsReturn="True" MinHeight="64" TextWrapping="Wrap"
                                 TextChanged="InjectionAffectingText_Changed"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem x:Name="AiActionsTab" Header="Utility jobs">
                <ScrollViewer Style="{StaticResource ShellTabScrollViewerStyle}">
                    <StackPanel Margin="8">
                        <TextBlock Style="{StaticResource ShellSectionHintStyle}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,12"
                                   Text="Utility jobs propose structured changes across canon profile, play state, session, and narrative layers — always for review before they affect your adventure. ChatGPT is the production engine; routing controls where jobs run."/>

                        <Border Style="{StaticResource ShellCardStyle}" Margin="0,0,0,12" Padding="12">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="Review pipeline" Style="{StaticResource ShellSectionHeaderStyle}" FontSize="{DynamicResource FontSizeSection}"/>
                                    <Border Style="{StaticResource ShellBadgeStyle}" Margin="8,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Proposals" FontSize="10"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Style="{StaticResource ShellSectionHintStyle}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,8"
                                           Text="Accept or dismiss proposals by layer. Each layer routes to a different review surface after you run a job."/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource ShellSectionHintStyle}" Text="Canon profile → entity creates/updates" Margin="0,0,8,2"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource ShellSectionHintStyle}" Text="Play state → entity internal state patches" Margin="0,0,0,2"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource ShellSectionHintStyle}" Text="Canon evolution → profile promotions" Margin="0,0,8,2"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource ShellSectionHintStyle}" Text="Session → location, objectives, flags" Margin="0,0,0,2"/>
                                    <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource ShellSectionHintStyle}" Text="Narrative → memories, story digest, continuity warnings" Margin="0,0,0,0"/>
                                </Grid>
                                <TextBlock Style="{StaticResource ShellSectionHintStyle}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,8"
                                           Text="Pending proposals appear on the Review chip in the session bar. Run utility jobs below, then open Review to accept or dismiss."/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource ShellCardStyle}" Margin="0,0,0,12" Padding="12">
                            <StackPanel>
                                <TextBlock Text="Post-turn automation" Style="{StaticResource ShellSectionHeaderStyle}" FontSize="{DynamicResource FontSizeSection}" Margin="0,0,0,4"/>
                                <TextBlock Style="{StaticResource ShellSectionHintStyle}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,8"
                                           Text="Optional jobs queued when you accept a play turn. Grouped by the layer they update. Requires WebView automation and a linked ChatGPT Project."/>
                                <CheckBox x:Name="AutomationCheck"
                                          Content="Enable WebView automation (required for post-turn jobs)"
                                          Margin="0,0,0,12"/>

                                <TextBlock Text="Narrative" FontWeight="SemiBold" Margin="0,0,0,2"/>
                                <TextBlock x:Name="NarrativeLayerHint"
                                           Style="{StaticResource ShellSectionHintStyle}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,6"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <CheckBox x:Name="AutoProposeMemoriesCheck" Grid.Row="0" Grid.Column="0"
                                              Content="Memories" Margin="0,0,8,6"/>
                                    <CheckBox x:Name="AutoUpdateSummaryCheck" Grid.Row="0" Grid.Column="1"
                                              Content="Story digest" Margin="0,0,0,6"/>
                                    <CheckBox x:Name="AutoContinuityCheckCheck" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                              Content="Continuity check" Margin="0,0,0,6"/>
                                </Grid>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="Digest interval (turns)"
                                               VerticalAlignment="Center"
                                               Margin="0,0,12,0"/>
                                    <TextBox Grid.Column="1"
                                             x:Name="SummaryIntervalBox"
                                             Width="80"
                                             MinWidth="80"
                                             Padding="6,4"
                                             HorizontalContentAlignment="Right"
                                             VerticalAlignment="Center"
                                             LostFocus="PlaySettingsInputs_Changed"/>
                                    <TextBlock Grid.Column="2"
                                               Text="default: 5 — narrative layer only"
                                               Style="{StaticResource ShellSectionHintStyle}"
                                               VerticalAlignment="Center"
                                               Margin="12,0,0,0"/>
                                </Grid>

                                <TextBlock Text="Session" FontWeight="SemiBold" Margin="0,0,0,2"/>
                                <TextBlock x:Name="SessionLayerHint"
                                           Style="{StaticResource ShellSectionHintStyle}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,6"/>
                                <CheckBox x:Name="AutoUpdateStateCheck"
                                          Content="Session state (location, objectives, flags, time)"
                                          Margin="0,0,0,12"/>

                                <TextBlock Text="Canon profile" FontWeight="SemiBold" Margin="0,0,0,2"/>
                                <TextBlock x:Name="CanonProfileLayerHint"
                                           Style="{StaticResource ShellSectionHintStyle}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,6"/>
                                <CheckBox x:Name="AutoExtractEntitiesCheck"
                                          Content="Extract entities (creates and profile updates)"
                                          Margin="0,0,0,12"/>

                                <TextBlock Text="Play state" FontWeight="SemiBold" Margin="0,0,0,2"/>
                                <TextBlock x:Name="PlayStateLayerHint"
                                           Style="{StaticResource ShellSectionHintStyle}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,6"/>
                                <CheckBox x:Name="AutoProposeEntityStateCheck"
                                          Content="Entity state (disposition, mood, location, etc.)"
                                          Margin="0,0,0,12"/>

                                <TextBlock Text="Canon evolution" FontWeight="SemiBold" Margin="0,0,0,2"/>
                                <TextBlock x:Name="CanonEvolutionLayerHint"
                                           Style="{StaticResource ShellSectionHintStyle}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,6"/>
                                <CheckBox x:Name="AutoProposeCanonEvolutionCheck"
                                          Content="Canon evolution (promote divergences to profile)"
                                          Margin="0,0,0,12"/>

                                <TextBlock Text="Project sync" FontWeight="SemiBold" Margin="0,0,0,2"/>
                                <TextBlock Style="{StaticResource ShellSectionHintStyle}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,6"
                                           Text="Not a utility job — publishes play settings to linked Project instructions when you save."/>
                                <CheckBox x:Name="AutoSyncInstructionsCheck"
                                          Content="Sync project instructions on save"
                                          Margin="0,0,0,8"/>
                                <TextBlock x:Name="AutoExtractEntitiesHint"
                                           Style="{StaticResource ShellSectionHintStyle}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,8"/>
                                <Expander Header="Transcript scope per automation" IsExpanded="False" Margin="0,0,0,4">
                                    <StackPanel Margin="0,8,0,0">
                                        <TextBlock Style="{StaticResource ShellSectionHintStyle}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,6"
                                                   Text="Turn pairs and transcript scope for each post-turn job, grouped by layer (session, narrative, canon profile, play state, canon evolution). Defaults match each job's built-in profile; reset any row to restore them."/>
                                        <DataGrid x:Name="AutomationContextGrid"
                                                  AutoGenerateColumns="False"
                                                  CanUserAddRows="False"
                                                  CanUserDeleteRows="False"
                                                  HeadersVisibility="Column"
                                                  MinHeight="160"
                                                  Margin="0,0,0,6"
                                                  CellEditEnding="AutomationContextGrid_CellEditEnding">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Layer" Binding="{Binding Layer}" IsReadOnly="True" Width="96"/>
                                                <DataGridTextColumn Header="Automation" Binding="{Binding Label}" IsReadOnly="True" Width="*"/>
                                                <DataGridTextColumn Header="Turn pairs" Binding="{Binding TurnPairs, UpdateSourceTrigger=LostFocus}" Width="72"/>
                                                <DataGridTextColumn Header="Default turns" Binding="{Binding DefaultTurnPairs}" IsReadOnly="True" Width="84"/>
                                                <DataGridTemplateColumn Header="Transcript scope" Width="180">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <ComboBox ItemsSource="{Binding ScopeChoices}"
                                                                      SelectedValue="{Binding Scope, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                      SelectedValuePath="Anchor"
                                                                      DisplayMemberPath="Label"
                                                                      SelectionChanged="AutomationContextLookback_SelectionChanged"/>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTextColumn Header="Default scope" Binding="{Binding DefaultScopeLabel}" IsReadOnly="True" Width="*"/>
                                                <DataGridTemplateColumn Header="" Width="72">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Button Content="Reset" Padding="6,2" Tag="{Binding JobId}" Click="ResetAutomationContextRow_Click"/>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                        <Button Content="Reset all automation context"
                                                Style="{StaticResource ShellCommandBarSecondarySlot}"
                                                HorizontalAlignment="Left"
                                                Click="ResetAllAutomationContext_Click"/>
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource ShellCardStyle}" Margin="0,0,0,12" Padding="12">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="Delivery &amp; routing" Style="{StaticResource ShellSectionHeaderStyle}" FontSize="{DynamicResource FontSizeSection}"/>
                                    <Border Style="{StaticResource ShellBadgeStyle}" Margin="8,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="ChatGPT" FontSize="10"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Style="{StaticResource ShellSectionHintStyle}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,8"
                                           Text="How post-turn utility jobs reach ChatGPT — ephemeral worker chats, play-thread injection, or a pinned utility thread. Canon profile file revision always uses ephemeral source I/O."/>

                                <TextBlock Text="Worker lane" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <Border Background="{DynamicResource BgElevatedBrush}"
                                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{DynamicResource RadiusControl}"
                                        Padding="8"
                                        Margin="0,0,0,10">
                                    <TextBlock x:Name="UtilityWorkerStatusLine"
                                               Style="{StaticResource ShellSectionHintStyle}"
                                               TextWrapping="Wrap"/>
                                </Border>
                                <CheckBox x:Name="UseEphemeralUtilityWorkerChatCheck"
                                          Content="Ephemeral Project chat per job (recommended)"
                                          Margin="0,0,0,6"
                                          ToolTip="Create → send → capture → delete a short-lived Project chat per job. File revision always uses this lane; enable here to route other utility jobs the same way instead of a pinned worker thread."
                                          Checked="UtilityDeliverySettings_Changed" Unchecked="UtilityDeliverySettings_Changed"/>
                                <StackPanel x:Name="MaxParallelUtilityWorkerJobsPanel" Margin="0,0,0,12">
