                                              Checked="UtilityDeliverySettings_Changed" Unchecked="UtilityDeliverySettings_Changed"/>
                                </StackPanel>
                            </Expander>
                        </Border>

                        <TextBlock Text="Job catalog" Style="{StaticResource ShellSectionHeaderStyle}" FontSize="{DynamicResource FontSizeSection}" Margin="0,0,0,4"/>
