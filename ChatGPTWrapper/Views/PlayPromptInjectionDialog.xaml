                            <Button x:Name="ThreadSnapshotSaveNowButton" Content="Save thread snapshot now" Padding="8,4" Margin="0,0,6,6"
                                    Click="ThreadSnapshotSaveNow_Click"/>
                            <Button x:Name="ThreadSnapshotSyncLogButton" Content="Sync thread log" Padding="8,4" Margin="0,0,6,6"
                                    Click="ThreadSnapshotSyncLog_Click"/>
                            <Button x:Name="ThreadSnapshotDumpLogButton" Content="Dump thread log" Padding="8,4" Margin="0,0,6,6"
                                    Click="ThreadSnapshotDumpLog_Click"/>
                        </WrapPanel>
                        <Expander Header="Utility parse archive (debug)" Margin="0,0,0,8">
                            <StackPanel Margin="8,4,0,0">
                                <TextBox x:Name="UtilityParseLogBox" IsReadOnly="True" AcceptsReturn="True"
                                         TextWrapping="Wrap" Height="120" FontFamily="Consolas" FontSize="11"/>
                                <Button Content="Refresh log" Padding="8,4" Margin="0,6,0,0" HorizontalAlignment="Left"
                                        Click="RefreshUtilityParseLog_Click"/>
                            </StackPanel>
                        </Expander>
                        <TextBlock x:Name="SourcesStatusBlock" Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="{StaticResource FontSizeHint}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <TextBlock Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap"
                                   Margin="0,0,0,8"
                                   Text="Utility job automation and delivery settings are on the Utility jobs tab. Thread visibility toggles also appear in Manage threads."/>
                        <Button Content="Open Sources tab…" Padding="10,5" HorizontalAlignment="Left"
                                Click="GoToSourcesTab_Click"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem x:Name="PlaySurfaceTab" Header="Play surface">
                <ScrollViewer Margin="8" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Attachments &amp; packet context" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <TextBlock Text="Attachment context mode" Margin="0,0,0,4"/>
                        <ComboBox x:Name="AttachmentContextModeCombo" Margin="0,0,0,8" SelectionChanged="PlaySurfaceSettings_Changed"/>
                        <TextBlock Text="Attachment-only placeholder" Margin="0,0,0,4"/>
                        <TextBox x:Name="AttachmentOnlyPlaceholderBox" Margin="0,0,0,8" LostFocus="PlaySurfaceSettings_Changed"/>
                        <CheckBox x:Name="InjectAttachmentGuidanceCheck" Content="Inject attachment guidance in play packets"
                                  Margin="0,0,0,12" Checked="PlaySurfaceSettings_Changed" Unchecked="PlaySurfaceSettings_Changed"/>

                        <TextBlock Text="Play surface quick actions" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBlock Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6"
                                   Text="Continue: with the wrapper composer, Hidden/InjectedOnly shows a Continue button in the compose bar. InjectedOnly also allows empty Send (injects [[cgw:action]]). Regenerate and Retry target native message actions — not available in the wrapper composer yet."/>
                        <DataGrid x:Name="PlaySurfaceActionsGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                                  HeadersVisibility="Column" MinHeight="100" Margin="0,0,0,12"
                                  CellEditEnding="PlaySurfaceActionsGrid_CellEditEnding">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Action" Binding="{Binding ActionKey}" Width="*" IsReadOnly="True"/>
                                <DataGridComboBoxColumn Header="Mode" Width="140"
                                                        SelectedItemBinding="{Binding Mode, UpdateSourceTrigger=PropertyChanged}">
                                    <DataGridComboBoxColumn.ElementStyle>
                                        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                                            <Setter Property="ItemsSource" Value="{Binding ModeOptions}"/>
                                        </Style>
                                    </DataGridComboBoxColumn.ElementStyle>
                                    <DataGridComboBoxColumn.EditingElementStyle>
                                        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                                            <Setter Property="ItemsSource" Value="{Binding ModeOptions}"/>
                                        </Style>
                                    </DataGridComboBoxColumn.EditingElementStyle>
                                </DataGridComboBoxColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Text="Side panel layout" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBlock Text="Layout preset" Margin="0,0,0,4"/>
                        <ComboBox x:Name="PlayLayoutPresetCombo" Margin="0,0,0,8" SelectionChanged="PlayLayoutPresetCombo_SelectionChanged"/>
                        <TextBlock Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6"
                                   Text="Place companion tabs on the left, right, or hide them. Player notes stay in the right panel (visible or hidden). Applying a preset updates tab placement and optional collapse defaults."/>
                        <DataGrid x:Name="PlayTabPlacementGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                                  HeadersVisibility="Column" MinHeight="80" Margin="0,0,0,4"
                                  CellEditEnding="PlayTabPlacementGrid_CellEditEnding">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Tab" Binding="{Binding TabName}" Width="*" IsReadOnly="True"/>
                                <DataGridComboBoxColumn Header="Placement" Width="140"
                                                        SelectedItemBinding="{Binding Placement, UpdateSourceTrigger=PropertyChanged}">
                                    <DataGridComboBoxColumn.ElementStyle>
                                        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                                            <Setter Property="ItemsSource" Value="{Binding PlacementOptions}"/>
                                        </Style>
                                    </DataGridComboBoxColumn.ElementStyle>
                                    <DataGridComboBoxColumn.EditingElementStyle>
                                        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                                            <Setter Property="ItemsSource" Value="{Binding PlacementOptions}"/>
                                        </Style>
                                    </DataGridComboBoxColumn.EditingElementStyle>
                                </DataGridComboBoxColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Text="Cockpit on enter" FontWeight="SemiBold" Margin="0,12,0,4"/>
                        <TextBlock Text="When opening Play for an adventure" Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6"/>
                        <ComboBox x:Name="PlayCompanionOnEnterCombo" Margin="0,0,0,8"
                                  SelectionChanged="PlayChromeSettings_Changed"/>
                        <TextBlock Text="Default companion tab (first visit)" Margin="0,0,0,4"/>
                        <ComboBox x:Name="PlayCompanionDefaultTabCombo" Margin="0,0,0,8"
                                  SelectionChanged="PlayChromeSettings_Changed"/>
                        <CheckBox x:Name="PlayCompanionRememberExpandersCheck"
                                  Content="Remember cockpit section per adventure"
                                  Margin="0,0,0,8"
                                  Checked="PlayChromeSettings_Changed" Unchecked="PlayChromeSettings_Changed"/>

                        <TextBlock Text="Default cockpit section (first visit)" Margin="0,0,0,4"/>
                        <ComboBox x:Name="PlayCompanionDefaultSectionCombo" Margin="0,0,0,8"
                                  SelectionChanged="PlayChromeSettings_Changed"/>

                        <TextBlock Text="Narrator cockpit density" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <ComboBox x:Name="NarratorPanelDensityCombo" Margin="0,0,0,8"
                                  SelectionChanged="PlayChromeSettings_Changed"/>

                        <TextBlock Text="AI tools layout" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBlock Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6"
                                   Text="Action list shows utility jobs in the play cockpit Tools section. Menu only hides the list — use Play settings → Utility jobs to run jobs."/>
                        <ComboBox x:Name="AiToolsLayoutCombo" Margin="0,0,0,4"
                                  SelectionChanged="PlayChromeSettings_Changed"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem x:Name="AdventureSettingsTab" Header="Narrator contract">
                <ScrollViewer Margin="8" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}" FontSize="11"
                                   Margin="0,0,0,12"
                                   Text="Slow channel — copied into ChatGPT Project custom instructions. Play packets use a subset via injection; edit Sources or Design instructions for the full contract."/>
                        <TextBlock Text="Max packet characters" Margin="0,0,0,4"/>
                        <TextBox x:Name="MaxPacketBox" Margin="0,0,0,12" TextChanged="InjectionAffectingText_Changed"/>
                        <Expander x:Name="AdvancedAutomationExpander"
                                  Header="Developer send options"
                                  IsExpanded="False"
                                  Margin="0,0,0,12">
                            <StackPanel Margin="0,8,0,0">
                                <CheckBox x:Name="PreferDomPlaySendCheck"
                                          Content="Prefer DOM composer send (skip conversation API)"
                                          Margin="0,0,0,4"
                                          Visibility="Collapsed"
                                          Checked="PlaySettingsInputs_Changed" Unchecked="PlaySettingsInputs_Changed"/>
                                <TextBlock x:Name="PreferDomPlaySendHint"
                                           Text="Retired — play sends use the conversation API. DOM send bypass was removed in CMD-379."
                                           Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12"
                                           Visibility="Collapsed"/>
                                <CheckBox x:Name="ForceFatPacketsCheck" Content="Force fat packets (ignore thin Project mode)"
                                          Checked="InjectionAffectingCheck_Changed" Unchecked="InjectionAffectingCheck_Changed"/>
                            </StackPanel>
                        </Expander>
                        <TextBlock Text="Perspective" Margin="0,0,0,4"/>
                        <TextBox x:Name="PerspectiveBox" Margin="0,0,0,12" TextChanged="InjectionAffectingText_Changed"/>
                        <TextBlock Text="Global content boundaries (one per line)" Margin="0,0,0,4"/>
                        <TextBox x:Name="BoundariesBox" AcceptsReturn="True" MinHeight="80" TextWrapping="Wrap" Margin="0,0,0,12"
                                 TextChanged="InjectionAffectingText_Changed"/>
                        <TextBlock Text="Character portrayal rules (Subject: rule, one per line)" Margin="0,0,0,4"/>
                        <TextBlock Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap"
                                   Text="Per-character or per-subject narrator limits. Example: Mara: Avoid treating as passive or merely an obstacle."
                                   Margin="0,0,0,4"/>
                        <TextBox x:Name="CharacterPortrayalBox" AcceptsReturn="True" MinHeight="80" TextWrapping="Wrap" Margin="0,0,0,12"
                                 TextChanged="InjectionAffectingText_Changed"/>
                        <TextBlock Text="Instruction addendum (optional)" Margin="0,0,0,4"/>
                        <TextBox x:Name="InstructionAddendumBox" AcceptsReturn="True" MinHeight="56" TextWrapping="Wrap" Margin="0,0,0,4"
                                 TextChanged="InjectionAffectingText_Changed"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem x:Name="MemoryCardsTab" Header="Memory &amp; cards">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="160"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*" MinWidth="160"/>
                    </Grid.ColumnDefinitions>
                    <DockPanel Grid.Column="0">
                        <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                            <WrapPanel Margin="0,0,0,6">
                                <Button Content="Add" Padding="8,4" Margin="0,0,6,0" Click="AddMemory_Click"/>
                                <Button Content="Pin" Padding="8,4" Margin="0,0,6,0" Click="PinMemory_Click"/>
                                <Button Content="Suggest memories (AI)" Padding="8,4" Click="SuggestMemoriesAi_Click"/>
                            </WrapPanel>
                            <Expander x:Name="MemoryReviewExpander" Header="Memory review" Margin="0,0,0,4">
                                <StackPanel Margin="8,4,0,0">
                                    <TextBlock x:Name="MemoryReviewHeader" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,0,0,4"/>
                                    <ListBox x:Name="MemoryReviewList" MinHeight="48" MaxHeight="120" DisplayMemberPath="Text" Margin="0,0,0,4"/>
                                    <WrapPanel>
                                        <Button Content="Accept (Y)" Padding="8,4" Margin="0,0,6,0" Click="AcceptMemoryReview_Click"/>
                                        <Button Content="Dismiss (N)" Padding="8,4" Margin="0,0,6,0" Click="DismissMemoryReview_Click"/>
                                        <Button Content="Review all…" Padding="8,4" Tag="{x:Static services:ProposalReviewCategory.Memory}" Click="ReviewAllProposals_Click"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                            <TextBlock Text="Memory (pinned entries are included in packets)" FontWeight="SemiBold"/>
                        </StackPanel>
                        <ListBox x:Name="MemoryList" DisplayMemberPath="Text"/>
                    </DockPanel>
                    <GridSplitter Grid.Column="1"
                                  Style="{StaticResource SidePanelGridSplitterStyle}"
                                  ResizeBehavior="PreviousAndNext"
                                  ResizeDirection="Columns"
                                  Width="8"/>
                    <DockPanel Grid.Column="2">
                        <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                            <WrapPanel Margin="0,0,0,6">
                                <Button Content="Add card" Padding="8,4" Margin="0,0,6,0" Click="AddCard_Click"/>
                                <Button Content="Generate cards (AI)" Padding="8,4" Margin="0,0,6,0" Click="GenerateCardsAi_Click"/>
                                <Button Content="Expand selected (AI)" Padding="8,4" Click="ExpandCardAi_Click"/>
                            </WrapPanel>
                            <Expander x:Name="CardReviewExpander" Header="Card review" Margin="0,0,0,4">
                                <StackPanel Margin="8,4,0,0">
                                    <TextBlock x:Name="CardReviewHeader" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,0,0,4"/>
                                    <ListBox x:Name="CardReviewList" MinHeight="48" MaxHeight="120" DisplayMemberPath="DisplayLabel" Margin="0,0,0,4"/>
                                    <WrapPanel>
                                        <Button Content="Accept (Y)" Padding="8,4" Margin="0,0,6,0" Click="AcceptCardReview_Click"/>
                                        <Button Content="Dismiss (N)" Padding="8,4" Margin="0,0,6,0" Click="DismissCardReview_Click"/>
                                        <Button Content="Review all…" Padding="8,4" Tag="{x:Static services:ProposalReviewCategory.Card}" Click="ReviewAllProposals_Click"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                            <TextBlock Text="Story cards (keyword-triggered lore in packets)" FontWeight="SemiBold"/>
                        </StackPanel>
                        <ListBox x:Name="CardsList" DisplayMemberPath="Name"/>
                    </DockPanel>
                </Grid>
            </TabItem>
            <TabItem x:Name="SourcesTab" Header="Sources">
                <DockPanel Margin="8" LastChildFill="True">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock x:Name="SourceAutosaveLine" Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6"/>
                        <Border x:Name="ReadinessBanner" Padding="10,8" Margin="0,0,0,8"
                                CornerRadius="{StaticResource RadiusControl}" Background="{StaticResource WarningSubtleBrush}">
                            <TextBlock x:Name="ReadinessBannerText" TextWrapping="Wrap" FontSize="11"/>
                        </Border>
                        <Expander x:Name="SourceWalkthroughExpander" Header="How to publish project sources" IsExpanded="False" Margin="0,0,0,8">
                            <StackPanel Margin="8,4,0,0">
                                <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,0,0,6"
                                           Text="1. Refresh export writes canonical files under your adventure sources folder."/>
                                <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,0,0,6"
                                           Text="2. Copy project instructions into ChatGPT Project → Custom instructions, then mark instructions pasted."/>
                                <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,0,0,6"
                                           Text="3. Drag lore .md files onto ChatGPT Project → Files (or copy from the grid), then check Published for each file."/>
                                <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,0,0,6"
                                           Text="4. Optional: Probe project to compare remote copies before play."/>
                                <TextBlock x:Name="CanonicalPathLine" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                            </StackPanel>
                        </Expander>
                        <TextBlock x:Name="RepublishHintLine" TextWrapping="Wrap" FontSize="11"
                                   Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8"/>
                        <Border Padding="10,8" Margin="0,0,0,8" CornerRadius="{StaticResource RadiusControl}"
                                Background="{StaticResource BgSurfaceBrush}">
                            <StackPanel>
                                <TextBlock Text="Project instructions" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBlock Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6"
                                           Text="Slow channel — paste into ChatGPT Project custom instructions (not play packets). Save play settings before marking pasted if you changed Adventure or World."/>
                                <TextBlock x:Name="InstructionsPastedLine" Foreground="{StaticResource TextMutedBrush}" FontSize="11"
                                           TextWrapping="Wrap" Margin="0,0,0,4"/>
                                <TextBlock x:Name="InstructionDriftLine" Foreground="{StaticResource TextMutedBrush}" FontSize="11"
                                           TextWrapping="Wrap" Margin="0,0,0,8"/>
                                <WrapPanel>
                                    <Button Content="Design instructions…" Padding="10,5" Margin="0,0,8,4" Click="DesignInstructions_Click"/>
                                    <Button Content="Copy instructions" Padding="10,5" Margin="0,0,8,4" Click="CopyInstructions_Click"/>
                                    <Button Content="Preview instructions…" Padding="10,5" Margin="0,0,8,4" Click="PreviewInstructions_Click"/>
                                    <Button Content="Mark instructions pasted" Padding="10,5" Margin="0,0,8,4" Click="MarkInstructionsPasted_Click"/>
                                    <Button x:Name="OpenProjectSettingsButton" Content="Open project settings" Padding="10,5"
                                            Margin="0,0,8,4" Click="OpenProjectSettings_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <Grid MinHeight="220">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="200"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="240" MinWidth="160" MaxWidth="360"/>
                        </Grid.ColumnDefinitions>
                        <GridSplitter Grid.Column="1"
                                      Style="{StaticResource SidePanelGridSplitterStyle}"
                                      ResizeBehavior="PreviousAndNext"
                                      ResizeDirection="Columns"
                                      Width="8"/>
                        <DockPanel Grid.Column="0">
                            <TextBlock DockPanel.Dock="Top" Text="Source files (world canon)" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBlock x:Name="SourcesHintText" DockPanel.Dock="Top" Foreground="{StaticResource TextMutedBrush}" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,0,0,6"/>
                            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                <Button Content="Refresh export" Padding="10,5" Margin="0,0,8,4" Click="RefreshExport_Click"/>
                                <Button Content="Check canon" Padding="10,5" Margin="0,0,8,4" Click="CheckCanon_Click"/>
                                <Button Content="Open folder for drag" Padding="10,5" Margin="0,0,8,4" Click="OpenFolderForDrag_Click"/>
                                <Button Content="Open sources folder" Padding="10,5" Margin="0,0,8,4" Click="OpenSourcesFolder_Click"/>
                                <Button Content="Open history folder" Padding="10,5" Margin="0,0,8,4" Click="OpenHistoryFolder_Click"/>
                                <Button x:Name="ProbeProjectButton" Content="Probe project" Padding="10,5" Margin="0,0,8,4" Click="ProbeProject_Click"/>
                                <Button Content="Mark all published" Padding="10,5" Margin="0,0,8,4" Click="MarkAllPublished_Click"/>
                                <Button Content="Sync sources from JSON" Padding="10,5" Margin="0,0,8,4" Click="SyncSourcesFromJson_Click"
                                        ToolTip="Rewrite local sources/*.md from entities.json and scenario.json (JSON wins)."/>
                                <Button x:Name="EditSourcesAiButton" Content="Edit sources with AI…" Padding="10,5" Margin="0,0,8,4" Click="EditSourcesAi_Click"
                                        Visibility="Collapsed"
                                        ToolTip="Design workspace only — use Design → Utility jobs for canon markdown edits."/>
                                <Button x:Name="ApiSyncDiagnosticsButton" Content="API sync diagnostics…" Padding="10,5" Margin="0,0,8,4"
                                        Click="ApiSyncDiagnostics_Click"/>
                            </WrapPanel>
                            <WrapPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                                <Button Content="Open selected" Padding="8,4" Margin="0,0,6,4" Click="OpenSelectedSource_Click"/>
                                <Button Content="Copy selected" Padding="8,4" Margin="0,0,6,4" Click="CopySourceFile_Click"/>
                                <Button Content="Preview selected…" Padding="8,4" Margin="0,0,6,4" Click="PreviewSourceFile_Click"/>
                                <Button Content="Mark selected published" Padding="8,4" Margin="0,0,6,4" Click="MarkSelectedPublished_Click"/>
                                <Button x:Name="ProbeFileButton" Content="Probe selected" Padding="8,4" Margin="0,0,6,4" Click="ProbeFile_Click"/>
                                <Button x:Name="CompareSourceButton" Content="Compare selected" Padding="8,4" Margin="0,0,6,4" Click="CompareSource_Click"/>
                                <Button Content="Restore version…" Padding="8,4" Margin="0,0,6,4" Click="RestoreSourceVersion_Click"/>
                                <Button Content="Synthesize with AI…" Padding="8,4" Margin="0,0,6,4" Click="SynthesizeSource_Click"/>
                            </WrapPanel>
                            <DataGrid x:Name="SourcesGrid" AutoGenerateColumns="False" HeadersVisibility="Column"
                                      CanUserAddRows="False" CanUserDeleteRows="False"
                                      PreviewMouseMove="SourcesGrid_PreviewMouseMove"
                                      SelectionChanged="SourcesGrid_SelectionChanged"
                                      CellEditEnding="SourcesGrid_CellEditEnding"
                                      CurrentCellChanged="SourcesGrid_CurrentCellChanged"
                                      SelectionMode="Single">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="File" Binding="{Binding RelativePath}" Width="*" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="Status" Binding="{Binding LocalStatus}" Width="100" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="Last uploaded" Binding="{Binding LastUploaded}" Width="115" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="Project match" Binding="{Binding ProjectMatch}" Width="105" IsReadOnly="True"/>
                                    <DataGridCheckBoxColumn Header="Published" Binding="{Binding IsPublished, UpdateSourceTrigger=PropertyChanged}" Width="72"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                        <DockPanel Grid.Column="2">
                            <TextBlock DockPanel.Dock="Top" Text="Version history" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <WrapPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                                <Button Content="Preview archive" Padding="8,4" Margin="0,0,6,4" Click="PreviewSourceArchive_Click"/>
                                <Button Content="Compare vs current" Padding="8,4" Margin="0,0,0,4" Click="CompareSourceArchive_Click"/>
                            </WrapPanel>
                            <ListBox x:Name="SourceHistoryList" DisplayMemberPath="DisplayLabel" SelectionChanged="SourceHistoryList_SelectionChanged"/>
                        </DockPanel>
                    </Grid>
                    <ScrollViewer DockPanel.Dock="Bottom" MaxHeight="300" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                        <StackPanel>
                            <local:EntityCanonCommitBar x:Name="CanonCommitBar" Margin="0,0,0,8" PlansChanged="CanonCommitBar_PlansChanged"/>
                            <Border x:Name="CanonDriftBanner" Visibility="Collapsed" Padding="8" Margin="0,0,0,8"
                                    Background="{StaticResource WarningSubtleBrush}" CornerRadius="4">
                                <StackPanel>
                                    <TextBlock x:Name="CanonDriftBannerText" TextWrapping="Wrap" FontSize="11"/>
                                    <Button Content="Sync sources from JSON now" Padding="8,4" Margin="0,6,0,0"
                                            HorizontalAlignment="Left" Click="SyncSourcesFromJson_Click"/>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="AI source edit proposals" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBlock Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6"
                                       Text="Proposals from Edit sources with AI. Entity profile edits and renames are handled in Design (canon commit bar), not here."/>
                            <TextBlock x:Name="SourceEditReviewHeader" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,0,0,4"/>
                            <ListBox x:Name="SourceEditReviewList" MinHeight="48" Margin="0,0,0,4" DisplayMemberPath="DisplayLabel"
                                     SelectionChanged="SourceEditReviewList_SelectionChanged"/>
                            <TextBox x:Name="SourceEditDiffPreviewBox" MinHeight="72" MaxHeight="120"
                                     IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                     FontFamily="Consolas" FontSize="11" Margin="0,0,0,8"
                                     Background="{StaticResource BgSurfaceBrush}"
                                     Foreground="{StaticResource TextPrimaryBrush}"
                                     BorderBrush="{StaticResource BorderSubtleBrush}"/>
                            <WrapPanel Margin="0,0,0,4">
                                <Button Content="Apply proposal" Padding="8,4" Margin="0,0,6,0" Click="AcceptSourceEdit_Click"/>
                                <Button Content="Dismiss proposal" Padding="8,4" Margin="0,0,6,0" Click="DismissSourceEdit_Click"/>
                                <Button Content="Review all…" Padding="8,4" Tag="{x:Static services:ProposalReviewCategory.SourceEdit}" Click="ReviewAllProposals_Click"/>
                            </WrapPanel>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>
            <TabItem x:Name="HistoryTab" Header="History">
                <local:FlightRecorderPanel x:Name="FlightRecorderPanel" Margin="8"/>
            </TabItem>
        </TabControl>

        <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent"/>

        <Border Grid.Column="2" Padding="12" Background="{StaticResource BgSurfaceBrush}"
                CornerRadius="{StaticResource RadiusControl}">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <TextBlock Text="Live packet preview" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,4"/>
                    <TextBlock Text="Shows the merged play packet for the next Send. Packet only — does not change Project instructions or source files."
                               FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>

                    <TextBlock Text="Sample player line" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,4"/>
                    <TextBlock Text="Used when the in-page composer is empty. Also reads continuation queue on Play packet tab."
                               FontSize="10" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                    <TextBox x:Name="PreviewPlayerLinePanelBox" MinHeight="36" AcceptsReturn="True" TextWrapping="Wrap"
                             Margin="0,0,0,6" TextChanged="PreviewPlayerLinePanelBox_TextChanged"
                             LostFocus="PreviewPlayerLinePanelBox_LostFocus"/>

                    <TextBlock x:Name="PreviewSourceLine" TextWrapping="Wrap"
                               Foreground="{StaticResource TextMutedBrush}" FontSize="10" Margin="0,0,0,4"/>
                    <TextBlock x:Name="PreviewStagingHint" TextWrapping="Wrap"
                               Foreground="{StaticResource AccentLinkBrush}" FontSize="10" Margin="0,0,0,8"/>

                    <WrapPanel>
                        <Button Content="Refresh" Padding="8,4" Margin="0,0,8,4" Click="RefreshPreview_Click"/>
                        <Button Content="View full…" Padding="8,4" Margin="0,0,8,4" Click="ViewFull_Click"/>
                        <Button Content="Copy packet" Padding="8,4" Margin="0,0,0,4" Click="CopyPacket_Click"/>
                    </WrapPanel>
                </StackPanel>
                <local:InjectionPacketPreviewControl x:Name="InjectionPreviewPanel"/>
            </DockPanel>
        </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <TextBlock x:Name="PlaySettingsSaveLine"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Left"
                       Foreground="{StaticResource TextMutedBrush}"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Margin="0,0,12,0"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Padding="12,6" Margin="0,0,8,0" IsCancel="True"/>
                <Button x:Name="PlaySettingsSaveButton"
                        Content="Save"
                        Padding="12,6"
                        Margin="0,0,8,0"
                        IsEnabled="False"
                        Click="SavePlaySettings_Click"/>
                <Button Content="OK" Style="{StaticResource PrimaryButtonStyle}" MinWidth="88" IsDefault="True" Click="Ok_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</shell:ShellDialogWindow>
