                                                  Checked="StoryContextSettings_Changed" Unchecked="StoryContextSettings_Changed"/>
                                        <CheckBox x:Name="StoryContextIncludeScenarioCheck"
                                                  Content="Scenario excerpt"
                                                  Margin="0,0,0,4"
                                                  Checked="StoryContextSettings_Changed" Unchecked="StoryContextSettings_Changed"/>
