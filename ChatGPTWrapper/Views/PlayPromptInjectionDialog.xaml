                                <StackPanel Margin="0,8,0,0">
                                    <TextBlock Style="{StaticResource ShellSectionHintStyle}"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,8"
                                               Text="File delivery testing for play-state and canon-profile jobs that stage reference files. DOM composer attach is canonical; API attach on project threads is retired."/>
