<shell:ShellDialogWindow xmlns:shell="clr-namespace:ChatGPTWrapper.Shell" x:Class="ChatGPTWrapper.Views.RecapDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Recap"
        Height="420"
        Width="520"
        MinHeight="400"
        MinWidth="440"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBaseBrush}"
        Foreground="{StaticResource TextPrimaryBrush}">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Copy" Padding="10,5" Margin="0,0,8,0" Click="Copy_Click"/>
            <Button Content="Close" Padding="10,5" IsDefault="True" Click="Close_Click"/>
        </StackPanel>
        <TextBox x:Name="RecapBox" AcceptsReturn="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" IsReadOnly="True"/>
    </DockPanel>
</shell:ShellDialogWindow>
