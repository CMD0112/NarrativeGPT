<Window x:Class="ChatGPTWrapper.Views.CastPhraseImportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ChatGPTWrapper.Views"
        Title="Import cast as phrase highlights"
        Height="520"
        Width="560"
        MinHeight="400"
        MinWidth="460"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBaseBrush}"
        Foreground="{StaticResource TextPrimaryBrush}">
    <Window.Resources>
        <views:HexColorBrushConverter x:Key="HexColorBrushConverter"/>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Style="{StaticResource ShellSectionHintStyle}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,12"
                   Text="Select names to import as phrase highlight rules. Names already in your highlight list are shown but skipped by default."/>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <WrapPanel VerticalAlignment="Center">
                <CheckBox x:Name="IncludePlayerCheck" Content="Include player" Margin="0,0,16,4" IsChecked="True"/>
                <CheckBox x:Name="IncludePartyCheck" Content="Include party &amp; cast" Margin="0,0,16,4" IsChecked="True"/>
                <CheckBox x:Name="IncludeAliasesCheck" Content="Include aliases" Margin="0,0,0,4" IsChecked="True"/>
            </WrapPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="SelectNewOnlyButton"
                        Content="New only"
                        Padding="10,4"
                        Margin="0,0,8,0"
                        MinHeight="28"
                        Style="{StaticResource ShellCommandBarSecondarySlot}"
                        Click="SelectNewOnly_Click"/>
                <Button x:Name="SelectAllButton"
                        Content="Select all"
                        Padding="10,4"
                        Margin="0,0,8,0"
                        MinHeight="28"
                        Style="{StaticResource ShellCommandBarSecondarySlot}"
                        Click="SelectAll_Click"/>
                <Button x:Name="ClearSelectionButton"
                        Content="Clear"
                        Padding="10,4"
                        MinHeight="28"
                        Style="{StaticResource ShellCommandBarSecondarySlot}"
                        Click="ClearSelection_Click"/>
            </StackPanel>
        </Grid>

        <Border x:Name="ColumnHeaderBorder"
                Grid.Row="2"
                Style="{StaticResource ShellCardStyle}"
                Padding="12,8"
                Margin="0,0,0,0"
                BorderThickness="1,1,1,0"
                CornerRadius="8,8,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="112"/>
                    <ColumnDefinition Width="56"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="1" Text="Phrase" FontWeight="SemiBold"/>
                <TextBlock Grid.Column="2" Text="Role" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                <TextBlock Grid.Column="3" Text="Color" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center"/>
            </Grid>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource ShellCardStyle}" Padding="0" CornerRadius="0,0,8,8">
            <Grid>
                <ListBox x:Name="CandidateList"
                         BorderThickness="0"
                         Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionMode="Single"
                         FocusVisualStyle="{x:Null}">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Setter Property="Padding" Value="12,8"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="112"/>
                                    <ColumnDefinition Width="56"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0"
                                          IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          IsEnabled="{Binding IsSelectable}"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Left"
                                          FocusVisualStyle="{x:Null}"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Phrase}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Phrase}"/>
                                <TextBlock Grid.Column="2"
                                           Text="{Binding Role}"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Role}"/>
                                <Border Grid.Column="3"
                                        Width="24"
                                        Height="24"
                                        CornerRadius="4"
                                        BorderBrush="{StaticResource BorderStrongBrush}"
                                        BorderThickness="1"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Background="{Binding Color, Converter={StaticResource HexColorBrushConverter}}"
                                        ToolTip="{Binding Color}"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="EmptyStateText"
                           Text="No cast names found. Add a player or characters in Reference, or regenerate entities from cast sources."
                           TextWrapping="Wrap"
                           Foreground="{StaticResource TextMutedBrush}"
                           FontSize="{DynamicResource FontSizeHint}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Margin="24"
                           TextAlignment="Center"
                           Visibility="Collapsed"/>
            </Grid>
        </Border>

        <TextBlock x:Name="ColorAnalysisText"
                   Grid.Row="4"
                   Style="{StaticResource ShellSectionHintStyle}"
                   TextWrapping="Wrap"
                   Margin="0,10,0,0"
                   Visibility="Collapsed"/>

        <TextBlock x:Name="SummaryText"
                   Grid.Row="5"
                   Style="{StaticResource ShellSectionHintStyle}"
                   Margin="0,6,0,0"
                   Visibility="Collapsed"/>

        <TextBlock x:Name="ValidationText"
                   Grid.Row="6"
                   TextWrapping="Wrap"
                   Foreground="{StaticResource ErrorBrush}"
                   FontSize="{DynamicResource FontSizeHint}"
                   Margin="0,8,0,0"
                   Visibility="Collapsed"/>

        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel"
                    Padding="12,6"
                    Margin="0,0,8,0"
                    MinHeight="32"
                    Style="{StaticResource ShellCommandBarSecondarySlot}"
                    IsCancel="True"/>
            <Button x:Name="ImportButton"
                    Content="Import selected"
                    Style="{StaticResource PrimaryButtonStyle}"
                    MinWidth="120"
                    MinHeight="32"
                    Padding="12,6"
                    IsDefault="True"
                    Click="Import_Click"/>
        </StackPanel>
    </Grid>
</Window>
