<shell:ShellDialogWindow xmlns:shell="clr-namespace:ChatGPTWrapper.Shell" x:Class="ChatGPTWrapper.Views.EntityMergeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Merge entity"
        Height="420"
        Width="520"
        MinWidth="440"
        MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBaseBrush}"
        Foreground="{StaticResource TextPrimaryBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Merge the selected entity into another. Mentions will rewrite to the target name; the source entity will be removed."
                   TextWrapping="Wrap"
                   Margin="0,0,0,12"/>
        <TextBlock Grid.Row="1" Text="Source" Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
        <TextBlock x:Name="SourceNameBlock" Grid.Row="1" Margin="0,16,0,8" FontWeight="SemiBold"/>
        <TextBlock Grid.Row="2" Text="Merge into" Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
        <ComboBox x:Name="TargetCombo" Grid.Row="2" Margin="0,16,0,8" DisplayMemberPath="Name"/>
        <TextBlock x:Name="PreviewBlock" Grid.Row="3" TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancel" Padding="12,6" Margin="0,0,8,0" IsCancel="True"/>
            <Button Content="Merge" Padding="12,6" IsDefault="True" Click="Merge_Click"/>
        </StackPanel>
    </Grid>
</shell:ShellDialogWindow>
