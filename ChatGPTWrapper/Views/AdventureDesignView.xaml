<UserControl x:Class="ChatGPTWrapper.Views.AdventureDesignView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource DialogBgBrush}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*" MinWidth="0"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="BackButton" Content="← Dashboard" Padding="10,4" Click="Back_Click"/>
            <TextBlock x:Name="TitleBlock" Grid.Column="1" FontSize="{StaticResource FontSizeTitle}"
                       FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0"
                       TextTrimming="CharacterEllipsis"/>
            <Button x:Name="LinkProjectButton" Grid.Column="2" Content="Change Project…" Padding="10,4"
                    Click="LinkProject_Click"/>
        </Grid>

        <Border Grid.Row="1" Background="{StaticResource PanelBgBrush}"
                BorderBrush="{StaticResource BorderBrushSubtle}" BorderThickness="1"
                CornerRadius="{StaticResource RadiusCard}" Padding="8" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock x:Name="ThreadStatusBlock" Foreground="{StaticResource MutedTextBrush}"
                           FontSize="{StaticResource FontSizeHint}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                <WrapPanel Margin="0,0,0,6">
                    <TextBox x:Name="BriefNoteBox" MinWidth="200" Padding="6,4" Margin="0,0,6,0"
                             ToolTip="Optional note included with Send step brief"/>
                </WrapPanel>
                <WrapPanel>
                    <Button x:Name="OpenDesignThreadButton" Content="Open Project" Padding="8,4"
                            Margin="0,0,6,4" Click="OpenDesignThread_Click"/>
                    <Button x:Name="StartNewDesignThreadButton" Content="Start new design thread…" Padding="8,4"
                            Margin="0,0,6,4" Click="StartNewDesignThread_Click"
                            ToolTip="Release stale design thread binding and open your Project for a fresh chat"/>
                    <Button x:Name="PinDesignTabButton" Content="Use this tab as design thread" Padding="8,4"
                            Margin="0,0,6,4" Click="PinDesignTab_Click"/>
                    <Button x:Name="SendStepBriefButton" Content="Send step brief…" Padding="8,4"
                            Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,6,4"
                            Click="SendStepBrief_Click"/>
                    <Button x:Name="ExtractButton" Content="Extract proposals" Padding="8,4"
                            Margin="0,0,6,4" Click="Extract_Click"/>
                    <Button x:Name="ImportDraftButton" Content="Import framework draft" Padding="8,4"
                            Margin="0,0,6,4" Click="ImportDraft_Click" Visibility="Collapsed"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <TabControl x:Name="StepTabs" Grid.Row="2" Margin="0,0,0,4" SelectionChanged="StepTabs_SelectionChanged">
            <TabItem Header="Concept" Tag="Concept"/>
            <TabItem Header="World" Tag="World"/>
            <TabItem Header="Plot" Tag="Plot"/>
            <TabItem Header="Cast" Tag="Cast"/>
            <TabItem Header="Lexicon" Tag="Lexicon"/>
            <TabItem Header="Sources" Tag="Sources"/>
            <TabItem Header="Instructions" Tag="Instructions"/>
            <TabItem Header="Review" Tag="Review"/>
        </TabControl>

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="DraftPanel" Margin="4"/>
        </ScrollViewer>

        <Grid Grid.Row="4" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Button x:Name="AcceptProposalsButton" Content="Accept proposals" Padding="10,5"
                        Margin="0,0,6,0" Click="AcceptProposals_Click" IsEnabled="False"/>
                <TextBlock x:Name="StatusLine" VerticalAlignment="Center" TextWrapping="Wrap"
                           Foreground="{StaticResource MutedTextBrush}" FontSize="11"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="BackStepButton" Content="← Back" Padding="12,6" Margin="0,0,6,0"
                        Click="BackStep_Click"/>
                <Button x:Name="ContinueButton" Content="Continue →" Style="{StaticResource PrimaryButtonStyle}"
                        Padding="12,6" Margin="0,0,6,0" Click="Continue_Click"/>
                <Button x:Name="LaunchButton" Content="Launch adventure" Style="{StaticResource PrimaryButtonStyle}"
                        Padding="12,6" Margin="0,0,6,0" Click="Launch_Click" Visibility="Collapsed"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
