<UserControl x:Class="ChatGPTWrapper.Views.AdventureDesignView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ChatGPTWrapper.Views"
             Background="{StaticResource BgBaseBrush}">
    <Grid Margin="{DynamicResource SpaceMdPadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid x:Name="DesignHeaderGrid" Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*" MinWidth="0"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="BackButton" Content="← Dashboard" Padding="10,4" Margin="0,0,8,0"
                    Click="Back_Click"/>
            <TextBlock x:Name="TitleBlock" Grid.Column="1" FontSize="{StaticResource FontSizeTitle}"
                       FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"
                       TextTrimming="CharacterEllipsis"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <StackPanel Style="{StaticResource ShellCommandBarStyle}">
                    <Button x:Name="ThreadsButton"
                            Content="Threads…"
                            Style="{StaticResource ShellCommandBarPrimarySlot}"
                            Margin="0,0,8,0"
                            ToolTip="Open Threads hub — project link, play/design pins, delivery"
                            Click="ManageThreads_Click"/>
                </StackPanel>
                <Menu Background="Transparent" VerticalAlignment="Center">
                <MenuItem x:Name="HeaderMoreMenu" Header="More…" Padding="10,4">
                    <MenuItem x:Name="HeaderLinkProjectMenuItem"
                              Header="Change Project…"
                              Click="LinkProject_Click"/>
                    <Separator/>
                    <MenuItem x:Name="ManageThreadsMenuItem"
                              Header="Manage threads…"
                              Click="ManageThreads_Click"
                              ToolTip="View, switch, and archive play and design thread slots"/>
                    <MenuItem x:Name="OpenDesignThreadMenuItem"
                              Header="Open Project"
                              Click="OpenDesignThread_Click"/>
                    <MenuItem x:Name="StartNewDesignThreadMenuItem"
                              Header="Start new design thread…"
                              Click="StartNewDesignThread_Click"
                              ToolTip="Release stale design thread binding and open your Project for a fresh chat"/>
                    <MenuItem x:Name="PinDesignTabMenuItem"
                              Header="Use this tab as design thread"
                              Click="PinDesignTab_Click"/>
                    <MenuItem x:Name="ImportDraftMenuItem"
                              Header="Import framework draft"
                              Click="ImportDraft_Click"
                              Visibility="Collapsed"/>
                    <Separator/>
                    <MenuItem Header="Canon inbox…" Click="CanonInbox_Click"/>
                </MenuItem>
                </Menu>
            </StackPanel>
            <Button x:Name="LinkProjectButton" Grid.Column="2" Visibility="Collapsed" Click="LinkProject_Click"/>
        </Grid>

        <Border x:Name="DesignCockpit"
                Grid.Row="1"
                Style="{StaticResource ShellCardStyle}"
                Margin="0,0,0,8">
            <StackPanel>
                <Border x:Name="DraftModeBanner" Visibility="Collapsed"
                        Background="{StaticResource AccentSubtleBrush}"
                        BorderBrush="{StaticResource AccentPrimaryBrush}" BorderThickness="1"
                        CornerRadius="{StaticResource RadiusControl}" Padding="8,6" Margin="0,0,0,8">
                    <TextBlock x:Name="DraftModeBannerText" TextWrapping="Wrap"
                               Foreground="{DynamicResource AccentLinkBrush}" FontWeight="SemiBold"
                               FontSize="{StaticResource FontSizeHint}"/>
                </Border>

                <Border x:Name="CanonSyncNoticeBanner"
                        Background="{StaticResource SuccessSubtleBrush}"
                        BorderBrush="{StaticResource SuccessBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource RadiusControl}"
                        Padding="8,6"
                        Margin="0,0,0,8"
                        Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="CanonSyncNoticeText"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource ShellSectionHintStyle}"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                            <Button Content="View diff" Style="{StaticResource ShellCommandBarSecondarySlot}" Margin="0,0,6,0" Click="ViewLastCanonSyncDiff_Click"/>
                            <Button Content="Source Manager" Style="{StaticResource ShellCommandBarSecondarySlot}" Margin="0,0,6,0" Click="OpenSourceManagerFromBanner_Click"/>
                            <Button Content="×" Style="{StaticResource ShellCommandBarSecondarySlot}" ToolTip="Dismiss" Click="DismissCanonSyncNotice_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <local:EntityCanonCommitBar x:Name="CanonHealthBar" PlansChanged="CanonHealthBar_PlansChanged"/>

                <TextBlock x:Name="ThreadStatusBlock"
                           Style="{StaticResource ShellSectionHintStyle}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,8"
                           Cursor="Hand"
                           ToolTip="Manage threads"
                           MouseLeftButtonUp="ThreadStatus_Click"/>

                <Expander x:Name="BriefNoteExpander" IsExpanded="False" Margin="0,0,0,8">
                    <Expander.Header>
                        <TextBlock Text="Brief note (optional)" Style="{StaticResource ShellSectionHintStyle}"/>
                    </Expander.Header>
                    <TextBox x:Name="BriefNoteBox" MinWidth="200" Padding="6,4" Margin="0,4,0,0"
                             ToolTip="Optional note included with Send step brief"/>
                </Expander>

                <StackPanel Orientation="Horizontal" Style="{StaticResource ShellCommandBarStyle}">
                    <Button x:Name="SendStepBriefButton"
                            Content="Send step brief…"
                            Style="{StaticResource ShellCommandBarPrimarySlot}"
                            Margin="0,0,8,0"
                            Click="SendStepBrief_Click"/>
                    <Button x:Name="ExtractButton"
                            Content="Extract proposals"
                            Style="{StaticResource ShellCommandBarSecondarySlot}"
                            Click="Extract_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*" MinWidth="0"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Step"
                       Style="{StaticResource ShellSectionHintStyle}"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0"/>
            <ComboBox x:Name="StepCombo"
                      Grid.Column="1"
                      MinWidth="0"
                      SelectionChanged="StepCombo_SelectionChanged"/>
        </Grid>

        <Expander x:Name="PipelineChecklistExpander" Grid.Row="3" IsExpanded="False" Margin="0,0,0,8" Visibility="Collapsed">
            <Expander.Header>
                <TextBlock Text="Source draft pipeline" Style="{StaticResource ShellSectionHeaderStyle}"/>
            </Expander.Header>
            <Border x:Name="PipelineChecklistBorder" Style="{StaticResource ShellCardStyle}" Margin="0,4,0,0" Padding="8">
                <StackPanel>
                    <TextBlock Text="Canonical source draft order — click a row to jump."
                               TextWrapping="Wrap"
                               Foreground="{StaticResource TextMutedBrush}"
                               Style="{StaticResource ShellSectionHintStyle}"
                               Margin="0,0,0,8"/>
                    <StackPanel x:Name="PipelineChecklistPanel"/>
                </StackPanel>
            </Border>
        </Expander>

        <ScrollViewer Grid.Row="4" Style="{StaticResource ShellFormScrollViewerStyle}">
            <StackPanel x:Name="DraftPanel" Margin="0,0,4,0"/>
        </ScrollViewer>

        <!-- Parking host when Cast step is not active (panel is reparented into DraftPanel on Cast). -->
        <Grid x:Name="EntityReferenceHost" Grid.Row="4" Visibility="Collapsed">
            <Border x:Name="EntityReferenceSection"
                    Style="{StaticResource ShellCardStyle}"
                    Margin="0,0,0,12"
                    Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="Canon entities"
                               Style="{StaticResource ShellSectionHeaderStyle}"
                               Margin="0,0,0,4"/>
                    <TextBlock Text="Structured entries in entities.json — renames auto-sync to local sources when possible."
                               TextWrapping="Wrap"
                               Style="{StaticResource ShellSectionHintStyle}"
                               Margin="0,0,0,10"/>
                    <local:EntityReferencePanel x:Name="EntityReferencePanel"
                                                MinHeight="200"/>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="5" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="AcceptProposalsButton" Content="Accept proposals"
                        Style="{StaticResource ShellCommandBarSecondarySlot}"
                        Margin="0,0,8,0" Click="AcceptProposals_Click" IsEnabled="False" Visibility="Collapsed"/>
                <TextBlock x:Name="StatusLine" VerticalAlignment="Center" TextWrapping="Wrap"
                           Style="{StaticResource ShellSectionHintStyle}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Style="{StaticResource ShellCommandBarStyle}">
                <Button x:Name="BackStepButton" Content="← Back"
                        Style="{StaticResource ShellCommandBarSecondarySlot}"
                        Margin="0,0,8,0"
                        Click="BackStep_Click"/>
                <Button x:Name="ContinueButton" Content="Continue →"
                        Style="{StaticResource ShellCommandBarPrimarySlot}"
                        Margin="0,0,8,0"
                        Click="Continue_Click"/>
                <Button x:Name="LaunchButton" Content="Launch adventure"
                        Style="{StaticResource ShellCommandBarPrimarySlot}"
                        Click="Launch_Click" Visibility="Collapsed"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
