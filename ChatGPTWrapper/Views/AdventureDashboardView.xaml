<UserControl x:Class="ChatGPTWrapper.Views.AdventureDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource DialogBgBrush}"
             Focusable="True"
             PreviewKeyDown="AdventureDashboardView_PreviewKeyDown">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Button x:Name="NewAdventureButton" Content="New" Padding="10,5" Margin="0,0,6,0" Click="NewAdventure_Click"/>
                <Button x:Name="DesignWithAiButton" Content="Design with AI…" Padding="10,5" Margin="0,0,6,0" Click="DesignWithAi_Click"/>
                <Button x:Name="PlayButton" Content="Play" Style="{StaticResource PrimaryButtonStyle}" Padding="10,5" Margin="0,0,6,0" Click="Play_Click"/>
                <Button x:Name="LinkProjectButton" Content="Link Project…" Padding="10,5" Margin="0,0,6,0"
                        Click="LinkProject_Click" IsEnabled="False"
                        ToolTip="Connect this adventure to a ChatGPT Project for source files and AI jobs"/>
                <Button x:Name="RenameButton" Content="Rename…" Padding="10,5" Margin="0,0,6,0"
                        Click="Rename_Click" IsEnabled="False"
                        ToolTip="Change adventure title (F2)"/>
                <Button x:Name="DeleteButton" Content="Delete" Padding="10,5" Margin="0,0,6,0" Click="Delete_Click" IsEnabled="False"/>
                <Button x:Name="ArchiveButton" Content="Archive" Padding="10,5" Margin="0,0,6,0" Click="Archive_Click" IsEnabled="False"/>
                <Button x:Name="UnarchiveButton" Content="Unarchive" Padding="10,5" Margin="0,0,6,0" Click="Unarchive_Click" IsEnabled="False"/>
                <Button x:Name="BackupSelectedButton" Content="Backup" Padding="10,5" Margin="0,0,6,0" Click="Backup_Click" IsEnabled="False"/>
                <TextBox x:Name="SearchBox" Width="180" Margin="6,0,0,0" TextChanged="SearchBox_TextChanged"/>
            </StackPanel>
            <Menu Grid.Column="1" Background="Transparent" VerticalAlignment="Center">
                <MenuItem Header="More…" Padding="10,5">
                    <MenuItem x:Name="WrapperSettingsMenuItem" Header="Wrapper settings…" Click="WrapperSettings_Click"/>
                    <Separator/>
                    <MenuItem x:Name="ImportMenuItem" Header="Import backup…" Click="Import_Click"/>
                    <MenuItem x:Name="ImportFolderMenuItem" Header="Import folder…" Click="ImportFolder_Click"/>
                    <MenuItem x:Name="CreateFolderMenuItem" Header="Create folder on disk…" Click="CreateFolder_Click"/>
                    <MenuItem x:Name="LinkProjectMenuItem" Header="Link Project…" Click="LinkProject_Click"/>
                    <Separator/>
                    <MenuItem x:Name="BackupMenuItem" Header="Backup selected" Click="Backup_Click"/>
                    <MenuItem Header="Libraries…" Click="Libraries_Click"/>
                    <MenuItem Header="Save scenario to library" Click="SaveScenarioLib_Click"/>
                    <Separator/>
                    <MenuItem x:Name="DraftFrameworkMenuItem" Header="Draft adventure framework…" Click="DraftFramework_Click"/>
                </MenuItem>
            </Menu>
        </Grid>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,6">
            <Button x:Name="SelectAllButton" Content="Select all" Padding="8,4" Margin="0,0,6,0" Click="SelectAll_Click"/>
            <Button x:Name="ClearSelectionButton" Content="Clear selection" Padding="8,4" Margin="0,0,6,0" Click="ClearSelection_Click" IsEnabled="False"/>
            <TextBlock x:Name="SelectionStatusBlock" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" FontSize="11"/>
        </StackPanel>
        <Grid Grid.Row="2">
            <DataGrid x:Name="AdventureGrid" AutoGenerateColumns="False" IsReadOnly="True"
                      SelectionMode="Extended" CanUserAddRows="False" Background="{StaticResource PanelBgBrush}"
                      Foreground="{StaticResource TextBrush}"
                      BorderBrush="{StaticResource BorderBrushSubtle}"
                      MouseDoubleClick="AdventureGrid_MouseDoubleClick"
                      SelectionChanged="AdventureGrid_SelectionChanged">
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Play" Click="Play_Click"/>
                        <MenuItem x:Name="LinkProjectContextMenuItem" Header="Link Project…" Click="LinkProject_Click"/>
                        <MenuItem x:Name="ContinueDesignMenuItem" Header="Continue design…" Click="ContinueDesign_Click"/>
                        <MenuItem x:Name="RenameContextMenuItem" Header="Rename…" Click="Rename_Click"/>
                        <MenuItem x:Name="CreateFolderContextMenuItem" Header="Create folder on disk…" Click="CreateFolder_Click"/>
                        <MenuItem x:Name="ArchiveContextMenuItem" Header="Archive selected" Click="Archive_Click"/>
                        <MenuItem x:Name="UnarchiveContextMenuItem" Header="Unarchive selected" Click="Unarchive_Click"/>
                        <MenuItem x:Name="BackupContextMenuItem" Header="Backup selected" Click="Backup_Click"/>
                        <Separator/>
                        <MenuItem x:Name="DeleteContextMenuItem" Header="Delete selected" Click="Delete_Click"/>
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="*"/>
                    <DataGridTextColumn Header="Genre" Binding="{Binding Genre}" Width="90"/>
                    <DataGridTextColumn Header="Project" Binding="{Binding ProjectLinked}" Width="64"/>
                    <DataGridTextColumn Header="Design" Binding="{Binding DesignThread}" Width="56"/>
                    <DataGridTextColumn Header="Turns" Binding="{Binding TurnCount}" Width="52"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="72"/>
                    <DataGridTextColumn Header="Last played" Binding="{Binding LastPlayedDisplay}" Width="120"/>
                </DataGrid.Columns>
            </DataGrid>
            <Border x:Name="LoadingOverlay" Background="#CC1A1A1E" Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock x:Name="LoadingStatusBlock" Text="Loading adventures…"
                               Foreground="{StaticResource TextBrush}" FontSize="14" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0">
            <TextBlock x:Name="LocalOnlyHint" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/>
            <CheckBox x:Name="ShowArchivedCheck" Content="Show archived" Margin="16,0,0,0" VerticalAlignment="Center"
                      Checked="ShowArchived_Changed" Unchecked="ShowArchived_Changed"/>
        </StackPanel>
    </Grid>
</UserControl>
