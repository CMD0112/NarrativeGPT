<Window x:Class="ChatGPTWrapper.Views.CanonInboxDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Canon inbox"
        Height="480"
        Width="560"
        MinHeight="360"
        MinWidth="480"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBaseBrush}"
        Foreground="{StaticResource TextPrimaryBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Pending canon work — select an item to navigate."
                   TextWrapping="Wrap"
                   Foreground="{StaticResource TextMutedBrush}"
                   Margin="0,0,0,8"/>
        <ListBox x:Name="InboxList"
                 Grid.Row="1"
                 MouseDoubleClick="InboxList_MouseDoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="0,4">
                        <TextBlock FontWeight="SemiBold">
                            <Run Text="{Binding Title}"/>
                            <Run Text=" (" Foreground="{StaticResource TextMutedBrush}"/>
                            <Run Text="{Binding Count}" Foreground="{StaticResource TextMutedBrush}"/>
                            <Run Text=")" Foreground="{StaticResource TextMutedBrush}"/>
                        </TextBlock>
                        <TextBlock Text="{Binding Detail}"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="11"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Close" Padding="12,6" IsDefault="True" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
