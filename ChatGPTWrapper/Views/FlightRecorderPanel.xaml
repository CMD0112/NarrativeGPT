<UserControl x:Class="ChatGPTWrapper.Views.FlightRecorderPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:ChatGPTWrapper.Adventure.Services"
             MinHeight="240">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <DataTemplate DataType="{x:Type services:InjectionSectionViewModel}">
            <Border Padding="6,5" Margin="0,0,0,2" CornerRadius="3"
                    Background="{StaticResource BgSurfaceBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding DisplayName}" FontSize="11"/>
                        <TextBlock Text="{Binding Note}" FontSize="10"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding StatusBadge}" FontSize="10" FontWeight="SemiBold"
                               Margin="8,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"
                               MaxWidth="180" TextAlignment="Right"/>
                </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate DataType="{x:Type services:FlightSectionDiffRowViewModel}">
            <Border Padding="6,5" Margin="0,0,0,2" CornerRadius="3"
                    Background="{StaticResource BgSurfaceBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding DisplayName}" FontSize="11"/>
                        <TextBlock Text="{Binding Note}" FontSize="10"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding ChangeBadge}" FontSize="10" FontWeight="SemiBold"
                               Margin="8,0,8,0" VerticalAlignment="Center"
                               Foreground="{StaticResource AccentPrimaryBrush}"/>
                    <TextBlock Grid.Column="2" Text="{Binding StatusBadge}" FontSize="10" FontWeight="SemiBold"
                               VerticalAlignment="Center" TextWrapping="Wrap"
                               MaxWidth="180" TextAlignment="Right"/>
                </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate DataType="{x:Type services:FlightPointerRowViewModel}">
            <Border Padding="6,4" Margin="0,0,0,2" CornerRadius="3"
                    Background="{StaticResource BgInsetBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding Title}" FontSize="11"/>
                        <TextBlock FontSize="10" Foreground="{StaticResource TextMutedBrush}">
                            <Run Text="{Binding SourceLabel, Mode=OneWay}"/>
                            <Run Text=" · score "/>
                            <Run Text="{Binding Score, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding ModeLabel}" FontSize="10"
                               Margin="8,0,0,0" VerticalAlignment="Center"
                               Foreground="{StaticResource TextMutedBrush}"/>
                </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate DataType="{x:Type services:FlightPointerDiffRowViewModel}">
            <Border Padding="6,4" Margin="0,0,0,2" CornerRadius="3"
                    Background="{StaticResource BgInsetBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding Title}" FontSize="11"/>
                        <TextBlock FontSize="10" Foreground="{StaticResource TextMutedBrush}">
                            <Run Text="{Binding SourceLabel, Mode=OneWay}"/>
                            <Run Text=" · score "/>
                            <Run Text="{Binding Score, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="NEW" FontSize="10" FontWeight="SemiBold"
                               Margin="8,0,8,0" VerticalAlignment="Center"
                               Foreground="{StaticResource AccentPrimaryBrush}"
                               Visibility="{Binding IsNew, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <TextBlock Grid.Column="2" Text="{Binding ModeLabel}" FontSize="10"
                               Margin="8,0,0,0" VerticalAlignment="Center"
                               Foreground="{StaticResource TextMutedBrush}"/>
                </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate DataType="{x:Type services:FlightUtilityRunRowViewModel}">
            <Border Padding="6,4" Margin="0,0,0,2" CornerRadius="3"
                    Background="{StaticResource BgSurfaceBrush}">
                <StackPanel>
                    <TextBlock FontSize="11" FontWeight="SemiBold" Text="{Binding JobLabel}"/>
                    <TextBlock FontSize="10" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap">
                        <Run Text="{Binding LaneLabel, Mode=OneWay}"/>
                        <Run Text=" · "/>
                        <Run Text="{Binding StateLabel, Mode=OneWay}"/>
                    </TextBlock>
                    <TextBlock Text="{Binding ManifestSummary}" FontSize="10"
                               Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </DataTemplate>
        <DataTemplate DataType="{x:Type services:FlightTraceEventRowViewModel}">
            <TextBlock FontSize="10" Foreground="{StaticResource TextMutedBrush}"
                       TextWrapping="Wrap" Margin="0,0,0,2">
                <Run Text="{Binding Event, Mode=OneWay}" FontFamily="Consolas"/>
                <Run Text=" — "/>
                <Run Text="{Binding Message, Mode=OneWay}"/>
            </TextBlock>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="200"/>
            <ColumnDefinition Width="8"/>
            <ColumnDefinition Width="1.5*" MinWidth="280"/>
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0">
            <TextBlock x:Name="TimelineIntroText" DockPanel.Dock="Top"
                       Text="Audit timeline — verified play sends and worker attachment jobs."
                       Foreground="{StaticResource TextMutedBrush}" FontSize="11"
                       TextWrapping="Wrap" Margin="0,0,0,8"/>
            <ListBox x:Name="TimelineList"
                     DisplayMemberPath="DisplayLabel"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     SelectionChanged="TimelineList_SelectionChanged"/>
        </DockPanel>

        <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent"/>

        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="DetailPanel" Visibility="Collapsed">
                <TextBlock x:Name="DetailHeaderText" FontWeight="SemiBold" FontSize="12"
                           TextWrapping="Wrap" Margin="0,0,0,4"/>
                <TextBlock x:Name="LogTurnLinkText" FontSize="10"
                           Foreground="{StaticResource TextMutedBrush}"
                           TextWrapping="Wrap" Margin="0,0,0,8"/>
                <TextBlock x:Name="WorkerAttachmentDetailText" FontSize="10"
                           Foreground="{StaticResource TextMutedBrush}"
                           TextWrapping="Wrap" Margin="0,0,0,8"
                           Visibility="Collapsed"/>

                <StackPanel x:Name="PlaySendTracePanel">
                <TextBlock Text="Send trace" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,4"/>
                <WrapPanel Margin="0,0,0,4">
                    <TextBlock x:Name="TraceRunIdText" FontFamily="Consolas" FontSize="10"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Button Content="Copy run id" Padding="8,4" Margin="0,0,8,0" Click="CopyTraceRunId_Click"/>
                    <Button Content="Copy summary path" Padding="8,4" Click="CopyTracePath_Click"/>
                </WrapPanel>
                <ItemsControl x:Name="TraceEventList" Margin="0,0,0,10"/>
                </StackPanel>

                <StackPanel x:Name="BundledUtilityPanel">
                <TextBlock Text="Bundled utility runs" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,4"/>
                <TextBlock x:Name="UtilityRunsEmptyText" FontSize="10"
                           Foreground="{StaticResource TextMutedBrush}"
                           Text="No utility jobs bundled with this send."
                           Margin="0,0,0,10"/>
                <ItemsControl x:Name="UtilityRunList" Margin="0,0,0,10"/>
                </StackPanel>

                <StackPanel x:Name="ComparePanel">
                <TextBlock Text="Changes vs prior send" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,4"/>
                <DockPanel Margin="0,0,0,4">
                    <ComboBox x:Name="CompareBaselineCombo" DockPanel.Dock="Right"
                              MinWidth="180" Margin="8,0,0,0"
                              DisplayMemberPath="Label"
                              SelectionChanged="CompareBaselineCombo_SelectionChanged"/>
                    <TextBlock Text="Compare to" VerticalAlignment="Center" FontSize="10"
                               Foreground="{StaticResource TextMutedBrush}"/>
                </DockPanel>
                <TextBlock x:Name="CompareSummaryText" FontSize="10"
                           Foreground="{StaticResource TextMutedBrush}"
                           TextWrapping="Wrap" Margin="0,0,0,8"/>
                </StackPanel>

                <StackPanel x:Name="InjectionPanel">
                <TextBlock Text="Injection sections" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,4"/>
                <ItemsControl x:Name="SectionList" Margin="0,0,0,10"/>
                </StackPanel>

                <StackPanel x:Name="PointersPanel">
                <TextBlock Text="Always retrieve pointers" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,4"/>
                <ItemsControl x:Name="BaselinePointerList" Margin="0,0,0,10"/>

                <TextBlock Text="This turn pointers" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,4"/>
                <ItemsControl x:Name="ThisTurnPointerList" Margin="0,0,0,10"/>
                </StackPanel>

                <TextBlock Text="Delivered packet" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,4"/>
                <TextBox x:Name="PacketTextBox" IsReadOnly="True" AcceptsReturn="True"
                         TextWrapping="Wrap" MinHeight="120" MaxHeight="280"
                         VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11"
                         Margin="0,0,0,8"/>
                <WrapPanel>
                    <Button Content="View full…" Padding="10,5" Margin="0,0,8,0" Click="ViewFull_Click"/>
                    <Button Content="Compare packet…" Padding="10,5" Margin="0,0,8,0" Click="ComparePacket_Click"/>
                    <Button Content="Copy packet" Padding="10,5" Click="CopyPacket_Click"/>
                </WrapPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
