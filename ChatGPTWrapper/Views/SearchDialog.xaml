<Window x:Class="ChatGPTWrapper.Views.SearchDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Search adventure"
        Height="420"
        Width="520"
        MinHeight="320"
        MinWidth="440"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBaseBrush}"
        Foreground="{StaticResource TextPrimaryBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBox x:Name="QueryBox" Margin="0,0,0,8" TextChanged="QueryBox_TextChanged"/>
        <ListBox x:Name="ResultsList" Grid.Row="1">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" Text="{Binding Category}"/>
                        <TextBlock Text="{Binding Title}"/>
                        <TextBlock Foreground="{StaticResource TextMutedBrush}" Text="{Binding Snippet}" TextWrapping="Wrap"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Close" Padding="12,6" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
