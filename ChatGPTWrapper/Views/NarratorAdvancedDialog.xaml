<Window x:Class="ChatGPTWrapper.Views.NarratorAdvancedDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Narrator — advanced"
        Height="460"
        Width="560"
        MinHeight="360"
        MinWidth="480"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBaseBrush}"
        Foreground="{StaticResource TextPrimaryBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Turn directive (next send only)"
                   Margin="0,0,0,4"/>
        <TextBox x:Name="TurnDirectiveBox" Grid.Row="1" AcceptsReturn="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" Margin="0,0,0,12"
                 ToolTip="Freeform instruction injected once into the next play packet."/>
        <TextBlock Grid.Row="2" Text="Session addendum (this session)"
                   Margin="0,0,0,4"/>
        <TextBox x:Name="SessionAddendumBox" Grid.Row="3" AcceptsReturn="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" Margin="0,0,0,12"
                 ToolTip="Optional note appended to turn overrides for the rest of this play session."/>
        <StackPanel Grid.Row="4" Margin="0,0,0,12">
            <CheckBox x:Name="EmphasizeBoundariesCheck"
                      Content="Emphasize content boundaries"
                      Margin="0,0,0,6"/>
            <CheckBox x:Name="EmphasizePortrayalRulesCheck"
                      Content="Emphasize portrayal rules"/>
        </StackPanel>
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Padding="10,5" Margin="0,0,8,0" IsCancel="True"/>
            <Button Content="Save" Style="{StaticResource PrimaryButtonStyle}" Padding="10,5" MinWidth="88"
                    IsDefault="True" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
