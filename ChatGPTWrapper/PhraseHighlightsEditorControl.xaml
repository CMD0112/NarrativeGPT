<UserControl x:Class="ChatGPTWrapper.PhraseHighlightsEditorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource DialogBgBrush}"
             Foreground="{StaticResource TextBrush}">
    <Grid Background="{StaticResource DialogBgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Define words or phrases and how they appear in continuous view."
                   Foreground="{StaticResource MutedTextBrush}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,8"/>

        <WrapPanel Grid.Row="1" Margin="0,0,0,8">
            <Button Content="Add"
                    Padding="8,4"
                    Margin="0,0,8,0"
                    Click="AddButton_Click"/>
            <Button x:Name="RemoveButton"
                    Content="Remove"
                    Padding="8,4"
                    Margin="0,0,8,0"
                    IsEnabled="False"
                    Click="RemoveButton_Click"/>
            <Button x:Name="DuplicateButton"
                    Content="Duplicate"
                    Padding="8,4"
                    IsEnabled="False"
                    Click="DuplicateButton_Click"/>
        </WrapPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="200"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="260" MinWidth="180" MaxWidth="420"/>
            </Grid.ColumnDefinitions>

            <ListView x:Name="RulesListView"
                      Grid.Column="0"
                      Margin="0,0,4,0"
                      Background="{StaticResource PanelBgBrush}"
                      Foreground="{StaticResource TextBrush}"
                      BorderBrush="{StaticResource BorderBrushSubtle}"
                      SelectionChanged="RulesListView_SelectionChanged"
                      KeyDown="RulesListView_KeyDown">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Phrase" Width="180" DisplayMemberBinding="{Binding Phrase}"/>
                        <GridViewColumn Header="Color" Width="72" DisplayMemberBinding="{Binding Color}"/>
                        <GridViewColumn Header="Style" Width="80" DisplayMemberBinding="{Binding StyleSummary}"/>
                    </GridView>
                </ListView.View>
            </ListView>

            <GridSplitter Grid.Column="1"
                          Style="{StaticResource SidePanelGridSplitterStyle}"
                          ResizeBehavior="PreviousAndNext"
                          ResizeDirection="Columns"
                          Width="6"/>
            <ScrollViewer Grid.Column="2"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="Phrase" Margin="0,0,0,4"/>
                    <TextBox x:Name="PhraseTextBox"
                             Margin="0,0,0,10"
                             TextChanged="RuleField_Changed"/>

                    <TextBlock Text="Text color" Margin="0,0,0,4"/>
                    <WrapPanel x:Name="TextColorSwatchesPanel" Margin="0,0,0,6"/>
                    <TextBox x:Name="ColorTextBox"
                             Margin="0,0,0,10"
                             TextChanged="RuleField_Changed"
                             LostFocus="RuleField_Changed"/>

                    <TextBlock Text="Background (optional)" Margin="0,0,0,4"/>
                    <WrapPanel x:Name="BackgroundColorSwatchesPanel" Margin="0,0,0,6"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBox x:Name="BackgroundColorTextBox"
                                 Width="140"
                                 TextChanged="RuleField_Changed"
                                 LostFocus="RuleField_Changed"/>
                        <Button Content="Clear"
                                Margin="8,0,0,0"
                                Padding="8,4"
                                Click="ClearBackgroundButton_Click"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <CheckBox x:Name="BoldCheckBox"
                                  Content="Bold"
                                  Margin="0,0,16,0"
                                  Checked="RuleField_Changed"
                                  Unchecked="RuleField_Changed"/>
                        <CheckBox x:Name="ItalicCheckBox"
                                  Content="Italic"
                                  Checked="RuleField_Changed"
                                  Unchecked="RuleField_Changed"/>
                    </StackPanel>

                    <TextBlock Text="Preview" Margin="0,0,0,4"/>
                    <Border Background="{StaticResource PanelBgBrush}"
                            BorderBrush="{StaticResource BorderBrushSubtle}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusControl}"
                            Padding="12,10"
                            Margin="0,0,0,12">
                        <TextBlock x:Name="PreviewTextBlock"
                                   Text="Sample phrase"
                                   TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <TextBlock x:Name="ValidationTextBlock"
                   Grid.Row="3"
                   Foreground="{StaticResource ErrorBrush}"
                   TextWrapping="Wrap"
                   Margin="0,12,0,0"
                   Visibility="Collapsed"/>
    </Grid>
</UserControl>
