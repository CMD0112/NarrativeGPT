<UserControl x:Class="ChatGPTWrapper.PhraseHighlightsEditorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:ChatGPTWrapper.Views"
             Background="{StaticResource BgBaseBrush}"
             Foreground="{StaticResource TextPrimaryBrush}">
    <UserControl.Resources>
        <views:HexColorBrushConverter x:Key="HexColorBrushConverter"/>
    </UserControl.Resources>
    <Grid Background="{StaticResource BgBaseBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Style="{StaticResource ShellCardStyle}"
                Padding="12"
                Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Automatic colors"
                           FontWeight="SemiBold"
                           Margin="0,0,0,4"/>
                <TextBlock Text="Choose how cast import assigns text colors. Manual edits below always override imported colors."
                           Style="{StaticResource ShellSectionHintStyle}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,10"/>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Preset"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextMutedBrush}"
                               Margin="0,0,10,0"/>
                    <ComboBox x:Name="AutoColorProfileCombo"
                              Grid.Column="1"
                              MinHeight="30"
                              DisplayMemberPath="Name"
                              SelectionChanged="AutoColorProfileCombo_SelectionChanged"/>
                    <Button Grid.Column="2"
                            Content="Customize…"
                            Padding="10,5"
                            MinHeight="30"
                            Margin="10,0,0,0"
                            Style="{StaticResource ShellCommandBarSecondarySlot}"
                            Click="CustomizeAutoColorButton_Click"/>
                </Grid>

                <TextBlock x:Name="AutoColorProfileDescriptionText"
                           Foreground="{StaticResource TextMutedBrush}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,8"/>

                <TextBlock Text="Preset palette"
                           Foreground="{StaticResource TextMutedBrush}"
                           FontSize="{StaticResource FontSizeHint}"
                           Margin="0,0,0,6"/>
                <WrapPanel x:Name="AutoColorPalettePreviewPanel"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1"
                Style="{StaticResource ShellCardStyle}"
                Padding="12,10"
                Margin="0,0,0,12">
            <WrapPanel VerticalAlignment="Center">
                <Button x:Name="ImportFromAdventureButton"
                        Content="Import from adventure…"
                        Padding="10,5"
                        MinHeight="30"
                        Margin="0,0,8,4"
                        Style="{StaticResource ShellCommandBarSecondarySlot}"
                        Click="ImportFromAdventureButton_Click"/>
                <Button Content="Add rule"
                        Padding="10,5"
                        MinHeight="30"
                        Margin="0,0,8,4"
                        Style="{StaticResource ShellCommandBarSecondarySlot}"
                        Click="AddButton_Click"/>
                <Button x:Name="RemoveButton"
                        Content="Remove"
                        Padding="10,5"
                        MinHeight="30"
                        Margin="0,0,8,4"
                        IsEnabled="False"
                        Style="{StaticResource ShellCommandBarSecondarySlot}"
                        Click="RemoveButton_Click"/>
                <Button x:Name="DuplicateButton"
                        Content="Duplicate"
                        Padding="10,5"
                        MinHeight="30"
                        Margin="0,0,0,4"
                        IsEnabled="False"
                        Style="{StaticResource ShellCommandBarSecondarySlot}"
                        Click="DuplicateButton_Click"/>
            </WrapPanel>
        </Border>

        <Grid Grid.Row="2" MinHeight="220">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*" MinWidth="240"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*" MinWidth="280" MaxWidth="480"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <ListView x:Name="RulesListView"
                          Background="{StaticResource BgSurfaceBrush}"
                          Foreground="{StaticResource TextPrimaryBrush}"
                          BorderBrush="{StaticResource BorderSubtleBrush}"
                          SelectionChanged="RulesListView_SelectionChanged"
                          KeyDown="RulesListView_KeyDown">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Phrase" Width="200" DisplayMemberBinding="{Binding Phrase}"/>
                            <GridViewColumn Header="Color" Width="52">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Width="26"
                                                Height="26"
                                                CornerRadius="5"
                                                Margin="0,2"
                                                BorderBrush="{StaticResource BorderSubtleBrush}"
                                                BorderThickness="1"
                                                Background="{Binding Color, Converter={StaticResource HexColorBrushConverter}}"
                                                ToolTip="{Binding Color}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Style" Width="88" DisplayMemberBinding="{Binding StyleSummary}"/>
                        </GridView>
                    </ListView.View>
                </ListView>

                <Border x:Name="RulesEmptyStateBorder"
                        Background="{StaticResource BgSurfaceBrush}"
                        BorderBrush="{StaticResource BorderSubtleBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource RadiusControl}"
                        Padding="20"
                        Visibility="Collapsed">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="No highlight rules yet"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,6"/>
                        <TextBlock Text="Add a rule or import cast names from your adventure."
                                   Foreground="{StaticResource TextMutedBrush}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   MaxWidth="280"/>
                    </StackPanel>
                </Border>
            </Grid>

            <GridSplitter Grid.Column="1"
                          Style="{StaticResource SidePanelGridSplitterStyle}"
                          ResizeBehavior="PreviousAndNext"
                          ResizeDirection="Columns"
                          Width="8"/>

            <ScrollViewer Grid.Column="2"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="Edit rule"
                               FontWeight="SemiBold"
                               Margin="0,0,0,10"/>

                    <TextBlock Text="Phrase" Margin="0,0,0,4"/>
                    <TextBox x:Name="PhraseTextBox"
                             MinHeight="28"
                             Margin="0,0,0,14"
                             TextChanged="RuleField_Changed"/>

                    <TextBlock Text="Text color" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <WrapPanel x:Name="TextColorSwatchesPanel" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <TextBox x:Name="ColorTextBox"
                                 Width="148"
                                 MinHeight="28"
                                 TextChanged="RuleField_Changed"
                                 LostFocus="RuleField_Changed"/>
                        <Button Content="Pick…"
                                Margin="8,0,0,0"
                                Padding="10,5"
                                MinHeight="28"
                                Style="{StaticResource ShellCommandBarSecondarySlot}"
                                Click="PickTextColorButton_Click"/>
                    </StackPanel>

                    <TextBlock Text="Background (optional)" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <WrapPanel x:Name="BackgroundColorSwatchesPanel" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <TextBox x:Name="BackgroundColorTextBox"
                                 Width="148"
                                 MinHeight="28"
                                 TextChanged="RuleField_Changed"
                                 LostFocus="RuleField_Changed"/>
                        <Button Content="Clear"
                                Margin="8,0,0,0"
                                Padding="10,5"
                                MinHeight="28"
                                Style="{StaticResource ShellCommandBarSecondarySlot}"
                                Click="ClearBackgroundButton_Click"/>
                        <Button Content="Pick…"
                                Margin="8,0,0,0"
                                Padding="10,5"
                                MinHeight="28"
                                Style="{StaticResource ShellCommandBarSecondarySlot}"
                                Click="PickBackgroundColorButton_Click"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <CheckBox x:Name="BoldCheckBox"
                                  Content="Bold"
                                  Margin="0,0,20,0"
                                  Checked="RuleField_Changed"
                                  Unchecked="RuleField_Changed"/>
                        <CheckBox x:Name="ItalicCheckBox"
                                  Content="Italic"
                                  Checked="RuleField_Changed"
                                  Unchecked="RuleField_Changed"/>
                    </StackPanel>

                    <TextBlock Text="Preview" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <Border Background="{StaticResource BgSurfaceBrush}"
                            BorderBrush="{StaticResource BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusControl}"
                            Padding="14,12"
                            Margin="0,0,0,8">
                        <TextBlock x:Name="PreviewTextBlock"
                                   Text="Sample phrase in continuous view"
                                   TextWrapping="Wrap"
                                   FontSize="14"
                                   LineHeight="22"/>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <TextBlock x:Name="ValidationTextBlock"
                   Grid.Row="3"
                   Foreground="{StaticResource ErrorBrush}"
                   TextWrapping="Wrap"
                   Margin="0,12,0,0"
                   Visibility="Collapsed"/>
    </Grid>
</UserControl>
