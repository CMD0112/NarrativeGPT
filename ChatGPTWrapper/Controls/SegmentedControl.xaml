<UserControl x:Class="ChatGPTWrapper.Controls.SegmentedControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             Focusable="False">
    <Border Style="{StaticResource ShellCardStyle}"
            CornerRadius="{DynamicResource RadiusControl}"
            Padding="2">
        <StackPanel x:Name="SegmentPanel" Orientation="Horizontal"/>
    </Border>
</UserControl>
