<UserControl x:Class="ChatGPTWrapper.Controls.StatusChip"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             Focusable="False">
    <Button x:Name="ChipButton"
            Style="{StaticResource StatusChipButtonStyle}"
            Click="ChipButton_Click"
            Padding="8,4"
            MinHeight="28"
            Cursor="Hand">
        <StackPanel Orientation="Horizontal">
            <TextBlock x:Name="LabelText"
                       Text="{Binding Label, ElementName=Root}"
                       VerticalAlignment="Center"/>
            <Border x:Name="CountBadge"
                    Style="{StaticResource ShellBadgeStyle}"
                    Margin="6,0,0,0"
                    Visibility="Collapsed">
                <TextBlock x:Name="CountText"
                           FontSize="10"
                           FontWeight="SemiBold"/>
            </Border>
        </StackPanel>
    </Button>
</UserControl>
