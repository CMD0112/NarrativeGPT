<Window
    x:Class="ChatGPTWrapper.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ChatGPTWrapper.WinUI.Controls"
    xmlns:views="using:ChatGPTWrapper.WinUI.Views">

    <Grid x:Name="RootGrid" Background="{ThemeResource BgBaseBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border x:Name="ShellChromeHost"
                Grid.Row="0"
                Background="{ThemeResource BgChromeBrush}"
                BorderBrush="{ThemeResource BorderSubtleBrush}"
                BorderThickness="0,0,0,1">
            <Grid RowSpacing="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="32" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid x:Name="TitleBarRow" Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="TitleBarLeftPaddingColumn" Width="0" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition x:Name="TitleBarRightPaddingColumn" Width="0" />
                    </Grid.ColumnDefinitions>

                    <Grid x:Name="TitleDragRegion"
                          Grid.Column="1"
                          Background="Transparent">
                        <TextBlock Text="ChatGPT Wrapper"
                                   Style="{ThemeResource ShellCaptionStyle}"
                                   Margin="12,0,0,0" />
                    </Grid>
                </Grid>

                <Grid Grid.Row="1"
                      Padding="{ThemeResource ShellChromePadding}"
                      ColumnSpacing="{ThemeResource SpaceSm}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <controls:SegmentedControl x:Name="AppModeSegment"
                                               Grid.Column="0"
                                               VerticalAlignment="Center"
                                               SelectionChanged="AppModeSegment_SelectionChanged" />

                    <views:SessionTopBar x:Name="SessionBar"
                                         Grid.Column="1"
                                         VerticalAlignment="Center"
                                         Visibility="Collapsed" />

                    <views:ViewCommandBar x:Name="ViewBar"
                                          Grid.Column="2"
                                          VerticalAlignment="Center" />
                </Grid>
            </Grid>
        </Border>

        <Grid x:Name="WorkspaceGrid"
              Grid.Row="1"
              Margin="12,4,12,12"
              Background="{ThemeResource BgSurfaceBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="CompanionColumn" Width="0" />
                <ColumnDefinition x:Name="WorkspaceSplitterColumn" Width="0" />
                <ColumnDefinition x:Name="ChatColumn" Width="*" />
            </Grid.ColumnDefinitions>

            <Frame x:Name="ContentFrame"
                   Grid.Column="0"
                   VerticalAlignment="Stretch"
                   HorizontalAlignment="Stretch" />

            <Border x:Name="PlaySplitterHost"
                    Grid.Column="1"
                    Background="Transparent"
                    Visibility="Collapsed"
                    Width="12"
                    HorizontalAlignment="Stretch">
                <FontIcon Glyph="&#xE76B;" FontSize="8" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>

            <Button x:Name="ExpandCompanionRail"
                    Grid.Column="1"
                    Width="10"
                    Visibility="Collapsed" />

            <views:ChatTabHost x:Name="ShellChatHost"
                               Grid.Column="2"
                               HorizontalAlignment="Stretch"
                               VerticalAlignment="Stretch"
                               Visibility="Visible" />
        </Grid>

        <Border x:Name="ShellStatusHost"
                Grid.Row="2"
                Background="{ThemeResource BgChromeBrush}"
                BorderBrush="{ThemeResource BorderSubtleBrush}"
                BorderThickness="0,1,0,0"
                Padding="12,6">
            <TextBlock x:Name="ShellStatusText"
                       Foreground="{ThemeResource TextMutedBrush}"
                       FontSize="{ThemeResource FontSizeHint}"
                       Text="Ready" />
        </Border>
    </Grid>
</Window>
