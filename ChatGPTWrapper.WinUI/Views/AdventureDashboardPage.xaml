<Page
    x:Class="ChatGPTWrapper.WinUI.Views.AdventureDashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ChatGPTWrapper.WinUI.Views">

    <Page.Resources>
        <MenuFlyout x:Key="AdventureContextMenu" Opening="AdventureContextFlyout_Opening">
            <MenuFlyoutItem Tag="Play" Text="Play" Click="CtxPlay_Click" />
            <MenuFlyoutItem Tag="LinkProject" Text="Link Project…" Click="CtxLinkProject_Click" />
            <MenuFlyoutItem Tag="ContinueDesign" Text="Continue design…" Click="CtxContinueDesign_Click" />
            <MenuFlyoutItem Tag="Rename" Text="Rename…" Click="Rename_Click" />
            <MenuFlyoutItem Tag="OpenFolder" Text="Open adventure folder" Click="CtxOpenFolder_Click" />
            <MenuFlyoutItem Tag="CreateFolder" Text="Create folder on disk…" Click="CtxCreateFolder_Click" />
            <MenuFlyoutItem Tag="Archive" Text="Archive" Click="CtxArchive_Click" />
            <MenuFlyoutItem Tag="Unarchive" Text="Unarchive" Click="CtxUnarchive_Click" />
            <MenuFlyoutItem Tag="Backup" Text="Backup selected" Click="Backup_Click" />
            <MenuFlyoutSeparator />
            <MenuFlyoutItem Tag="Delete" Text="Delete" Click="Delete_Click" />
        </MenuFlyout>
    </Page.Resources>

    <Grid RowSpacing="8" Padding="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <CommandBar Grid.Row="0"
                    x:Name="DashboardCommandBar"
                    DefaultLabelPosition="Collapsed"
                    Background="Transparent">
            <AppBarButton Icon="Add" Label="New" Click="NewAdventure_Click" />
            <AppBarButton Icon="Play" Label="Play" Click="Play_Click" />
            <AppBarButton Icon="Rename" Label="Rename" Click="Rename_Click" />
            <AppBarButton Icon="Delete" Label="Delete" Click="Delete_Click" />
            <AppBarButton Icon="SaveLocal" Label="Backup" Click="Backup_Click" />
            <AppBarButton Icon="Share" Label="Export" Click="Export_Click" />
            <AppBarButton Label="Archive" Click="Archive_Click">
                <AppBarButton.Icon>
                    <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE7B8;" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarSeparator />
            <AppBarButton Icon="Import" Label="Import" Click="Import_Click" />
            <AppBarButton Icon="Edit" Label="Design with AI" Click="DesignWithAi_Click" />
        </CommandBar>

        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="160" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <AutoSuggestBox x:Name="SearchBox"
                           Grid.Column="0"
                           PlaceholderText="Search adventures"
                           QuerySubmitted="SearchBox_QuerySubmitted"
                           TextChanged="SearchBox_TextChanged" />
            <ComboBox x:Name="GenreFilter"
                      Grid.Column="1"
                      PlaceholderText="Genre"
                      SelectionChanged="Filter_Changed" />
            <ComboBox x:Name="SortCombo"
                      Grid.Column="2"
                      SelectionChanged="Filter_Changed" />
            <ToggleSwitch x:Name="ArchivedToggle"
                          Grid.Column="3"
                          OffContent="Hide archived"
                          OnContent="Show archived"
                          Toggled="Filter_Changed" />
        </Grid>

        <Grid Grid.Row="2">
            <ListView x:Name="AdventureList"
                      SelectionMode="Extended"
                      IsItemClickEnabled="True"
                      ContextFlyout="{StaticResource AdventureContextMenu}"
                      RightTapped="AdventureList_RightTapped"
                      SelectionChanged="AdventureList_SelectionChanged">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:AdventureLibraryRowVm">
                        <Grid Padding="12"
                              Background="{ThemeResource Elevation1Brush}"
                              CornerRadius="{ThemeResource RadiusCard}"
                              Margin="0,0,0,8"
                              ColumnSpacing="12"
                              ContextFlyout="{StaticResource AdventureContextMenu}"
                              RightTapped="AdventureList_RightTapped">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock Text="{x:Bind Title}"
                                           FontWeight="SemiBold"
                                           FontSize="{ThemeResource FontSizeTitle}" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Border Background="{ThemeResource AccentSubtleBrush}"
                                            CornerRadius="4"
                                            Padding="6,2"
                                            Visibility="{x:Bind GenreVisibility}">
                                        <TextBlock Text="{x:Bind Genre}"
                                                   FontSize="{ThemeResource FontSizeHint}" />
                                    </Border>
                                    <TextBlock Text="{x:Bind LastPlayedRelative}"
                                               Foreground="{ThemeResource TextMutedBrush}"
                                               FontSize="{ThemeResource FontSizeHint}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Border Background="{ThemeResource WarningSubtleBrush}"
                                            CornerRadius="4"
                                            Padding="6,2"
                                            Visibility="{x:Bind LinkedBadgeVisibility}">
                                        <TextBlock Text="Linked" FontSize="{ThemeResource FontSizeHint}" />
                                    </Border>
                                    <Border Background="{ThemeResource AccentSubtleBrush}"
                                            CornerRadius="4"
                                            Padding="6,2"
                                            Visibility="{x:Bind DesigningBadgeVisibility}">
                                        <TextBlock Text="Designing" FontSize="{ThemeResource FontSizeHint}" />
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Content="Play"
                                    VerticalAlignment="Center"
                                    Click="RowPlay_Click"
                                    Tag="{x:Bind Id}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <StackPanel x:Name="EmptyStatePanel"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="12"
                        Visibility="Collapsed"
                        MaxWidth="420">
                <TextBlock x:Name="EmptyStateTitle"
                           Text="No adventures yet"
                           FontSize="20"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center" />
                <TextBlock x:Name="EmptyStateHint"
                           Text="Create a new adventure, import a backup, or start designing with AI."
                           TextWrapping="Wrap"
                           Foreground="{ThemeResource TextMutedBrush}"
                           HorizontalAlignment="Center"
                           HorizontalTextAlignment="Center" />
                <StackPanel x:Name="EmptyStateActions"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Spacing="8">
                    <Button Content="New adventure" Click="NewAdventure_Click" />
                    <Button Content="Import backup" Click="Import_Click" />
                    <Button Content="Design with AI" Click="DesignWithAi_Click" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="3"
                   x:Name="FooterHint"
                   Foreground="{ThemeResource TextMutedBrush}"
                   FontSize="{ThemeResource FontSizeHint}"
                   Text="Adventures stay on this device." />
    </Grid>
</Page>
