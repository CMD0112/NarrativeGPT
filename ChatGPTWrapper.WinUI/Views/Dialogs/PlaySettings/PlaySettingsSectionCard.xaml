<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ChatGPTWrapper.WinUI.Views.Dialogs.PlaySettings.PlaySettingsSectionCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ChatGPTWrapper.WinUI.Controls">

    <Border Style="{ThemeResource ShellCardStyle}">
        <StackPanel Spacing="10">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock x:Name="TitleBlock"
                               Style="{ThemeResource ShellSectionHeaderStyle}"
                               FontSize="{ThemeResource FontSizeBody}" />
                    <TextBlock x:Name="HintBlock"
                               Style="{ThemeResource ShellSectionHintStyle}"
                               Visibility="Collapsed" />
                </StackPanel>
                <controls:ScopeBadgeView x:Name="ScopeBadgeControl"
                                         Grid.Column="1"
                                         VerticalAlignment="Top"
                                         ScopeLabel="{x:Bind ScopeLabel, Mode=OneWay}" />
            </Grid>
            <ContentPresenter x:Name="BodyHost" />
        </StackPanel>
    </Border>
</UserControl>
