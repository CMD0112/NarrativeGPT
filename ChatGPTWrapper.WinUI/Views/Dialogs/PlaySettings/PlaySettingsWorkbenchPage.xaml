<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ChatGPTWrapper.WinUI.Views.Dialogs.PlaySettings.PlaySettingsWorkbenchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ChatGPTWrapper.WinUI.Views.Dialogs.PlaySettings"
    xmlns:controls="using:ChatGPTWrapper.WinUI.Controls"
    MinHeight="560"
    MinWidth="720">

    <UserControl.Resources>
        <DataTemplate x:Key="PlaySettingsNavTemplate" x:DataType="local:PlaySettingsNavItem">
            <Border x:Name="NavBackground"
                    Background="Transparent"
                    CornerRadius="{ThemeResource RadiusControl}"
                    Padding="8,6">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="SelectionBar"
                            Grid.Column="0"
                            Background="{ThemeResource AccentPrimaryBrush}"
                            CornerRadius="2"
                            Opacity="0" />
                    <StackPanel Grid.Column="1" Spacing="2">
                        <Grid ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind Label}"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />
                            <controls:ScopeBadgeView Grid.Column="1"
                                                     ScopeLabel="{x:Bind ScopeLabel}"
                                                     VerticalAlignment="Center"
                                                     HorizontalAlignment="Right"
                                                     Margin="0" />
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="PlaySettingsNavHeaderTemplate" x:DataType="local:PlaySettingsNavItem">
            <TextBlock Text="{x:Bind Label}"
                       Style="{ThemeResource ShellSectionHintStyle}"
                       FontWeight="SemiBold"
                       Margin="10,10,10,4"
                       CharacterSpacing="60"
                       Opacity="0.9" />
        </DataTemplate>

        <local:PlaySettingsNavTemplateSelector x:Key="PlaySettingsNavSelector"
                                               HeaderTemplate="{StaticResource PlaySettingsNavHeaderTemplate}"
                                               ItemTemplate="{StaticResource PlaySettingsNavTemplate}" />
    </UserControl.Resources>

    <Grid RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Padding="18,14"
                Background="{ThemeResource BgElevatedBrush}"
                BorderBrush="{ThemeResource BorderSubtleBrush}"
                BorderThickness="0,0,0,1">
            <Grid ColumnSpacing="12" RowSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="Play settings"
                                   Style="{ThemeResource ShellSectionHeaderStyle}" />
                        <Border x:Name="InjectionPresetChip"
                                Style="{ThemeResource ShellBadgeStyle}"
                                Margin="0"
                                Visibility="Collapsed">
                            <TextBlock x:Name="InjectionPresetChipText" FontSize="10" />
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="AdventureTitleLine"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource TextPrimaryBrush}" />
                    <TextBlock x:Name="HeaderHintText"
                               Text="Tune what goes out on Send, what persists in your adventure, and how the play surface behaves. Disk writes happen on Save."
                               Style="{ThemeResource ShellSectionHintStyle}" />
                </StackPanel>
                <Border Grid.Column="1"
                        x:Name="DirtyBadge"
                        Style="{ThemeResource ShellBadgeStyle}"
                        Background="{ThemeResource WarningSubtleBrush}"
                        VerticalAlignment="Top"
                        Visibility="Collapsed">
                    <TextBlock Text="Unsaved"
                               FontSize="11"
                               FontWeight="SemiBold" />
                </Border>
            </Grid>
        </Border>

        <!-- Body -->
        <Grid x:Name="BodyGrid" Grid.Row="1" ColumnSpacing="0" SizeChanged="BodyGrid_SizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="NavColumnDefinition" Width="220" MinWidth="196" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="360" />
            </Grid.ColumnDefinitions>

            <!-- Navigation rail -->
            <Grid Grid.Column="0" Background="{ThemeResource BgSurfaceBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Padding="10,10,10,6"
                        BorderBrush="{ThemeResource BorderSubtleBrush}"
                        BorderThickness="0,0,0,1">
                    <TextBox x:Name="NavSearchBox"
                             PlaceholderText="Filter settings…"
                             TextChanged="NavSearchBox_TextChanged" />
                </Border>
                <ListView x:Name="SettingsNavList"
                          Grid.Row="1"
                          Padding="4,6,4,8"
                          SelectionMode="Single"
                          IsItemClickEnabled="True"
                          ItemContainerStyle="{ThemeResource PlaySettingsNavItemStyle}"
                          ItemTemplateSelector="{StaticResource PlaySettingsNavSelector}"
                          SelectionChanged="SettingsNavList_SelectionChanged" />
            </Grid>

            <Border Grid.Column="1" Width="1" Background="{ThemeResource BorderSubtleBrush}" />

            <!-- Settings content -->
            <ScrollViewer x:Name="SettingsScrollViewer"
                          Grid.Column="2"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="18,14">
                <StackPanel x:Name="SectionContentPanel"
                            Spacing="4"
                            HorizontalAlignment="Left">
                    <StackPanel x:Name="SectionHeaderPanel" Spacing="4" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock x:Name="SectionTitleText"
                                       Style="{ThemeResource ShellSectionHeaderStyle}" />
                            <controls:ScopeBadgeView x:Name="SectionScopeBadge"
                                                     Margin="0" />
                        </StackPanel>
                        <TextBlock x:Name="SectionHintText"
                                   Style="{ThemeResource ShellSectionHintStyle}" />
                    </StackPanel>
                    <ContentPresenter x:Name="SettingsContentHost" HorizontalAlignment="Stretch" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="2"
                Padding="18,10"
                Background="{ThemeResource BgElevatedBrush}"
                BorderBrush="{ThemeResource BorderSubtleBrush}"
                BorderThickness="0,1,0,0">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon x:Name="SaveStatusIcon"
                              Glyph="&#xE73E;"
                              FontSize="14"
                              Foreground="{ThemeResource TextMutedBrush}"
                              VerticalAlignment="Center" />
                    <TextBlock x:Name="PlaySettingsSaveLine"
                               VerticalAlignment="Center"
                               Style="{ThemeResource ShellSectionHintStyle}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                    <TextBlock x:Name="EditCountLine"
                               VerticalAlignment="Center"
                               Style="{ThemeResource ShellSectionHintStyle}"
                               Visibility="Collapsed" />
                    <ItemsControl x:Name="DirtyEditsPanel" Visibility="Collapsed">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="6" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
