<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ChatGPTWrapper.WinUI.Views.Dialogs.PlaySettings.PlaySettingsMemoryCardsTab"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ChatGPTWrapper.WinUI.Views.Dialogs.PlaySettings">
    <Grid>
        <local:PlaySettingsSectionCard Title="Pinned memory"
                                       Hint="Accepted facts included in play packets when injection policy allows. Story cards are retired — use entities and section injection instead."
                                       ScopeLabel="Persistent">
            <StackPanel Spacing="10">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Suggest (AI)" Style="{ThemeResource ShellGhostButtonStyle}" Click="SuggestMemories_Click" />
                    <Button Content="Review all…" Style="{ThemeResource ShellGhostButtonStyle}" Tag="Memory" Click="ReviewAll_Click" />
                </StackPanel>
                <ListView x:Name="MemoryList" MinHeight="180" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnSpacing="8" Padding="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE718;" FontSize="12" Opacity="{Binding PinOpacity}" />
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" MaxLines="3" />
                                    <TextBlock Text="{Binding Subtitle}" Style="{ThemeResource ShellSectionHintStyle}" FontSize="10" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock x:Name="MemoryReviewHeader" Style="{ThemeResource ShellSectionHintStyle}" />
                <ListView x:Name="MemoryReviewList" MinHeight="80" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Spacing="2" Padding="0,4">
                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" MaxLines="2" />
                                <TextBlock Text="Awaiting review" Style="{ThemeResource ShellSectionHintStyle}" FontSize="10" Foreground="{ThemeResource WarningBrush}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </local:PlaySettingsSectionCard>
    </Grid>
</UserControl>
