<?xml version="1.0" encoding="utf-8"?>

<UserControl

    x:Class="ChatGPTWrapper.WinUI.Views.Dialogs.PlaySettings.PlaySettingsHistoryTab"

    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

    xmlns:local="using:ChatGPTWrapper.WinUI.Views.Dialogs.PlaySettings">

    <Grid ColumnSpacing="12">

        <Grid.ColumnDefinitions>

            <ColumnDefinition Width="280" MinWidth="220" />

            <ColumnDefinition Width="*" />

        </Grid.ColumnDefinitions>



        <local:PlaySettingsSectionCard Grid.Column="0"

                                       Title="Timeline"

                                       Hint="Flight recorder for prior sends."

                                       ScopeLabel="Read-only">

            <ListView x:Name="TimelineList" MinHeight="360" SelectionChanged="TimelineList_SelectionChanged" />

        </local:PlaySettingsSectionCard>



        <local:PlaySettingsSectionCard Grid.Column="1"

                                       Title="Send detail"

                                       Hint="Manifest summary and packet excerpt for the selected send."

                                       ScopeLabel="Read-only">

            <ScrollViewer VerticalScrollBarVisibility="Auto">

                <StackPanel x:Name="DetailPanel" Spacing="10" Visibility="Collapsed">

                    <TextBlock x:Name="DetailHeaderText" Style="{ThemeResource ShellSectionHeaderStyle}" TextWrapping="Wrap" />

                    <TextBlock x:Name="LogTurnLinkText" TextWrapping="Wrap" Style="{ThemeResource ShellSectionHintStyle}" />

                    <TextBlock Text="Manifest summary" Style="{ThemeResource ShellFormFieldLabelStyle}" />

                    <TextBlock x:Name="ManifestSummaryText" TextWrapping="Wrap" Style="{ThemeResource ShellSectionHintStyle}" />

                    <TextBlock Text="Packet excerpt" Style="{ThemeResource ShellFormFieldLabelStyle}" />

                    <TextBox x:Name="PacketExcerptBox"

                             Style="{ThemeResource PlaySettingsCodeBoxStyle}"

                             IsReadOnly="True"

                             MinHeight="200" />

                </StackPanel>

            </ScrollViewer>

        </local:PlaySettingsSectionCard>

    </Grid>

</UserControl>

