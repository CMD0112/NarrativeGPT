<?xml version="1.0" encoding="utf-8"?>

<UserControl

    x:Class="ChatGPTWrapper.WinUI.Views.Dialogs.PlaySettings.PlaySettingsNextSendTab"

    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

    xmlns:local="using:ChatGPTWrapper.WinUI.Views.Dialogs.PlaySettings">

    <StackPanel Spacing="12">

        <Border Style="{ThemeResource ShellCardStyle}"

                Background="{ThemeResource BgElevatedBrush}"

                Padding="12,10">

            <StackPanel Orientation="Horizontal" Spacing="8">

                <FontIcon Glyph="&#xE946;" FontSize="14" Foreground="{ThemeResource AccentPrimaryBrush}" />

                <TextBlock TextWrapping="Wrap"

                           Style="{ThemeResource ShellSectionHintStyle}"

                           Text="Send precedence: 1) in-page composer → 2) fallback player line (Packet preview) → 3) continuation queue (consumed on Send)." />

            </StackPanel>

        </Border>



        <local:PlaySettingsSectionCard Title="Continuation queue"

                                       Hint="One line per queued player input. The first line is consumed when you Send."

                                       ScopeLabel="This send">

            <StackPanel Spacing="10">

                <TextBox x:Name="QueueBox"

                         AcceptsReturn="True"

                         TextWrapping="Wrap"

                         MinHeight="72"

                         PlaceholderText="Line 1&#x0a;Line 2&#x0a;…"

                         TextChanged="OnChanged"

                         LostFocus="OnChanged" />

                <HyperlinkButton Content="Edit fallback player line in Packet preview →"

                                 Click="GoToPreview_Click"

                                 Padding="0"

                                 FontSize="12" />

            </StackPanel>

        </local:PlaySettingsSectionCard>



        <local:PlaySettingsSectionCard Title="Turn overrides"

                                       Hint="Injected once into the next packet only."

                                       ScopeLabel="Next send">

            <StackPanel Spacing="10">

                <Grid ColumnSpacing="12" RowSpacing="10">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="120" />

                        <ColumnDefinition Width="*" />

                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto" />

                        <RowDefinition Height="Auto" />

                        <RowDefinition Height="Auto" />

                        <RowDefinition Height="Auto" />

                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Response length" VerticalAlignment="Center" Style="{ThemeResource ShellSectionHintStyle}" />

                    <ComboBox x:Name="TurnOverrideResponseLengthCombo" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Stretch" SelectionChanged="OnChanged" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Detail level" VerticalAlignment="Center" Style="{ThemeResource ShellSectionHintStyle}" />

                    <ComboBox x:Name="TurnOverrideDetailLevelCombo" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" SelectionChanged="OnChanged" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Tone" VerticalAlignment="Center" Style="{ThemeResource ShellSectionHintStyle}" />

                    <ComboBox x:Name="TurnOverrideToneCombo" Grid.Row="2" Grid.Column="1" IsEditable="True" HorizontalAlignment="Stretch" SelectionChanged="OnChanged" LostFocus="OnChanged" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Difficulty" VerticalAlignment="Center" Style="{ThemeResource ShellSectionHintStyle}" />

                    <ComboBox x:Name="TurnOverrideDifficultyCombo" Grid.Row="3" Grid.Column="1" IsEditable="True" HorizontalAlignment="Stretch" SelectionChanged="OnChanged" LostFocus="OnChanged" />

                </Grid>

                <StackPanel Orientation="Horizontal" Spacing="8">

                    <Button Content="Reset turn overrides"

                            Style="{ThemeResource ShellGhostButtonStyle}"

                            Click="ResetTurnOverrides_Click" />

                    <Button Content="Copy repair packet"

                            Style="{ThemeResource ShellGhostButtonStyle}"

                            Click="CopyRepairPacket_Click" />

                </StackPanel>

            </StackPanel>

        </local:PlaySettingsSectionCard>

    </StackPanel>

</UserControl>

