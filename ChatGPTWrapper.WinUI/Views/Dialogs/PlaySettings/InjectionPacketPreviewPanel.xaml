<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ChatGPTWrapper.WinUI.Views.Dialogs.PlaySettings.InjectionPacketPreviewPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Border x:Name="EmptyStatePanel"
                Style="{ThemeResource ShellCardStyle}"
                Background="{ThemeResource BgElevatedBrush}"
                Padding="16">
            <StackPanel Spacing="8" VerticalAlignment="Center" HorizontalAlignment="Center">
                <FontIcon Glyph="&#xE8A5;" FontSize="28" Foreground="{ThemeResource TextMutedBrush}" HorizontalAlignment="Center" />
                <TextBlock x:Name="DelegationBadgeText" Text="No preview" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock x:Name="EmptyStateText"
                           Text="Enter a sample player line to preview the injected packet."
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           MaxWidth="280"
                           Style="{ThemeResource ShellSectionHintStyle}" />
            </StackPanel>
        </Border>

        <StackPanel x:Name="SummaryPanel" Spacing="10" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Border Style="{ThemeResource ShellBadgeStyle}">
                    <TextBlock x:Name="ModeBadgeText" FontSize="10" />
                </Border>
                <Border Style="{ThemeResource ShellBadgeStyle}">
                    <TextBlock x:Name="HashBadgeText" FontSize="10" />
                </Border>
                <Border x:Name="TrimmedBadge"
                        Style="{ThemeResource ShellBadgeStyle}"
                        Background="{ThemeResource WarningSubtleBrush}"
                        Visibility="Collapsed">
                    <TextBlock Text="Trimmed" FontSize="10" FontWeight="SemiBold" />
                </Border>
            </StackPanel>
            <ProgressBar x:Name="CharBudgetBar" Maximum="1" Height="8" CornerRadius="4" />
            <TextBlock x:Name="CharBudgetLabel" Style="{ThemeResource ShellSectionHintStyle}" />
            <TextBlock x:Name="MetaLineText" TextWrapping="Wrap" Style="{ThemeResource ShellSectionHintStyle}" />
            <TextBlock Text="Sections" Style="{ThemeResource ShellFormFieldLabelStyle}" />
            <ListView x:Name="SectionList"
                      MinHeight="72"
                      MaxHeight="140"
                      SelectionMode="Single"
                      ItemContainerStyle="{ThemeResource PlaySettingsNavItemStyle}" />
            <Expander x:Name="DeltaExpander" Header="Changes since last refresh" IsExpanded="False">
                <ListView x:Name="DeltaList" MinHeight="48" />
            </Expander>
            <Expander x:Name="PacketBodyExpander" Header="Packet body" IsExpanded="True">
                <TextBox x:Name="PacketBodyBox"
                         Style="{ThemeResource PlaySettingsCodeBoxStyle}"
                         IsReadOnly="True"
                         MinHeight="160" />
            </Expander>
        </StackPanel>
    </Grid>
</UserControl>
