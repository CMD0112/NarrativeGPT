<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ChatGPTWrapper.WinUI.Views.Dialogs.ProjectWorkspacePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="280" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="IntroLine"
                   Grid.Row="0"
                   TextWrapping="WrapWholeWords"
                   Text="Pick or create a ChatGPT Project below, then Link or Switch." />

        <TabView x:Name="WorkspaceTabs" Grid.Row="1" SelectionChanged="WorkspaceTabs_SelectionChanged">
            <TabViewItem Header="Projects" x:Name="ProjectsTab">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="10" Padding="4">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="RefreshProjectsButton" Content="Refresh" Click="RefreshProjects_Click" />
                            <TextBlock x:Name="DiscoveryLine" VerticalAlignment="Center" Style="{ThemeResource ShellSectionHintStyle}" />
                        </StackPanel>
                        <TextBlock x:Name="SessionHintLine" TextWrapping="WrapWholeWords" FontSize="11" Style="{ThemeResource ShellSectionHintStyle}" />
                        <Grid x:Name="LinkedProjectBannerPanel" Visibility="Collapsed" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="LinkedProjectBanner" TextWrapping="WrapWholeWords" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="Unlink…" Click="UnlinkProject_Click" />
                        </Grid>

                        <TabView x:Name="ProjectModeTabs" TabWidthMode="Equal" SelectionChanged="ProjectModeTabs_SelectionChanged">
                            <TabViewItem Header="From list">
                                <StackPanel Spacing="6">
                                    <TextBlock x:Name="SelectedProjectLine" TextWrapping="WrapWholeWords" Style="{ThemeResource ShellSectionHintStyle}" />
                                    <ListView x:Name="ProjectList"
                                              MinHeight="160"
                                              SelectionMode="Single"
                                              DisplayMemberPath="Title"
                                              SelectionChanged="ProjectList_SelectionChanged"
                                              DoubleTapped="ProjectList_DoubleTapped" />
                                </StackPanel>
                            </TabViewItem>
                            <TabViewItem Header="Create new">
                                <StackPanel Spacing="6" Padding="4">
                                    <TextBlock Text="Project name" Style="{ThemeResource ShellFormFieldLabelStyle}" />
                                    <TextBox x:Name="NewProjectNameBox" TextChanged="NewProjectNameBox_TextChanged" />
                                </StackPanel>
                            </TabViewItem>
                            <TabViewItem Header="Advanced: URL">
                                <StackPanel Spacing="6" Padding="4">
                                    <TextBlock Text="Paste Project URL or gizmo id" Style="{ThemeResource ShellFormFieldLabelStyle}" />
                                    <TextBox x:Name="ManualUrlBox" TextChanged="ManualUrlBox_TextChanged" />
                                    <TextBlock Text="Example: https://chatgpt.com/g/g-p-…/project or g-p-…"
                                               FontSize="11"
                                               TextWrapping="WrapWholeWords"
                                               Style="{ThemeResource ShellSectionHintStyle}" />
                                </StackPanel>
                            </TabViewItem>
                        </TabView>

                        <CheckBox x:Name="SyncSourcesCheck" Content="Export and sync sources via API (advanced)" IsChecked="False" />
                        <TextBlock Text="Default: manual publish — export locally, then copy/drag to ChatGPT Project on the Sources tab."
                                   FontSize="11"
                                   TextWrapping="WrapWholeWords"
                                   Style="{ThemeResource ShellSectionHintStyle}" />
                        <CheckBox x:Name="UpdateInstructionsCheck" Content="Push narrator instructions from scenario" IsChecked="False" />
                        <CheckBox x:Name="CreateThreadCheck" Content="Create or pick play thread in Project" IsChecked="True" />
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>

            <TabViewItem Header="Connection">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="8" Padding="4">
                        <TextBlock Text="Session checklist" FontWeight="SemiBold" />
                        <TextBlock x:Name="CheckSignedIn" />
                        <TextBlock x:Name="CheckDeviceId" />
                        <TextBlock x:Name="CheckAccountId" Style="{ThemeResource ShellSectionHintStyle}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="TestConnectionButton" Content="Test connection" Click="TestConnection_Click" />
                            <Button Content="Capture headers hint" Click="CaptureHeaders_Click" />
                        </StackPanel>
                        <TextBlock x:Name="ProbeLine" TextWrapping="WrapWholeWords" Style="{ThemeResource ShellSectionHintStyle}" />
                        <TextBlock x:Name="LinkHealthLine" TextWrapping="WrapWholeWords" Style="{ThemeResource ShellSectionHintStyle}" />
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>

            <TabViewItem Header="Sources" x:Name="SourcesTab">
                <StackPanel Spacing="8" Padding="4">
                    <TextBlock x:Name="SyncStatusLine" TextWrapping="WrapWholeWords" Style="{ThemeResource ShellSectionHintStyle}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Manage sources…" Click="ManageSources_Click" />
                        <Button Content="Copy instructions" Click="CopyInstructions_Click" />
                        <Button Content="Open sources folder" Click="OpenSourcesFolder_Click" />
                        <Button Content="Refresh export" Click="RefreshExport_Click" />
                    </StackPanel>
                    <TextBlock x:Name="ManualPublishGuideLine" TextWrapping="WrapWholeWords" FontSize="11" Style="{ThemeResource ShellSectionHintStyle}" />
                </StackPanel>
            </TabViewItem>
        </TabView>

        <StackPanel Grid.Row="2" Spacing="4">
            <TextBlock x:Name="StatusLine" TextWrapping="WrapWholeWords" Style="{ThemeResource ShellSectionHintStyle}" />
            <TextBlock x:Name="ErrorLine" TextWrapping="WrapWholeWords" Foreground="{ThemeResource ErrorBrush}" />
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Content="Copy diagnostics" Click="CopyDiagnostics_Click" />
            <Button x:Name="LinkButton" Content="Link project" Style="{ThemeResource ShellPrimaryButtonStyle}" Click="Link_Click" />
        </StackPanel>
    </Grid>
</UserControl>
