<UserControl
    x:Class="ChatGPTWrapper.WinUI.Views.Dialogs.EntityMergePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Spacing="12" MaxWidth="520">
        <TextBlock Text="Merge the selected entity into another. Mentions will rewrite to the target name; the source entity will be removed."
                   TextWrapping="WrapWholeWords" />
        <TextBlock Text="Source" Style="{ThemeResource ShellFormFieldLabelStyle}" />
        <TextBlock x:Name="SourceNameBlock" FontWeight="SemiBold" />
        <TextBlock Text="Merge into" Style="{ThemeResource ShellFormFieldLabelStyle}" />
        <ComboBox x:Name="TargetCombo"
                  HorizontalAlignment="Stretch"
                  DisplayMemberPath="Name"
                  SelectionChanged="TargetCombo_SelectionChanged" />
        <TextBlock x:Name="PreviewBlock"
                   Style="{ThemeResource ShellSectionHintStyle}"
                   TextWrapping="WrapWholeWords" />
    </StackPanel>
</UserControl>
