<UserControl
    x:Class="ChatGPTWrapper.WinUI.Views.Dialogs.EntityEditPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto" MinWidth="480" MaxHeight="640">
        <StackPanel Spacing="14" Padding="4,0,4,8">
            <TextBlock x:Name="TypeLine"
                       Style="{ThemeResource ShellSectionHintStyle}"
                       TextWrapping="Wrap" />

            <StackPanel Spacing="6">
                <TextBlock Text="Name"
                           Style="{ThemeResource ShellFormFieldLabelStyle}" />
                <TextBox x:Name="NameBox" />
            </StackPanel>

            <StackPanel x:Name="SecondaryPanel" Spacing="6">
                <TextBlock x:Name="SecondaryLabel"
                           Style="{ThemeResource ShellFormFieldLabelStyle}" />
                <TextBox x:Name="SecondaryBox" />
            </StackPanel>

            <StackPanel Spacing="6">
                <TextBlock Text="Description"
                           Style="{ThemeResource ShellFormFieldLabelStyle}" />
                <TextBox x:Name="DescriptionBox"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         MinHeight="96" />
            </StackPanel>

            <CheckBox x:Name="PinnedCheck"
                      Content="Pin in reference list"
                      Visibility="Collapsed" />

            <StackPanel x:Name="QuestStatusPanel" Spacing="6" Visibility="Collapsed">
                <TextBlock Text="Quest status"
                           Style="{ThemeResource ShellFormFieldLabelStyle}" />
                <ComboBox x:Name="QuestStatusBox" HorizontalAlignment="Stretch" />
            </StackPanel>

            <StackPanel x:Name="TagsPanel" Spacing="6" Visibility="Collapsed">
                <TextBlock Text="Tags"
                           Style="{ThemeResource ShellFormFieldLabelStyle}" />
                <TextBox x:Name="TagsBox"
                         PlaceholderText="Comma-separated tags" />
            </StackPanel>

            <StackPanel x:Name="AliasesPanel" Spacing="6" Visibility="Collapsed">
                <TextBlock Text="Aliases"
                           Style="{ThemeResource ShellFormFieldLabelStyle}" />
                <TextBox x:Name="AliasesBox"
                         PlaceholderText="Comma-separated aliases" />
            </StackPanel>

            <StackPanel x:Name="ExtraFieldsPanel" Spacing="12" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
