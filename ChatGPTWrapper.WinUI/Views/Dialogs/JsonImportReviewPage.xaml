<UserControl
    x:Class="ChatGPTWrapper.WinUI.Views.Dialogs.JsonImportReviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    MinWidth="720"
    MinHeight="480">

    <Grid Padding="8" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="280" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="StatusLine"
                   Style="{ThemeResource ShellSectionHintStyle}"
                   TextWrapping="WrapWholeWords" />

        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="220" />
                <ColumnDefinition Width="2*" MinWidth="280" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{ThemeResource ShellCardStyle}" Padding="4">
                <ListView x:Name="ProposalList"
                          SelectionChanged="ProposalList_SelectionChanged" />
            </Border>

            <Border Grid.Column="1" Style="{ThemeResource ShellCardStyle}" Padding="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="8">
                        <TextBlock x:Name="DetailPlaceholder"
                                   Style="{ThemeResource ShellSectionHintStyle}"
                                   Text="Select a proposal to review." />
                        <TextBlock x:Name="DetailSummary" TextWrapping="WrapWholeWords" Visibility="Collapsed" />
                        <TextBlock x:Name="DetailConflict" TextWrapping="WrapWholeWords" Visibility="Collapsed" />
                        <TextBlock x:Name="DetailProposedLabel" Style="{ThemeResource ShellFormFieldLabelStyle}" Visibility="Collapsed" />
                        <TextBox x:Name="DetailProposed" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" Visibility="Collapsed" />
                        <TextBlock x:Name="DetailPriorLabel" Style="{ThemeResource ShellFormFieldLabelStyle}" Visibility="Collapsed" />
                        <TextBox x:Name="DetailPrior" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" Visibility="Collapsed" />
                        <TextBlock x:Name="DetailRationaleLabel" Style="{ThemeResource ShellFormFieldLabelStyle}" Visibility="Collapsed" />
                        <TextBox x:Name="DetailRationale" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" Visibility="Collapsed" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button x:Name="AcceptSelectedButton" Content="Accept selected" Click="AcceptSelected_Click" />
            <Button x:Name="RejectSelectedButton" Content="Reject selected" Click="RejectSelected_Click" />
            <Button x:Name="AcceptAllButton" Content="Accept all" Click="AcceptAll_Click" />
            <Button x:Name="RejectAllButton" Content="Reject all" Click="RejectAll_Click" />
        </StackPanel>
    </Grid>
</UserControl>
