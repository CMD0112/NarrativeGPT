<UserControl
    x:Class="ChatGPTWrapper.WinUI.Views.Dialogs.ProposalReviewHubPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    MinWidth="720"
    MinHeight="480">

    <Grid Padding="16" RowSpacing="8">
        <Grid.Resources>
            <DataTemplate x:Key="CategoryItemTemplate">
                <StackPanel Orientation="Horizontal" Spacing="0" Padding="4,2">
                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                    <TextBlock Text=" (" Foreground="{ThemeResource TextMutedBrush}" />
                    <TextBlock Text="{Binding Count}" Foreground="{ThemeResource TextMutedBrush}" />
                    <TextBlock Text=")" Foreground="{ThemeResource TextMutedBrush}" />
                </StackPanel>
            </DataTemplate>
            <DataTemplate x:Key="ReviewItemTemplate">
                <StackPanel Spacing="2" Padding="4,4">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Preview}"
                               Foreground="{ThemeResource TextMutedBrush}"
                               FontSize="11"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Subtitle}"
                               Foreground="{ThemeResource TextMutedBrush}"
                               FontSize="10"
                               TextWrapping="Wrap" />
                </StackPanel>
            </DataTemplate>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="280" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Style="{ThemeResource ShellSectionHintStyle}"
                   TextWrapping="Wrap"
                   Text="Review AI job results in one place — accept to apply, dismiss to discard. Dual-run jobs tag proposals by source (Local LLM vs ChatGPT) and appear under Dual-run compare for side-by-side raw output." />

        <TextBlock x:Name="StatusLine"
                   Grid.Row="1"
                   Style="{ThemeResource ShellSectionHintStyle}"
                   TextWrapping="Wrap" />

        <Grid Grid.Row="2" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160" MinWidth="140" />
                <ColumnDefinition Width="*" MinWidth="200" />
                <ColumnDefinition Width="2*" MinWidth="260" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Style="{ThemeResource ShellCardStyle}"
                    Padding="4">
                <ListView x:Name="CategoryList"
                          ItemTemplate="{StaticResource CategoryItemTemplate}"
                          SelectionChanged="CategoryList_SelectionChanged" />
            </Border>

            <Border Grid.Column="1"
                    Style="{ThemeResource ShellCardStyle}"
                    Padding="4">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel x:Name="SourceFilterPanel"
                                Orientation="Horizontal"
                                Spacing="8">
                        <TextBlock Text="Source:" VerticalAlignment="Center" />
                        <ComboBox x:Name="SourceFilterCombo"
                                  MinWidth="140"
                                  SelectionChanged="SourceFilterCombo_SelectionChanged" />
                    </StackPanel>
                    <ListView x:Name="ItemList"
                              Grid.Row="1"
                              ItemTemplate="{StaticResource ReviewItemTemplate}"
                              SelectionChanged="ItemList_SelectionChanged" />
                </Grid>
            </Border>

            <Border Grid.Column="2"
                    Style="{ThemeResource ShellCardStyle}">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="DetailPlaceholder"
                               Style="{ThemeResource ShellSectionHintStyle}"
                               Text="Select a category and proposal to inspect details."
                               TextWrapping="Wrap" />
                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto">
                        <TextBox x:Name="DetailBox"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 FontFamily="Consolas"
                                 FontSize="12" />
                    </ScrollViewer>
                    <StackPanel Grid.Row="2"
                                Orientation="Horizontal"
                                Spacing="8">
                        <Button x:Name="AcceptButton"
                                Content="Accept"
                                Style="{ThemeResource ShellPrimaryButtonStyle}"
                                Click="Accept_Click" />
                        <Button x:Name="DismissButton"
                                Content="Dismiss"
                                Style="{ThemeResource ShellGhostButtonStyle}"
                                Click="Dismiss_Click" />
                        <Button x:Name="AcceptAllButton"
                                Content="Accept all in category"
                                Style="{ThemeResource ShellGhostButtonStyle}"
                                Click="AcceptAll_Click" />
                        <Button x:Name="DismissAllButton"
                                Content="Dismiss all in category"
                                Style="{ThemeResource ShellGhostButtonStyle}"
                                Click="DismissAll_Click" />
                        <Button x:Name="DetailedReviewButton"
                                Content="Detailed JSON review…"
                                Style="{ThemeResource ShellGhostButtonStyle}"
                                Visibility="Collapsed"
                                Click="DetailedReview_Click" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
