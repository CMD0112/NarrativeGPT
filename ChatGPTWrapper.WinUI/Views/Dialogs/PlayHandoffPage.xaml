<UserControl
    x:Class="ChatGPTWrapper.WinUI.Views.Dialogs.PlayHandoffPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    MinWidth="640"
    MinHeight="420">

    <Grid RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Style="{ThemeResource ShellSectionHintStyle}"
                   TextWrapping="WrapWholeWords"
                   Text="Review carry-forward context, release the current play thread, and paste a handoff packet into a new Project chat to continue your story." />

        <TabView x:Name="WizardTabs" Grid.Row="1" TabWidthMode="Equal">
            <TabViewItem Header="1. Review">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="12" Padding="8">
                        <TextBlock Text="Handoff mode" Style="{ThemeResource ShellFormFieldLabelStyle}" />
                        <ComboBox x:Name="HandoffModeCombo" HorizontalAlignment="Stretch"
                                  SelectionChanged="HandoffSettings_Changed">
                            <ComboBoxItem Content="Summary only" Tag="SummaryOnly" />
                            <ComboBoxItem Content="Summary + recent transcript (6 turns)" Tag="SummaryWithTranscript" IsSelected="True" />
                            <ComboBoxItem Content="Extended transcript (12 turns)" Tag="ExtendedTranscript" />
                        </ComboBox>
                        <TextBlock Text="Carry-forward summary" Style="{ThemeResource ShellFormFieldLabelStyle}" />
                        <TextBox x:Name="SummaryBox"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="100"
                                 TextChanged="HandoffSettings_Changed" />
                        <TextBlock x:Name="MetaLine"
                                   FontFamily="Consolas"
                                   FontSize="11"
                                   TextWrapping="WrapWholeWords" />
                        <TextBlock Text="Packet preview" Style="{ThemeResource ShellFormFieldLabelStyle}" />
                        <TextBox x:Name="PacketPreviewBox"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 FontFamily="Consolas"
                                 MinHeight="180" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Copy packet" Click="Copy_Click" />
                            <Button Content="Refresh preview" Click="RefreshPreview_Click" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>
            <TabViewItem Header="2. Rotate">
                <StackPanel Spacing="12" Padding="8">
                    <TextBlock TextWrapping="WrapWholeWords"
                               Text="Release the current play thread and copy the handoff packet to your clipboard. Then create a new Project chat and paste it as the first message." />
                    <TextBlock x:Name="NewThreadStatusLine"
                               Style="{ThemeResource ShellSectionHintStyle}"
                               TextWrapping="WrapWholeWords" />
                    <Button x:Name="CreateNewThreadButton"
                            Content="Hand off to new chat…"
                            HorizontalAlignment="Left"
                            Click="CreateNewThread_Click" />
                </StackPanel>
            </TabViewItem>
            <TabViewItem Header="3. Verify">
                <StackPanel Spacing="12" Padding="8">
                    <TextBlock Text="Paste the handoff packet you sent in the new thread:" />
                    <TextBox x:Name="VerifyPacketBox"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             FontFamily="Consolas"
                             MinHeight="200" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Verify hash" Click="Verify_Click" />
                        <Button Content="Rollback handoff" Click="Rollback_Click" />
                    </StackPanel>
                    <TextBlock x:Name="VerifyResultLine" TextWrapping="WrapWholeWords" FontWeight="SemiBold" />
                </StackPanel>
            </TabViewItem>
        </TabView>
    </Grid>
</UserControl>
