<UserControl
    x:Class="ChatGPTWrapper.WinUI.Views.Dialogs.FormatRefinementPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    MinWidth="520">

    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="560">
        <StackPanel Spacing="12" Padding="4,0,4,8">
            <TextBlock Style="{ThemeResource ShellSectionHintStyle}"
                       TextWrapping="Wrap"
                       Text="Quick tweaks for the active transcript mode. Suggested actions reflect your current format profile." />

            <ComboBox x:Name="CategoryCombo"
                      Header="Category"
                      HorizontalAlignment="Stretch"
                      SelectionChanged="CategoryCombo_SelectionChanged" />

            <TextBlock x:Name="SuggestedHeader"
                       Text="Suggested for you"
                       Style="{ThemeResource ShellSectionHeaderStyle}"
                       Visibility="Collapsed" />
            <StackPanel x:Name="SuggestedPanel"
                        Orientation="Horizontal"
                        Spacing="6" />

            <TextBlock Text="Common tweaks"
                       Style="{ThemeResource ShellSectionHeaderStyle}" />
            <StackPanel x:Name="CommonPanel"
                        Orientation="Horizontal"
                        Spacing="6" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
