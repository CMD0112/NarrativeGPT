<UserControl
    x:Class="ChatGPTWrapper.WinUI.Views.PlayFooterBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Style="{ThemeResource ShellCardStyle}" Padding="8,6">
        <Grid ColumnSpacing="{ThemeResource SpaceSm}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="80" />
            </Grid.ColumnDefinitions>

            <Button x:Name="SearchButton"
                    Grid.Column="0"
                    Content="Search"
                    Style="{ThemeResource ShellGhostButtonStyle}"
                    Click="SearchButton_Click" />
            <Button x:Name="ExportButton"
                    Grid.Column="1"
                    Content="Export"
                    Style="{ThemeResource ShellGhostButtonStyle}"
                    Click="ExportButton_Click" />
            <Button x:Name="MoreButton"
                    Grid.Column="2"
                    Content="More"
                    Style="{ThemeResource ShellGhostButtonStyle}"
                    Click="MoreButton_Click" />
            <TextBlock x:Name="StatusLine"
                       Grid.Column="3"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Right"
                       TextTrimming="CharacterEllipsis"
                       Style="{ThemeResource ShellSectionHintStyle}"
                       Text="Compose in the ChatGPT thread." />
        </Grid>
    </Border>
</UserControl>
