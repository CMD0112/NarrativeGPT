<UserControl
    x:Class="ChatGPTWrapper.WinUI.Views.PlayCompanionHost"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ChatGPTWrapper.WinUI.Views">

    <TabView x:Name="CompanionTabs"
             Background="{ThemeResource BgChromeBrush}"
             TabWidthMode="Equal"
             IsAddTabButtonVisible="False"
             CanDragTabs="False"
             CanReorderTabs="False"
             SelectionChanged="CompanionTabs_SelectionChanged">
        <TabView.TabItems>
            <TabViewItem Header="Reference" Tag="Reference">
                <local:PlayCompanionReferencePanel x:Name="ReferencePanel"
                                                     Padding="{ThemeResource SpaceSmPadding}" />
            </TabViewItem>

            <TabViewItem x:Name="WarningsTab" Header="Warnings" Tag="Warnings">
                <Grid RowSpacing="{ThemeResource SpaceSm}" Padding="{ThemeResource SpaceSmPadding}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="WarningsLastCheckedBlock"
                               Style="{ThemeResource ShellSectionHintStyle}"
                               Visibility="Collapsed" />

                    <ListView x:Name="WarningsList"
                              Grid.Row="1"
                              SelectionMode="Single"
                              IsItemClickEnabled="True"
                              RightTapped="WarningsList_RightTapped">
                        <ListView.ContextFlyout>
                            <MenuFlyout Opening="WarningsContextFlyout_Opening">
                                <MenuFlyoutItem Tag="Reference" Text="Open in Reference" Click="WarningOpenInReference_Click" />
                                <MenuFlyoutItem Tag="Dismiss" Text="Dismiss" Click="WarningDismiss_Click" />
                            </MenuFlyout>
                        </ListView.ContextFlyout>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{ThemeResource BgElevatedBrush}"
                                        BorderBrush="{ThemeResource BorderSubtleBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{ThemeResource RadiusControl}"
                                        Padding="{ThemeResource SpaceSmPadding}"
                                        Margin="0,0,0,4">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Source}"
                                                   Style="{ThemeResource ShellSectionHintStyle}"
                                                   Visibility="{Binding SourceVisibility}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <TextBlock x:Name="WarningsEmptyState"
                               Grid.Row="1"
                               Style="{ThemeResource ShellSectionHintStyle}"
                               Text="No continuity warnings."
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="Collapsed" />
                </Grid>
            </TabViewItem>

            <TabViewItem x:Name="StateTab" Header="State" Tag="State">
                <ScrollViewer Padding="{ThemeResource SpaceSmPadding}" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="{ThemeResource SpaceSm}">
                        <TextBlock x:Name="StateLastUpdatedBlock"
                                   Style="{ThemeResource ShellSectionHintStyle}"
                                   Visibility="Collapsed" />
                        <Border x:Name="StateEmptyStateCard"
                                Style="{ThemeResource ShellCardStyle}"
                                Visibility="Collapsed">
                            <TextBlock Style="{ThemeResource ShellSectionHintStyle}"
                                       TextWrapping="Wrap"
                                       Text="World state not configured — set up in Play settings → World." />
                        </Border>
                        <Border Style="{ThemeResource ShellCardStyle}">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Summary" Style="{ThemeResource ShellSectionHeaderStyle}" />
                                <TextBlock x:Name="StateSummaryPreview"
                                           Style="{ThemeResource ShellSectionHintStyle}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Border Style="{ThemeResource ShellCardStyle}">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Location" Style="{ThemeResource ShellSectionHeaderStyle}" />
                                <TextBlock x:Name="StateLocationPreview"
                                           Style="{ThemeResource ShellSectionHintStyle}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Border Style="{ThemeResource ShellCardStyle}">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Objectives" Style="{ThemeResource ShellSectionHeaderStyle}" />
                                <TextBlock x:Name="StateObjectivesPreview"
                                           Style="{ThemeResource ShellSectionHintStyle}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Expander x:Name="StateAllFieldsExpander" Header="All fields" IsExpanded="False">
                            <ListView x:Name="StateAllFieldsList" SelectionMode="None" MaxHeight="200">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnSpacing="{ThemeResource SpaceSm}" Padding="4,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Field}"
                                                       Style="{ThemeResource ShellSectionHintStyle}" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Value}"
                                                       TextWrapping="Wrap" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Expander>
                        <Button x:Name="EditWorldButton"
                                Content="Edit world in settings"
                                Style="{ThemeResource ShellGhostButtonStyle}"
                                HorizontalAlignment="Left"
                                Click="EditWorldButton_Click" />
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>
        </TabView.TabItems>
    </TabView>
</UserControl>
