<UserControl
    x:Class="ChatGPTWrapper.WinUI.Views.PlaySessionCockpit"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ChatGPTWrapper.WinUI.Controls"
    xmlns:services="using:ChatGPTWrapper.Adventure.Services"
    HorizontalAlignment="Stretch">

    <Border x:Name="CockpitBorder"
            Style="{ThemeResource ShellCardStyle}"
            HorizontalAlignment="Stretch">

        <StackPanel Spacing="{ThemeResource SpaceSm}" HorizontalAlignment="Stretch">
            <controls:SegmentedControl x:Name="SectionSegment"
                                       HorizontalAlignment="Stretch"
                                       SelectionChanged="SectionSegment_SelectionChanged" />

            <StackPanel x:Name="SessionPanel" Spacing="{ThemeResource SpaceSm}">
                <Border x:Name="LinkProjectBanner"
                        Background="{ThemeResource AccentSubtleBrush}"
                        BorderBrush="{ThemeResource AccentPrimaryBrush}"
                        BorderThickness="1"
                        CornerRadius="{ThemeResource RadiusControl}"
                        Padding="{ThemeResource SpaceSmPadding}"
                        Visibility="Collapsed">
                    <Grid ColumnSpacing="{ThemeResource SpaceSm}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="120" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{ThemeResource ShellSectionHintStyle}"
                                   TextWrapping="Wrap"
                                   Text="Link a ChatGPT Project to enable AI jobs and source publishing." />
                        <Button Grid.Column="1"
                                Content="Link project"
                                Style="{ThemeResource ShellPrimaryButtonStyle}"
                                VerticalAlignment="Center"
                                Click="LinkProject_Click" />
                    </Grid>
                </Border>

                <TextBlock x:Name="PlayTabStatusText"
                           Style="{ThemeResource ShellSectionHintStyle}"
                           TextWrapping="Wrap" />
                <HyperlinkButton x:Name="ThreadStatusLink"
                                 Content="Thread status"
                                 Click="ThreadStatusLink_Click"
                                 Padding="0"
                                 HorizontalAlignment="Left" />
                <HyperlinkButton x:Name="SourcesStatusLink"
                                 Content="Sources status"
                                 Click="SourcesStatusLink_Click"
                                 Padding="0"
                                 HorizontalAlignment="Left" />
                <Button x:Name="ManageThreadsButton"
                        Content="Manage threads"
                        Style="{ThemeResource ShellGhostButtonStyle}"
                        HorizontalAlignment="Left"
                        Click="ManageThreads_Click" />
            </StackPanel>

            <StackPanel x:Name="NarratorPanel" Spacing="{ThemeResource SpaceSm}" Visibility="Collapsed">
                <TextBlock Text="Scene profile"
                           Style="{ThemeResource ShellSectionHintStyle}" />
                <ComboBox x:Name="SceneProfileCombo"
                          HorizontalAlignment="Stretch"
                          SelectionChanged="SceneProfileCombo_SelectionChanged">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="services:NarratorPresetComboItem">
                            <TextBlock Text="{x:Bind DisplayName}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <TextBlock x:Name="OverrideChipsText"
                           Style="{ThemeResource ShellSectionHintStyle}"
                           TextWrapping="Wrap" />

                <TextBlock Text="Apply changes to"
                           Style="{ThemeResource ShellSectionHintStyle}" />
                <controls:SegmentedControl x:Name="ScopeSegment"
                                           HorizontalAlignment="Stretch"
                                           SelectionChanged="ScopeSegment_SelectionChanged" />

                <Button x:Name="NarratorSettingsButton"
                        Content="Full narrator settings"
                        Style="{ThemeResource ShellGhostButtonStyle}"
                        HorizontalAlignment="Left"
                        Click="NarratorSettings_Click" />
            </StackPanel>

            <StackPanel x:Name="ToolsPanel" Spacing="{ThemeResource SpaceSm}" Visibility="Collapsed">
                <TextBlock Text="Utility jobs"
                           Style="{ThemeResource ShellSectionHeaderStyle}" />
                <TextBlock Style="{ThemeResource ShellSectionHintStyle}"
                           TextWrapping="Wrap"
                           Text="Post-turn utility jobs for the latest exchange. Auto-run toggles live in Play settings → Utility jobs." />
                <controls:StatusChip x:Name="ReviewChip"
                                     Label="Review"
                                     Kind="Attention"
                                     Click="ReviewChip_Click" />
                <ScrollViewer MaxHeight="280"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="AiToolsPanel" Spacing="4" />
                </ScrollViewer>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
