<Application
    x:Class="ChatGPTWrapper.WinUI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:ChatGPTWrapper.WinUI.Converters">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="ms-appx:///Themes/WrapperTokens.xaml" />
                <ResourceDictionary Source="ms-appx:///Themes/WrapperControls.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVisibilityConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
