<UserControl
    x:Class="ChatGPTWrapper.WinUI.Controls.SegmentedControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Background="{ThemeResource BgElevatedBrush}"
            BorderBrush="{ThemeResource BorderSubtleBrush}"
            BorderThickness="1"
            CornerRadius="{ThemeResource RadiusControl}"
            Padding="2">
